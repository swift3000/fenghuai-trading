<view class="tab-bar" style="--active-color: {{activeColor}};">
  <view class="tab-item {{active==='home' ? 'active' : ''}}" data-key="home" bindtap="goHome">
    <image class="tab-icon" src="{{active==='home' ? '/assets/icons/home-active.png' : '/assets/icons/home.png'}}" mode="aspectFit"></image>
    <text class="tab-label">首页</text>
  </view>

  <view class="tab-item {{active==='orders' ? 'active' : ''}}" data-key="orders" bindtap="goOrders">
    <image class="tab-icon" src="{{active==='orders' ? '/assets/icons/order-active.png' : '/assets/icons/order.png'}}" mode="aspectFit"></image>
    <text class="tab-label">订单</text>
  </view>

  <view class="tab-item {{active==='receivable' ? 'active' : ''}}" data-key="receivable" bindtap="goReceivable">
    <image class="tab-icon" src="{{active==='receivable' ? '/assets/icons/money-active.png' : '/assets/icons/money.png'}}" mode="aspectFit"></image>
    <text class="tab-label">赊销</text>
  </view>

  <view class="tab-item {{active==='outbound' ? 'active' : ''}}" data-key="outbound" bindtap="goOutbound">
    <image class="tab-icon" src="{{active==='outbound' ? '/assets/icons/outbound-active.png' : '/assets/icons/outbound.png'}}" mode="aspectFit"></image>
    <text class="tab-label">分拣出库</text>
  </view>

  <view class="tab-item {{active==='profile' ? 'active' : ''}}" data-key="profile" bindtap="goProfile">
    <image class="tab-icon" src="{{active==='profile' ? '/assets/icons/profile-active.png' : '/assets/icons/profile.png'}}" mode="aspectFit"></image>
    <text class="tab-label">我的</text>
  </view>
</view>
