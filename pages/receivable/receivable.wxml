<view class="container">
  <!-- 导出工具栏 -->
  <view class="recv-toolbar" wx:if="{{customers.length > 0}}">
    <button class="btn-export-recv" bindtap="handleExport">📥 导出</button>
  </view>
  <!-- 统计概览 -->
  <view class="overview card">
    <view class="stat-item">
      <text class="stat-label">总欠款</text>
      <text class="stat-value text-primary text-bold">¥{{totalUnpaid}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">已收款</text>
      <text class="stat-value text-success">¥{{totalReceived}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">客户数</text>
      <text class="stat-value">{{customerCount}}</text>
    </view>
    <view class="stat-item" wx:if="{{viewTab === 'settled'}}">
      <text class="stat-label">已结清</text>
      <text class="stat-value text-muted">{{settledCount}}</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input placeholder="搜索客户名称/区域/联系人" value="{{searchKey}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <!-- 视图切换 -->
  <view class="view-tabs">
    <view class="tab {{viewTab==='ledger'?'active':''}}" data-tab="ledger" bindtap="switchView">
      <text>📋 客户台账</text>
    </view>
    <view class="tab {{viewTab==='unpaid'?'active':''}}" data-tab="unpaid" bindtap="switchView">
      <text>⏳ 未结清</text>
    </view>
    <view class="tab {{viewTab==='settled'?'active':''}}" data-tab="settled" bindtap="switchView">
      <text>✅ 已结清</text>
    </view>
  </view>

  <!-- 时间筛选 -->
  <view class="time-tabs" wx:if="{{viewTab === 'ledger'}}">
    <view class="time-tab {{timeTab==='all'?'active':''}}" data-key="all" bindtap="switchTime">
      <text>全部</text>
    </view>
    <view class="time-tab {{timeTab==='today'?'active':''}}" data-key="today" bindtap="switchTime">
      <text>今日</text>
    </view>
    <view class="time-tab {{timeTab==='week'?'active':''}}" data-key="week" bindtap="switchTime">
      <text>本周</text>
    </view>
    <view class="time-tab {{timeTab==='month'?'active':''}}" data-key="month" bindtap="switchTime">
      <text>本月</text>
    </view>
  </view>

  <!-- 客户列表 -->
  <view class="customer-list" wx:if="{{customers.length > 0}}">
    <view class="customer-card card" wx:for="{{customers}}" wx:key="_id" bindtap="viewCustomerDetail" data-item="{{item}}">
      <view class="customer-header">
        <view class="customer-info">
          <text class="customer-name">{{item.name}}</text>
          <text class="customer-region" wx:if="{{item.region}}">{{item.region}}</text>
        </view>
        <view class="customer-amount">
          <text class="unpaid-amount text-danger">欠 ¥{{item.unpaidAmount}}</text>
        </view>
      </view>
      
      <view class="customer-details">
        <view class="detail-row">
          <text class="detail-label">联系人:</text>
          <text class="detail-value">{{item.contact || '-'}}</text>
          <text class="detail-phone" wx:if="{{item.phone}}" bindtap="callPhone" data-phone="{{item.phone}}">📞</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">订单数:</text>
          <text class="detail-value">{{item.orderCount}} 单</text>
        </view>
      </view>

      <view class="customer-stats">
        <view class="stat-bar">
          <view class="stat-progress" style="width: {{item.totalAmount > 0 ? (item.paidAmount / item.totalAmount * 100) : 0}}%"></view>
        </view>
        <view class="stat-text">
          <text>应收：¥{{item.totalAmount}}</text>
          <text>已收：¥{{item.paidAmount}}</text>
          <text wx:if="{{item.unpaidAmount > 0}}" class="text-danger">欠款：¥{{item.unpaidAmount}}</text>
        </view>
      </view>

      <view class="customer-actions" wx:if="{{item.unpaidAmount > 0}}">
        <button class="btn-action btn-collect" size="mini" bindtap="handleCollect" data-item="{{item}}">登记收款</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{customers.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无数据</text>
    <text class="empty-hint" wx:if="{{viewTab === 'unpaid'}}">没有未结清的订单</text>
    <text class="empty-hint" wx:if="{{viewTab === 'settled'}}">没有已结清的订单</text>
    <text class="empty-hint" wx:if="{{viewTab === 'ledger'}}">暂无客户订单数据</text>
  </view>

  <!-- 收款弹窗 -->
  <view class="modal-mask" wx:if="{{showCollectModal}}" bindtap="closeCollectModal"></view>
  <view class="modal-content collect-modal" wx:if="{{showCollectModal}}">
    <view class="modal-header">
      <text class="modal-title">登记收款</text>
      <text class="modal-close" bindtap="closeCollectModal">×</text>
    </view>
    <view class="modal-body">
      <view class="order-info card">
        <view class="info-row">
          <text class="info-label">客户:</text>
          <text class="info-value">{{collectCustomerName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">订单号:</text>
          <text class="info-value">{{collectOrderNo}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">订单总额:</text>
          <text class="info-value">¥{{collectTotalAmount}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">已收款:</text>
          <text class="info-value">¥{{collectPaidAmount}}</text>
        </view>
        <view class="info-row highlight">
          <text class="info-label">待收款:</text>
          <text class="info-value text-danger">¥{{collectUnpaidAmount}}</text>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">收款金额</text>
        <view class="amount-input">
          <text class="currency-symbol">¥</text>
          <input class="form-input amount-input" type="digit" placeholder="请输入收款金额" value="{{collectAmount}}" bindinput="onCollectAmountChange" />
        </view>
        <text class="form-hint">最多可收 ¥{{collectUnpaidAmount}}</text>
      </view>

      <view class="form-group">
        <text class="form-label">收款方式</text>
        <picker mode="selector" range="{{paymentMethods}}" value="{{paymentMethodIndex}}" bindchange="onPaymentMethodChange">
          <view class="picker">{{paymentMethods[paymentMethodIndex]}}</view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">备注</text>
        <textarea class="form-textarea" placeholder="请输入备注（可选）" value="{{collectNote}}" bindinput="onCollectNoteChange" />
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="closeCollectModal">取消</button>
      <button class="btn btn-primary" bindtap="confirmCollect" loading="{{collectLoading}}">{{collectLoading ? '提交中...' : '确认收款'}}</button>
    </view>
  </view>
</view>
