<view class="container" style="{{uiStyle}}">
  <!-- 导出工具栏 -->
  <view class="recv-toolbar" wx:if="{{customers.length > 0}}">
    <view class="flex-between">
      <button class="btn-confirm-payment" wx:if="{{canConfirmPayment}}" bindtap="showConfirmWorkbench">✅ 收款确认{{pendingPaymentCount > 0 ? " · " + pendingPaymentCount : ""}}</button>
      <button class="btn-export-recv" wx:if="{{canExport}}" bindtap="openExportPreview">📥 导出</button>
    </view>
  </view>
  <!-- 统计概览 -->
  <view class="overview card">
    <view class="stat-item">
      <text class="stat-label">总欠款</text>
      <text class="stat-value text-primary text-bold">¥{{totalUnpaid}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">已收款</text>
      <text class="stat-value text-success">¥{{totalReceived}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">客户数</text>
      <text class="stat-value">{{customerCount}}</text>
    </view>
    <view class="stat-item" wx:if="{{viewTab === 'settled'}}">
      <text class="stat-label">已结清</text>
      <text class="stat-value text-muted">{{settledCount}}</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input placeholder="搜索客户名称/区域/联系人" value="{{searchKey}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <!-- 视图切换 -->
  <view class="view-tabs">
    <view class="tab {{viewTab==='ledger'?'active':''}}" data-tab="ledger" bindtap="switchView">
      <text>📋 客户台账</text>
    </view>
    <view class="tab {{viewTab==='unpaid'?'active':''}}" data-tab="unpaid" bindtap="switchView">
      <text>⏳ 未结清</text>
    </view>
    <view class="tab {{viewTab==='settled'?'active':''}}" data-tab="settled" bindtap="switchView">
      <text>✅ 已结清</text>
    </view>
  </view>

  <!-- 时间筛选 -->
  <view class="time-tabs" wx:if="{{viewTab === 'ledger'}}">
    <view class="time-tab {{timeTab==='all'?'active':''}}" data-key="all" bindtap="switchTime">
      <text>全部</text>
    </view>
    <view class="time-tab {{timeTab==='today'?'active':''}}" data-key="today" bindtap="switchTime">
      <text>今日</text>
    </view>
    <view class="time-tab {{timeTab==='week'?'active':''}}" data-key="week" bindtap="switchTime">
      <text>本周</text>
    </view>
    <view class="time-tab {{timeTab==='month'?'active':''}}" data-key="month" bindtap="switchTime">
      <text>本月</text>
    </view>
    <view class="time-tab {{timeTab==='custom'?'active':''}}" data-key="custom" bindtap="switchTime">
      <text>自定义</text>
    </view>
  </view>
  
  <!-- 自定义时间范围选择 -->
  <view class="custom-date-range" wx:if="{{timeTab === 'custom'}}">
    <view class="date-inputs">
      <view class="date-item">
        <text class="date-label">开始日期</text>
        <picker mode="date" value="{{startDate}}" start="2020-01-01" end="{{endDate}}" bindchange="onStartDateChange">
          <view class="picker-date">{{startDate || '请选择'}}</view>
        </picker>
      </view>
      <view class="date-item">
        <text class="date-label">结束日期</text>
        <picker mode="date" value="{{endDate}}" start="{{startDate}}" bindchange="onEndDateChange">
          <view class="picker-date">{{endDate || '请选择'}}</view>
        </picker>
      </view>
    </view>
    <view class="date-actions">
      <button class="btn-confirm" bindtap="applyCustomDate" disabled="{{!startDate || !endDate}}">
        应用筛选
      </button>
    </view>
  </view>

  <!-- 客户列表 -->
  <view class="customer-list" wx:if="{{customers.length > 0}}">
    <view class="customer-card card" wx:for="{{customers}}" wx:key="_id" bindtap="viewCustomerDetail" data-item="{{item}}">
      <view class="customer-header">
        <view class="customer-info">
          <text class="customer-name">{{item.name}}</text>
          <text class="customer-region" wx:if="{{item.region}}">{{item.region}}</text>
        </view>
        <view class="customer-amount">
          <text class="unpaid-amount text-danger">欠 ¥{{item.unpaidAmount}}</text>
        </view>
      </view>
      
      <view class="customer-details">
        <view class="detail-row">
          <text class="detail-label">联系人:</text>
          <text class="detail-value">{{item.contact || '-'}}</text>
          <text class="detail-phone" wx:if="{{item.phone}}" bindtap="callPhone" data-phone="{{item.phone}}">📞</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">订单数:</text>
          <text class="detail-value">{{item.orderCount}} 单</text>
        </view>
        <view class="detail-row dc-aging" wx:if="{{item.unpaidAmount > 0 && item.maxAge > 0}}">
          <view class="aging-dot" style="background: {{item.agingColor}}"></view>
          <text class="aging-text">最长欠款 {{item.maxAge}} 天</text>
        </view>
      </view>

      <view class="customer-stats">
        <view class="stat-bar">
          <view class="stat-progress" style="width: {{item.totalAmount > 0 ? (item.paidAmount / item.totalAmount * 100) : 0}}%"></view>
        </view>
        <view class="stat-text">
          <text>应收：¥{{item.totalAmount}}</text>
          <text>已收：¥{{item.paidAmount}}</text>
          <text wx:if="{{item.unpaidAmount > 0}}" class="text-danger">欠款：¥{{item.unpaidAmount}}</text>
        </view>
      </view>

      <view class="customer-actions" wx:if="{{item.unpaidAmount > 0}}">
        <button class="btn-action btn-collect" wx:if="{{canCollect}}" size="mini" bindtap="handleCollect" data-item="{{item}}">登记收款</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{customers.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无数据</text>
    <text class="empty-hint" wx:if="{{viewTab === 'unpaid'}}">没有未结清的订单</text>
    <text class="empty-hint" wx:if="{{viewTab === 'settled'}}">没有已结清的订单</text>
    <text class="empty-hint" wx:if="{{viewTab === 'ledger'}}">暂无客户订单数据</text>
  </view>

  <!-- 导出预览弹窗（对齐原型 v4.4：先选周期看汇总，再确认导出） -->
  <view class="epp-overlay" wx:if="{{showExportPreview}}" bindtap="closeExportPreview">
    <view class="epp-panel" catchtap="noop">
      <view class="epp-header">
        <text class="epp-title">📥 导出赊销报表</text>
        <text class="epp-close" bindtap="closeExportPreview">×</text>
      </view>
      <view class="epp-label">选择时间周期</view>
      <view class="epp-chips">
        <view class="epp-chip {{exportPeriod==='all'?'active':''}}" data-period="all" bindtap="onExportPeriod">全部</view>
        <view class="epp-chip {{exportPeriod==='today'?'active':''}}" data-period="today" bindtap="onExportPeriod">今日</view>
        <view class="epp-chip {{exportPeriod==='week'?'active':''}}" data-period="week" bindtap="onExportPeriod">本周</view>
        <view class="epp-chip {{exportPeriod==='month'?'active':''}}" data-period="month" bindtap="onExportPeriod">本月</view>
        <view class="epp-chip {{exportPeriod==='custom'?'active':''}}" data-period="custom" bindtap="onExportPeriod">自定义</view>
      </view>
      <view class="epp-custom" wx:if="{{exportPeriod==='custom'}}">
        <picker mode="date" value="{{exportStartDate}}" bindchange="onExportStartDateChange">
          <view class="epp-date">{{exportStartDate || '开始日期'}}</view>
        </picker>
        <text class="epp-dash">～</text>
        <picker mode="date" value="{{exportEndDate}}" start="{{exportStartDate}}" bindchange="onExportEndDateChange">
          <view class="epp-date">{{exportEndDate || '结束日期'}}</view>
        </picker>
      </view>
      <view class="epp-summary">
        <view class="epp-s-row"><text class="epp-s-label">应收总额</text><text class="epp-s-val">¥{{previewTotal}}</text></view>
        <view class="epp-s-row green"><text class="epp-s-label">已收</text><text class="epp-s-val">¥{{previewReceived}}</text></view>
        <view class="epp-s-row red"><text class="epp-s-label">未结清</text><text class="epp-s-val">¥{{previewUnpaid}}</text></view>
        <view class="epp-s-row muted"><text class="epp-s-label">客户数</text><text class="epp-s-val">{{previewCount}}</text></view>
      </view>
      <view class="epp-hint">按当前视图（{{viewTab==='ledger'?'客户台账':(viewTab==='unpaid'?'未结清':'已结清')}}）导出 CSV</view>
      <button class="epp-btn" bindtap="confirmExport" loading="{{exporting}}">{{exporting ? '导出中...' : '确认导出 CSV'}}</button>
    </view>
  </view>

  <!-- 收款弹窗 -->
  <view class="modal-mask" wx:if="{{showCollectModal}}" bindtap="closeCollectModal"></view>
  <view class="modal-content collect-modal" wx:if="{{showCollectModal}}">
    <view class="modal-header">
      <text class="modal-title">登记收款</text>
      <text class="modal-close" bindtap="closeCollectModal">×</text>
    </view>
    <view class="modal-body">
      <view class="order-info card">
        <view class="info-row">
          <text class="info-label">客户:</text>
          <text class="info-value">{{collectCustomerName}}</text>
        </view>
        <view class="info-row" wx:if="{{collectOrders.length > 1}}">
          <text class="info-label">订单:</text>
          <picker class="collect-order-picker" mode="selector" range="{{collectOrders}}" range-key="orderNo" value="{{collectOrderIndex}}" bindchange="onCollectOrderChange">
            <view class="picker">{{collectOrderNo}} ▾（共{{collectOrders.length}}单）</view>
          </picker>
        </view>
        <view class="info-row" wx:else>
          <text class="info-label">订单号:</text>
          <text class="info-value">{{collectOrderNo}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">订单总额:</text>
          <text class="info-value">¥{{collectTotalAmount}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">已收款:</text>
          <text class="info-value">¥{{collectPaidAmount}}</text>
        </view>
        <view class="info-row highlight">
          <text class="info-label">待收款:</text>
          <text class="info-value text-danger">¥{{collectUnpaidAmount}}</text>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">收款金额</text>
        <view class="amount-input">
          <text class="currency-symbol">¥</text>
          <input class="form-input amount-input" type="digit" placeholder="请输入收款金额" value="{{collectAmount}}" bindinput="onCollectAmountChange" />
        </view>
        <text class="form-hint">该订单最多可收 ¥{{collectUnpaidAmount}}<text class="quick-fill" bindtap="fillCollectAll"> 全部收</text></text>
      </view>

      <view class="form-group" wx:if="{{canDiscount}}">
        <text class="form-label">折价/货损金额</text>
        <view class="amount-input">
          <text class="currency-symbol">¥</text>
          <input class="form-input amount-input" type="digit" placeholder="折价/货损（可选）" value="{{collectDiscount}}" bindinput="onCollectDiscountChange" />
        </view>
        <text class="form-hint">需折价/减免权限</text>
      </view>

      <view class="form-group">
        <text class="form-label">收款方式</text>
        <picker mode="selector" range="{{paymentMethods}}" value="{{paymentMethodIndex}}" bindchange="onPaymentMethodChange">
          <view class="picker">{{paymentMethods[paymentMethodIndex]}}</view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">备注</text>
        <textarea class="form-textarea" placeholder="请输入备注（可选）" value="{{collectNote}}" bindinput="onCollectNoteChange" />
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="closeCollectModal">取消</button>
      <button class="btn btn-primary" bindtap="confirmCollect" loading="{{collectLoading}}">{{collectLoading ? '提交中...' : '确认收款'}}</button>
    </view>
  </view>

  <!-- 收款确认工作台弹窗 -->
  <view class="workbench-overlay" wx:if="{{showConfirmWorkbench}}" bindtap="closeConfirmWorkbench">
    <view class="workbench-modal" catchtap="stopPropagation">
      <view class="workbench-header">
        <text class="workbench-title">✅ 收款确认工作台</text>
        <text class="workbench-close" bindtap="closeConfirmWorkbench">✕</text>
      </view>
      
      <view class="workbench-content">
        <view wx:if="{{pendingPayments.length === 0}}" class="empty-state">
          <text class="empty-text">暂无待确认收款</text>
        </view>
        
        <view wx:else class="payment-list">
          <view class="payment-item card" wx:for="{{pendingPayments}}" wx:key="_id">
            <view class="payment-header">
              <text class="payment-order-no">{{item.orderNo}}</text>
              <text class="payment-amount">¥{{item.amount}}</text>
            </view>
            <view class="payment-info">
              <text class="payment-customer">{{item.customerName}}</text>
              <text class="payment-method">收款方式：{{item.method === 'cash' ? '现金' : (item.method === 'wechat' ? '微信' : (item.method === 'alipay' ? '支付宝' : (item.method === 'bank' ? '银行转账' : '其他')))}}</text>
            </view>
            <view class="payment-footer">
              <text class="payment-registered-by">登记人：{{item.registeredBy}}</text>
              <text class="payment-registered-at">{{item.registeredAt}}</text>
            </view>
            <view class="payment-actions">
              <button class="btn-confirm-small" 
                      bindtap="confirmPayment" 
                      data-id="{{item._id}}"
                      disabled="{{confirmingPayment === item._id}}">
                {{confirmingPayment === item._id ? '确认中...' : '确认收款'}}
              </button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>
