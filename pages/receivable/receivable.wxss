/* 容器 */
.container {
  padding: 20rpx;
  background: #F5F6F8;
  min-height: 100vh;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 统计概览 */
/* 导出工具栏 */
.recv-toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.btn-export-recv {
  padding: 12rpx 28rpx;
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 500;
  color: #ffffff;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  border: none;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(6, 173, 86, 0.25);
  line-height: 1.5;
}

.btn-export-recv:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.overview {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
}

.stat-label {
  font-size: calc(24rpx * var(--font-scale));
  color: #999999;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: bold;
  color: #333333;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: calc(28rpx * var(--font-scale));
  margin-right: 12rpx;
}

.search-bar input {
  flex: 1;
  font-size: calc(28rpx * var(--font-scale));
}

/* 视图标签 */
.view-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: #ffffff;
  border-radius: 12rpx;
  font-size: calc(26rpx * var(--font-scale));
  color: #666666;
  transition: all 0.3s;
}

.tab.active {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #ffffff;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(6, 173, 86, 0.25);
}

/* 时间标签 */
.time-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.time-tab {
  padding: 12rpx 24rpx;
  background: #ffffff;
  border-radius: 8rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: #666666;
  transition: all 0.3s;
}

.time-tab.active {
  background: var(--theme-primary);
  color: #ffffff;
}

/* 客户卡片 */
.customer-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.customer-card {
  padding: 24rpx;
  transition: all 0.3s;
}

.customer-card:active {
  transform: scale(0.98);
}

.customer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.customer-info {
  display: flex;
  flex-direction: column;
}

.customer-name {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
  color: #333333;
  margin-bottom: 4rpx;
}

.customer-region {
  font-size: calc(24rpx * var(--font-scale));
  color: #999999;
}

.customer-amount {
  text-align: right;
}

.unpaid-amount {
  font-size: calc(30rpx * var(--font-scale));
  font-weight: bold;
}

.customer-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  font-size: calc(24rpx * var(--font-scale));
}

.detail-label {
  color: #999999;
  width: 120rpx;
}

.detail-value {
  color: #333333;
  flex: 1;
}

.detail-phone {
  font-size: calc(28rpx * var(--font-scale));
  margin-left: 8rpx;
}

/* 统计进度条 */
.customer-stats {
  margin-bottom: 16rpx;
}

.stat-bar {
  height: 8rpx;
  background: #e8e8e8;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.stat-progress {
  height: 100%;
  background: linear-gradient(90deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.stat-text {
  display: flex;
  justify-content: space-between;
  font-size: calc(24rpx * var(--font-scale));
  color: #666666;
}

.stat-text text {
  margin-right: 16rpx;
}

/* 操作按钮 */
.customer-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #e8e8e8;
}

.btn-action {
  padding: 12rpx 32rpx;
  font-size: calc(24rpx * var(--font-scale));
  border-radius: 8rpx;
  border: none;
  transition: all 0.3s;
}

.btn-collect {
  background: linear-gradient(135deg, #FF8A2B 0%, #ffa057 100%);
  color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(255, 138, 43, 0.25);
}

.btn-collect:active {
  opacity: 0.8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: calc(120rpx * var(--font-scale));
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: calc(32rpx * var(--font-scale));
  color: #999999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: calc(24rpx * var(--font-scale));
  color: #cccccc;
}

/* 收款弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.modal-content {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #ffffff;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  z-index: 1000;
}

.collect-modal {
  padding: 0;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.modal-title {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
  color: #333333;
}

.modal-close {
  font-size: calc(48rpx * var(--font-scale));
  color: #999999;
  line-height: 1;
  padding: 0 8rpx;
}

.modal-body {
  padding: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #e8e8e8;
}

/* 订单信息卡片 */
.order-info {
  background: #f9f9f9;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: calc(26rpx * var(--font-scale));
}

.info-row.highlight {
  padding-top: 16rpx;
  border-top: 1rpx dashed #e8e8e8;
  margin-top: 8rpx;
}

.info-label {
  color: #666666;
}

.info-value {
  color: #333333;
  font-weight: bold;
}

/* 表单 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: calc(28rpx * var(--font-scale));
  color: #333333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.amount-input {
  display: flex;
  align-items: center;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.currency-symbol {
  font-size: calc(32rpx * var(--font-scale));
  color: var(--theme-primary);
  font-weight: bold;
  margin-right: 8rpx;
}

.form-input {
  flex: 1;
  font-size: calc(32rpx * var(--font-scale));
  color: #333333;
  font-weight: bold;
  background: transparent;
}

.amount-input .form-input {
  font-size: calc(40rpx * var(--font-scale));
  color: #FF8A2B;
}

.form-hint {
  display: block;
  font-size: calc(22rpx * var(--font-scale));
  color: #999999;
  margin-top: 8rpx;
}

.picker {
  background: #f5f6f8;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--font-scale));
  color: #333333;
}

.form-textarea {
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: calc(28rpx * var(--font-scale));
  min-height: 120rpx;
}

/* 按钮 */
.btn {
  flex: 1;
  padding: 24rpx 0;
  font-size: calc(28rpx * var(--font-scale));
  border-radius: 12rpx;
  border: none;
  transition: all 0.3s;
}

.btn-cancel {
  background: #f5f6f8;
  color: #666666;
}

.btn-primary {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #ffffff;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(6, 173, 86, 0.25);
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 颜色 */
.text-primary {
  color: var(--theme-primary);
}

.text-danger {
  color: #FF3B30;
}

.text-success {
  color: var(--theme-primary);
}

.text-muted {
  color: #999999;
}

.text-bold {
  font-weight: bold;
}

/* 响应式适配 */
@media screen and (max-width: 375px) {
  .overview {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .stat-item {
    padding: 16rpx 8rpx;
  }
  
  .stat-value {
    font-size: calc(26rpx * var(--font-scale));
  }
}

/* 自定义日期范围样式 */
.custom-date-range {
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.date-inputs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.date-item {
  flex: 1;
}

.date-label {
  display: block;
  font-size: calc(24rpx * var(--font-scale));
  color: #666666;
  margin-bottom: 10rpx;
}

.picker-date {
  padding: 16rpx;
  background: #F5F6F8;
  border-radius: 8rpx;
  font-size: calc(28rpx * var(--font-scale));
  color: var(--theme-text);
}

.date-actions {
  display: flex;
  justify-content: center;
}

.btn-confirm {
  background: #1890FF;
  color: #FFFFFF;
  padding: 16rpx 48rpx;
  border-radius: 16rpx;
  font-size: calc(28rpx * var(--font-scale));
  border: none;
}

.btn-confirm[disabled] {
  background: #D9D9D9;
  color: #999999;
}

/* 收款确认工作台样式 */
.btn-confirm-payment {
  background: #52C41A;
  color: #FFFFFF;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: calc(26rpx * var(--font-scale));
  border: none;
  display: flex;
  align-items: center;
}

.btn-confirm-payment:active {
  opacity: 0.8;
}

.workbench-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.workbench-modal {
  width: 90%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.workbench-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #F5F6F8;
  border-bottom: 1rpx solid #EFEFEF;
}

.workbench-title {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
  color: var(--theme-text);
}

.workbench-close {
  font-size: calc(48rpx * var(--font-scale));
  color: #888888;
  padding: 8rpx;
}

.workbench-content {
  padding: 24rpx;
  overflow-y: auto;
  flex: 1;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: calc(28rpx * var(--font-scale));
  color: #888888;
}

.payment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.payment-item {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFEFEF;
}

.payment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.payment-order-no {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: bold;
  color: var(--theme-text);
}

.payment-amount {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
  color: #52C41A;
}

.payment-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.payment-customer {
  font-size: calc(26rpx * var(--font-scale));
  color: var(--theme-text);
}

.payment-method {
  font-size: calc(24rpx * var(--font-scale));
  color: #666666;
}

.payment-footer {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.payment-registered-by {
  font-size: calc(24rpx * var(--font-scale));
  color: #888888;
}

.payment-registered-at {
  font-size: calc(24rpx * var(--font-scale));
  color: #888888;
}

.payment-actions {
  display: flex;
  justify-content: flex-end;
}

.btn-confirm-small {
  background: #52C41A;
  color: #FFFFFF;
  padding: 12rpx 32rpx;
  border-radius: 12rpx;
  font-size: calc(26rpx * var(--font-scale));
  border: none;
}

.btn-confirm-small:active {
  opacity: 0.8;
}

.btn-confirm-small[disabled] {
  background: #D9D9D9;
  color: #999999;
}
