.sub-tabs{display:flex;gap:12rpx;margin-bottom:20rpx}
.tab{flex:1;text-align:center;padding:16rpx;background:#fff;border-radius:8rpx;font-size: calc(26rpx * var(--font-scale))}
.tab.active{background:#1a73e8;color:#fff}
.section-title{font-size: calc(28rpx * var(--font-scale));font-weight:bold;margin-bottom:12rpx}
.order-card{padding:20rpx 24rpx;margin-bottom:12rpx}
.order-actions{margin-top:12rpx}
