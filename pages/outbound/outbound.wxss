.sub-tabs{display:flex;gap:12rpx;margin-bottom:20rpx}
.tab{flex:1;text-align:center;padding:16rpx;background:#fff;border-radius:8rpx;font-size: calc(26rpx * var(--font-scale))}
.tab.active{background:#1a73e8;color:#fff}
.section-title{font-size: calc(28rpx * var(--font-scale));font-weight:bold;margin-bottom:12rpx}
.order-card{padding:20rpx 24rpx;margin-bottom:12rpx}
.order-actions{margin-top:12rpx}

/* 自定义底部 TabBar 占位，防止内容被遮挡 */
.container {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom)) !important;
}

/* ===== 出库工作台：两列卡片 + 内联物流（对齐原型） ===== */
.out-subtabs{display:flex;gap:16rpx;margin-bottom:16rpx}
.out-subtab{flex:1;text-align:center;padding:14rpx;background:#fff;border-radius:8rpx;font-size:calc(26rpx * var(--font-scale));color:#666}
.out-subtab.active{background:#FF7A1A;color:#fff;font-weight:600}
.btn-all-confirm{background:#22B14C;color:#fff;border:none;border-radius:40rpx;font-size:calc(28rpx * var(--font-scale));margin-bottom:16rpx}
.btn-export{background:linear-gradient(135deg,#FF8A2B,#FF5E62);color:#fff;border:none;border-radius:40rpx;font-size:calc(28rpx * var(--font-scale));margin-top:8rpx}
.out-empty{text-align:center;color:#bbb;padding:40rpx 0;font-size:calc(24rpx * var(--font-scale))}

.wh-item{background:#fff;border-radius:16rpx;padding:20rpx;margin-bottom:16rpx;display:flex;gap:20rpx;border-left:6rpx solid #F59E0B;box-shadow:0 4rpx 12rpx rgba(0,0,0,0.04)}
.wh-item.confirmed{border-left-color:#2563EB;background:#F5F9FF}
.wh-main{flex:1;display:flex;flex-direction:column;min-width:0}
.wh-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8rpx}
.wh-no{font-size:calc(22rpx * var(--font-scale));color:#999;word-break:break-all}
.wh-status{font-size:calc(20rpx * var(--font-scale));padding:4rpx 14rpx;border-radius:20rpx;flex-shrink:0}
.wh-status.st-pending{background:#FDF6EC;color:#F59E0B}
.wh-status.st-done{background:#ECF5FF;color:#2563EB}
.wh-customer{font-size:calc(32rpx * var(--font-scale));font-weight:700;margin-bottom:8rpx;word-break:break-all}
.wh-meta{font-size:calc(22rpx * var(--font-scale));color:#999;display:flex;gap:20rpx;margin-bottom:8rpx;flex-wrap:wrap}
.wh-footer{margin-top:auto;display:flex;align-items:center;gap:16rpx;padding-top:8rpx}
.wh-confirmed{color:#2563EB;font-size:calc(22rpx * var(--font-scale));font-weight:500}
.wh-amount{font-weight:700;color:#FF5E3A;font-size:calc(30rpx * var(--font-scale))}

.wh-products{width:52%;max-width:none;flex-shrink:0;border:2rpx solid #DC2626;background:#FFF7F7;border-radius:12rpx;padding:12rpx;box-sizing:border-box;display:flex;flex-direction:column;min-height:120rpx}
.wh-line{font-size:calc(22rpx * var(--font-scale));color:#333;padding:6rpx 0;border-bottom:1rpx dashed #FBDCDC;word-break:break-all}
.wh-line:last-of-type{border-bottom:none}
.wh-pkg-row{margin-top:auto;padding-top:8rpx;border-top:1rpx dashed #FBDCDC;display:flex;align-items:center;gap:8rpx;font-size:calc(22rpx * var(--font-scale));color:#666;line-height:1.4}
.wh-pkg-row .pkg-vals{flex:1;min-width:0;word-break:break-all}
.wh-pkg-row .pkg-edit{color:#2563EB;cursor:pointer;font-weight:500;flex-shrink:0}
.wh-pkg-row.empty .pkg-fill{color:#FF5E3A;font-weight:500;cursor:pointer}

/* ===== 定时自动确认：提示条 + 超时角标 ===== */
.ac-notice{background:#FEF3F2;border:2rpx solid #FECACA;color:#DC2626;border-radius:12rpx;padding:14rpx 18rpx;font-size:calc(22rpx * var(--font-scale));margin-bottom:14rpx;line-height:1.5}
.ac-notice-off{background:#F5F9FF;border-color:#BFDBFE;color:#2563EB}
.overdue-card{border-left:6rpx solid #DC2626}
.overdue-badge{display:inline-block;background:#DC2626;color:#fff;font-size:calc(20rpx * var(--font-scale));padding:2rpx 12rpx;border-radius:16rpx;margin-left:12rpx;vertical-align:middle;font-weight:500}

/* 自定义时间区间（与赊销页一致） */
.custom-date-range {
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.date-inputs { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.date-item { flex: 1; }
.date-label { display: block; font-size: calc(24rpx * var(--font-scale)); color: #666666; margin-bottom: 10rpx; }
.picker-date { padding: 16rpx; background: #F5F6F8; border-radius: 8rpx; font-size: calc(28rpx * var(--font-scale)); color: var(--theme-text); }
.date-actions { display: flex; justify-content: center; }
.btn-confirm { background: #1890FF; color: #FFFFFF; padding: 16rpx 48rpx; border-radius: 16rpx; font-size: calc(28rpx * var(--font-scale)); border: none; }
.btn-confirm[disabled] { background: #D9D9D9; color: #999999; }

/* 库单导出时间范围 */
.export-time { margin: 20rpx 24rpx 0; }
.export-time-tabs { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.export-time-tab {
  flex: 1; text-align: center; padding: 14rpx 0; border-radius: 12rpx;
  background: #F5F6F8; font-size: calc(26rpx * var(--font-scale)); color: #666;
}
.export-time-tab.active { background: var(--theme-primary, #16A34A); color: #fff; }
