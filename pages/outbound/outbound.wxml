<view class="container" style="{{uiStyle}}">
  <view class="sub-tabs">
    <view wx:if="{{canSort}}" class="tab {{subTab==='sort'?'active':''}}" data-tab="sort" bindtap="switchSub"><text>🔍 分拣</text></view>
    <view wx:if="{{canOut}}" class="tab {{subTab==='out'?'active':''}}" data-tab="out" bindtap="switchSub"><text> 出库</text></view>
  </view>
  <view wx:if="{{subTab==='sort'}}">
    <!-- 分拣子区 tabs（对齐原型：待分拣/已分拣 badge） -->
    <view class="out-subtabs">
      <view class="out-subtab {{sortTab==='pending'?'active':''}}" data-tab="pending" bindtap="switchSortTab">待分拣 <text class="wh-badge">{{pendingSort.length}}</text></view>
      <view class="out-subtab {{sortTab==='sorted'?'active':''}}" data-tab="sorted" bindtap="switchSortTab">已分拣 <text class="wh-badge blue">{{doneSort.length}}</text></view>
    </view>

    <view class="wh-toolbar" wx:if="{{sortTab==='pending'}}">
      <button class="btn-all-confirm" bindtap="handleAllSort">✅ 全部分拣</button>
    </view>
    <view class="ac-notice" wx:if="{{autoPolicy.enabled && autoPolicy.duePassed && !autoPolicy.alreadyRan}}">⏰ 已过定时确认时间（{{autoPolicy.time}}），以下未确认订单已超时，请尽快处理</view>
    <view class="ac-notice ac-notice-off" wx:elif="{{autoPolicy.enabled}}">🕐 定时自动确认已开启：每天 {{autoPolicy.time}} 自动确认未处理订单</view>
    <block wx:if="{{sortTab==='pending'}}">
      <view class="order-card card {{item.overdue ? 'overdue-card' : ''}}" wx:for="{{pendingSort}}" wx:key="_id">
        <text>{{item.customerName}}<text class="overdue-badge" wx:if="{{item.overdue}}">超时</text></text>
        <view class="order-actions"><button size="mini" data-id="{{item._id}}" bindtap="handleSort">分拣确认</button></view>
      </view>
      <view class="out-empty" wx:if="{{!pendingSort.length}}">暂无待分拣订单</view>
    </block>
    <block wx:else>
      <view class="order-card card done-card" wx:for="{{doneSort}}" wx:key="_id">
        <text>{{item.customerName}}</text>
        <text class="done-tag">✓ 已分拣</text>
      </view>
      <view class="out-empty" wx:if="{{!doneSort.length}}">暂无已分拣订单</view>
    </block>
  </view>
  <view wx:if="{{subTab==='out'}}">
    <view class="out-subtabs">
      <view class="out-subtab {{outTab==='pending'?'active':''}}" data-tab="pending" bindtap="switchOutTab">待出库 {{pendingOut.length}}</view>
      <view class="out-subtab {{outTab==='done'?'active':''}}" data-tab="done" bindtap="switchOutTab">已出库 {{doneOut.length}}</view>
    </view>

    <view class="ac-notice" wx:if="{{autoPolicy.enabled && autoPolicy.duePassed && !autoPolicy.alreadyRan}}">⏰ 已过定时确认时间（{{autoPolicy.time}}），以下未出库订单已超时，请尽快处理</view>
    <view class="ac-notice ac-notice-off" wx:elif="{{autoPolicy.enabled}}">🕐 定时自动确认已开启：每天 {{autoPolicy.time}} 自动确认未处理订单</view>

    <view class="wh-toolbar" wx:if="{{outTab==='pending'}}">
      <button class="btn-all-confirm" bindtap="handleAllOut">✅ 全部确认</button>
      <button class="btn-auto" bindtap="simulateAutoConfirm">⏰ 模拟16:00通过</button>
    </view>

    <block wx:for="{{outTab==='pending' ? pendingOut : doneOut}}" wx:key="_id">
      <view class="wh-item {{item.outStatus==='done'?'confirmed':''}}">
        <view class="wh-main">
          <view class="wh-header">
            <text class="wh-no">{{item.orderNo}}</text>
            <view class="wh-status {{item.outStatus==='done'?'st-done':'st-pending'}}">{{item.outStatus==='done'?'已出库':'待出库'}}<text class="overdue-badge" wx:if="{{item.overdue}}">超时</text></view>
          </view>
          <view class="wh-customer">{{item.customerName}}</view>
          <view class="wh-meta">
            <text>📍 {{item.customerRegion || '-'}}</text>
            <text>⏰ {{item.timeText}}</text>
          </view>
          <view class="wh-footer">
            <text class="wh-confirmed" wx:if="{{item.outStatus==='done'}}">✓ 已确认</text>
            <text class="wh-amount">¥{{item.totalAmount}}</text>
          </view>
        </view>
        <view class="wh-products">
          <view class="wh-line" wx:for="{{item.items}}" wx:for-item="it" wx:if="{{it.show}}">
            <text>{{it.name}} × {{it.qtyText}}</text>
          </view>
          <view class="wh-pkg-row" wx:if="{{item.pkgText}}">
            <text class="pkg-vals">{{item.pkgText}}</text>
            <text class="pkg-edit" data-id="{{item._id}}" data-customer="{{item.customerName}}" data-items="{{item.items}}" bindtap="handleOutClick">修改</text>
          </view>
          <view class="wh-pkg-row empty" wx:else>
            <text class="pkg-fill" data-id="{{item._id}}" data-customer="{{item.customerName}}" data-items="{{item.items}}" bindtap="handleOutClick">＋填写件数</text>
          </view>
        </view>
      </view>
    </block>
    <view class="out-empty" wx:if="{{(outTab==='pending' ? !pendingOut.length : !doneOut.length)}}">暂无订单</view>
    <!-- 库单导出时间范围 -->
    <view class="export-time" wx:if="{{canExport}}">
      <view class="export-time-tabs">
        <view class="export-time-tab {{exportTimeTab==='today'?'active':''}}" data-key="today" bindtap="switchExportTime">今日</view>
        <view class="export-time-tab {{exportTimeTab==='all'?'active':''}}" data-key="all" bindtap="switchExportTime">全部</view>
        <view class="export-time-tab {{exportTimeTab==='custom'?'active':''}}" data-key="custom" bindtap="switchExportTime">自定义</view>
      </view>
      <view class="custom-date-range" wx:if="{{exportTimeTab === 'custom'}}">
        <view class="date-inputs">
          <view class="date-item">
            <text class="date-label">开始日期</text>
            <picker mode="date" value="{{startDate}}" start="2020-01-01" end="{{endDate}}" bindchange="onStartDateChange">
              <view class="picker-date">{{startDate || '请选择'}}</view>
            </picker>
          </view>
          <view class="date-item">
            <text class="date-label">结束日期</text>
            <picker mode="date" value="{{endDate}}" start="{{startDate}}" bindchange="onEndDateChange">
              <view class="picker-date">{{endDate || '请选择'}}</view>
            </picker>
          </view>
        </view>
        <view class="date-actions">
          <button class="btn-confirm" bindtap="applyCustomDate" disabled="{{!startDate || !endDate}}">应用</button>
        </view>
      </view>
      <button class="btn-export" bindtap="handleExportOutbound">📦 导出库单(不含价格)</button>
    </view>
  </view>
  
  <!-- 出库确认弹窗 -->
  <view wx:if="{{showOutModal}}" class="modal-mask" bindtap="hideOutModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">出库确认 - {{outModalCustomer}}</text>
      </view>
      <view class="modal-body">
        <view class="form-group">
          <text class="form-label">大件数量</text>
          <input class="form-input" type="number" placeholder="请输入大件数" value="{{outForm.large}}" bindinput="onOutFormInput" data-field="large" />
        </view>
        <view class="form-group">
          <text class="form-label">中件数量</text>
          <input class="form-input" type="number" placeholder="请输入中件数" value="{{outForm.medium}}" bindinput="onOutFormInput" data-field="medium" />
        </view>
        <view class="form-group">
          <text class="form-label">小件数量</text>
          <input class="form-input" type="number" placeholder="请输入小件数" value="{{outForm.small}}" bindinput="onOutFormInput" data-field="small" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="hideOutModal">取消</button>
        <button class="btn-primary" bindtap="confirmOutSubmit">确认出库</button>
      </view>
    </view>
  </view>
</view>
