<view class="container" style="{{uiStyle}}">
  <view class="sub-tabs">
    <view wx:if="{{canSort}}" class="tab {{subTab==='sort'?'active':''}}" data-tab="sort" bindtap="switchSub"><text>🔍 分拣</text></view>
    <view wx:if="{{canOut}}" class="tab {{subTab==='out'?'active':''}}" data-tab="out" bindtap="switchSub"><text> 出库</text></view>
  </view>
  <view wx:if="{{subTab==='sort'}}">
    <view class="section-title">待分拣</view>
    <view class="order-card card" wx:for="{{pendingSort}}" wx:key="_id">
      <text>{{item.customerName}}</text>
      <view class="order-actions"><button size="mini" data-id="{{item._id}}" bindtap="handleSort">分拣确认</button></view>
    </view>
    <button class="btn-primary" bindtap="handleAllSort">全部分拣</button>
  </view>
  <view wx:if="{{subTab==='out'}}">
    <view class="section-title">待出库</view>
    <!-- 待出库列表 - 点击弹出输入框 -->
    <view class="order-card card" wx:for="{{pendingOut}}" wx:key="_id">
      <text>{{item.customerName}}</text>
      <view class="order-info">
        <text class="order-no">{{item.orderNo}}</text>
        <text class="order-amount">¥{{item.totalAmount}}</text>
      </view>
      <view class="order-items">
        <view class="item-row" wx:for="{{item.items}}" wx:key="product_id" wx:for-item="it">
          <text class="item-name">{{it.productName}}</text>
          <text class="item-qty">{{it.piece_qty || 0}}件 + {{it.package_qty || 0}}包</text>
        </view>
      </view>
      <view class="order-actions">
        <button size="mini" type="primary" data-id="{{item._id}}" data-customer="{{item.customerName}}" data-items="{{item.items}}" bindtap="handleOutClick">出库确认</button>
      </view>
    </view>
    <button class="btn-primary" bindtap="handleAllOut">全部出库</button>
    <button class="btn-secondary" wx:if="{{canExport}}" bindtap="handleExportOutbound">📦 导出库单(不含价格)</button>
  </view>
  
  <!-- 出库确认弹窗 -->
  <view wx:if="{{showOutModal}}" class="modal-mask" bindtap="hideOutModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">出库确认 - {{outModalCustomer}}</text>
      </view>
      <view class="modal-body">
        <view class="form-group">
          <text class="form-label">大件数量</text>
          <input class="form-input" type="number" placeholder="请输入大件数" value="{{outForm.large}}" bindinput="onOutFormInput" data-field="large" />
        </view>
        <view class="form-group">
          <text class="form-label">中件数量</text>
          <input class="form-input" type="number" placeholder="请输入中件数" value="{{outForm.medium}}" bindinput="onOutFormInput" data-field="medium" />
        </view>
        <view class="form-group">
          <text class="form-label">小件数量</text>
          <input class="form-input" type="number" placeholder="请输入小件数" value="{{outForm.small}}" bindinput="onOutFormInput" data-field="small" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="hideOutModal">取消</button>
        <button class="btn-primary" bindtap="confirmOutSubmit">确认出库</button>
      </view>
    </view>
  </view>
</view>
