<view class="container" style="{{uiStyle}}">
  <!-- 新增商品 -->
  <view class="add-product-bar" wx:if="{{canEdit}}">
    <button class="btn-add-product" bindtap="goToAdd">+ 新增商品</button>
  </view>
  
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input placeholder="搜索商品名称/料号/拼音" value="{{searchKeyword}}" bindinput="onSearch" />
  </view>

  <!-- 商品列表 -->
  <view class="product-list">
    <view class="product-item card" wx:for="{{products}}" wx:key="_id">
      <view class="prod-main">
        <text class="prod-name">{{item.name}}<text class="adj-badge" wx:if="{{item.is_adjustable}}">可调价</text></text>
        <text class="prod-sub">商品料号: {{item.material_code}} · 规格: {{item.spec}} · 单位: {{item.unit}}</text>
      </view>
      <view class="prod-side">
        <view class="prod-price">
          <text class="price-main">{{item.priceMain}}</text>
          <text class="price-sub">{{item.priceSub}}</text>
        </view>
        <view class="prod-btns" wx:if="{{canEdit}}">
          <text class="btn-price" data-item="{{item}}" bindtap="openPriceModal">改价</text>
          <text class="btn-edit" data-item="{{item}}" bindtap="goEdit">编辑</text>
          <text class="btn-del" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="onDelete">删除</text>
        </view>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{products.length === 0}}">暂无商品</view>
  </view>

  <!-- 改价弹窗 -->
  <view class="modal-mask" wx:if="{{showPriceModal}}" bindtap="closePriceModal"></view>
  <view class="modal-content" wx:if="{{showPriceModal}}">
    <view class="modal-header">
      <text class="modal-title">修改价格</text>
      <text class="modal-close" bindtap="closePriceModal">×</text>
    </view>
    <scroll-view scroll-y class="modal-body">
      <view class="price-modal-head">
        <text class="pm-name">{{priceItem.name}}</text>
        <text class="pm-sub">商品料号: {{priceItem.material_code}} · 规格: {{priceItem.spec}} · 单位: {{priceItem.unit}}</text>
      </view>
      <view class="form-group" wx:if="{{priceMode !== 'unit'}}">
        <text class="form-label">件价（每件售价 ¥）</text>
        <input class="form-input" type="digit" value="{{priceForm.pricePiece}}" bindinput="onPriceInput" data-field="pricePiece" />
      </view>
      <view class="form-group" wx:if="{{priceMode === 'case' || priceMode === 'unit'}}">
        <text class="form-label">{{priceMode === 'unit' ? '单价' : '包价'}}（每{{priceItem.unit}}售价 ¥）</text>
        <input class="form-input" type="digit" value="{{priceForm.priceUnit}}" bindinput="onPriceInput" data-field="priceUnit" />
      </view>
    </scroll-view>
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="closePriceModal">取消</button>
      <button class="btn btn-primary" bindtap="savePrice" loading="{{savingPrice}}">{{savingPrice ? '保存中...' : '保存'}}</button>
    </view>
  </view>

  <!-- 导入弹窗 -->
  <view class="modal-mask" wx:if="{{showImportDialog}}" bindtap="hideImportDialog"></view>
  <view class="modal-content" wx:if="{{showImportDialog}}">
    <view class="modal-header">
      <text class="modal-title">导入原型数据</text>
      <text class="modal-close" bindtap="hideImportDialog">×</text>
    </view>
    <scroll-view scroll-y class="modal-body">
      <view class="import-info">
        <text class="info-text">将导入 {{defaultProductsCount}} 个商品数据</text>
        <view class="import-options">
          <label class="radio-label">
            <radio color="#07C160" checked="{{importOverride}}" bindtap="toggleOverride" />
            <text class="radio-text">覆盖已存在的商品</text>
          </label>
        </view>
        <view class="warning-box">
          <text class="warning-text">⚠️ 导入过程中请勿关闭页面</text>
        </view>
      </view>
    </scroll-view>
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="hideImportDialog">取消</button>
      <button class="btn btn-primary" bindtap="confirmImport" loading="{{importing}}">
        {{importing ? '导入中...' : '开始导入'}}
      </button>
    </view>
  </view>

  <!-- 表单弹窗 -->
  <view class="modal-mask" wx:if="{{showForm}}" bindtap="closeForm"></view>
  <view class="modal-content" wx:if="{{showForm}}">
    <view class="modal-header">
      <text class="modal-title">{{editingProduct ? '编辑商品' : '添加商品'}}</text>
      <text class="modal-close" bindtap="closeForm">×</text>
    </view>
    
    <scroll-view scroll-y class="modal-body">
      <!-- 商品名称 -->
      <view class="form-group">
        <text class="form-label">商品名称 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入商品名称" value="{{formData.name}}" bindinput="onInputChange" data-field="name" />
      </view>

      <!-- 料号 -->
      <view class="form-group">
        <text class="form-label">料号 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入料号" value="{{formData.materialCode}}" bindinput="onInputChange" data-field="materialCode" />
      </view>

      <!-- 规格 -->
      <view class="form-group">
        <text class="form-label">规格</text>
        <input class="form-input" placeholder="请输入规格" value="{{formData.spec}}" bindinput="onInputChange" data-field="spec" />
      </view>

      <!-- 计价方式 -->
      <view class="form-group">
        <text class="form-label">计价方式</text>
        <picker mode="selector" range="{{modeOptions}}" value="{{modeIndex}}" bindchange="onModeChange">
          <view class="picker">
            {{modeOptions[modeIndex] === 'case' ? '件+包（按件和按包分别计价）' : (modeOptions[modeIndex] === 'piece' ? '仅按件' : '仅按包')}}
          </view>
        </picker>
      </view>

      <!-- 允许调价 -->
      <view class="form-group">
        <label class="form-label-inline">
          <switch checked="{{formData.isAdjustable}}" bindchange="onAdjustableChange" color="#07C160" />
          <text class="form-label-caption">允许下单时调价</text>
        </label>
      </view>

      <!-- 单位 -->
      <view class="form-group">
        <text class="form-label">单位 <text class="required">*</text></text>
        <picker mode="selector" range="{{unitOptions}}" value="{{unitIndex}}" bindchange="onUnitChange">
          <view class="picker">
            {{unitOptions[unitIndex]}}
          </view>
        </picker>
      </view>

      <!-- 件价 -->
      <view class="form-group">
        <text class="form-label">件价 (每件售价) <text class="required">*</text></text>
        <input class="form-input" type="number" placeholder="请输入件价" value="{{formData.pricePiece}}" bindinput="onInputChange" data-field="pricePiece" />
      </view>

      <!-- 包价 -->
      <view class="form-group">
        <text class="form-label">包价 (每{{formData.unit}}售价) <text class="required">*</text></text>
        <input class="form-input" type="number" placeholder="请输入包价" value="{{formData.priceUnit}}" bindinput="onInputChange" data-field="priceUnit" />
      </view>
    </scroll-view>

    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="closeForm">取消</button>
      <button class="btn btn-primary" bindtap="saveProduct" loading="{{saving}}">{{saving ? '保存中...' : '保存'}}</button>
    </view>
  </view>
</view>
