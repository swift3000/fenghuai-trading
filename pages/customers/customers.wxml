<view class="container" style="{{uiStyle}}">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input placeholder="搜索客户名称/简称/联系人/区域" value="{{searchKeyword}}" bindinput="onSearch" />
  </view>

  <!-- 新增客户（对齐原型：搜索框下方橙色全宽按钮，customer:edit 控制） -->
  <view class="add-customer-bar" wx:if="{{canEdit}}">
    <button class="btn-add-customer" bindtap="goToAdd">＋ 新增客户</button>
  </view>

  <!-- 客户列表（按区域分组） -->
  <view class="customer-list">
    <view class="region-group" wx:for="{{customerGroups}}" wx:for-item="group" wx:for-index="gi" wx:key="region">
      <view class="region-title">{{group.region}}</view>
      <view class="cust-row" wx:for="{{group.items}}" wx:for-item="item" wx:key="_id">
        <view class="cust-main">
          <text class="cust-name">{{item.name}}<text class="cust-alias" wx:if="{{item.alias}}">{{item.alias}}</text></text>
          <text class="cust-contact">{{item.phone}}{{item.contact ? ' · ' + item.contact : ''}}</text>
        </view>
        <view class="cust-side">
          <text class="cust-region-badge">{{item.region}}</text>
          <view class="cust-btns" wx:if="{{canEdit}}">
            <text class="btn-edit-c" data-item="{{item}}" bindtap="goEdit">编辑</text>
            <text class="btn-del-c" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="onDelete">删除</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{customerGroups.length === 0}}">暂无客户</view>
  </view>

  <!-- 导入弹窗 -->
  <view class="modal-mask" wx:if="{{showImportDialog}}" bindtap="hideImportDialog"></view>
  <view class="modal-content" wx:if="{{showImportDialog}}">
    <view class="modal-header">
      <text class="modal-title">导入原型数据</text>
      <text class="modal-close" bindtap="hideImportDialog">×</text>
    </view>
    <scroll-view scroll-y class="modal-body">
      <view class="import-info">
        <text class="info-text">将导入 {{defaultCustomersCount}} 个客户数据</text>
        <view class="import-options">
          <label class="radio-label">
            <radio color="#07C160" checked="{{importOverride}}" bindtap="toggleOverride" />
            <text class="radio-text">覆盖已存在的客户</text>
          </label>
        </view>
        <view class="warning-box">
          <text class="warning-text">⚠️ 导入过程中请勿关闭页面</text>
        </view>
      </view>
    </scroll-view>
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="hideImportDialog">取消</button>
      <button class="btn btn-primary" bindtap="confirmImport" loading="{{importing}}">
        {{importing ? '导入中...' : '开始导入'}}
      </button>
    </view>
  </view>

  <!-- 表单弹窗 -->
  <view class="modal-mask" wx:if="{{showForm}}" bindtap="closeForm"></view>
  <view class="modal-content" wx:if="{{showForm}}">
    <view class="modal-header">
      <text class="modal-title">{{editingCustomer ? '编辑客户' : '添加客户'}}</text>
      <text class="modal-close" bindtap="closeForm">×</text>
    </view>
    
    <scroll-view scroll-y class="modal-body">
      <!-- 客户名称 -->
      <view class="form-group">
        <text class="form-label">客户名称 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入客户名称" value="{{formData.name}}" bindinput="onInputChange" data-field="name" />
      </view>

      <!-- 简称 -->
      <view class="form-group">
        <text class="form-label">简称</text>
        <input class="form-input" placeholder="请输入客户简称" value="{{formData.alias}}" bindinput="onInputChange" data-field="alias" />
      </view>

      <!-- 区域 -->
      <view class="form-group">
        <text class="form-label">区域 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入区域" value="{{formData.region}}" bindinput="onInputChange" data-field="region" />
      </view>

      <!-- 电话 -->
      <view class="form-group">
        <text class="form-label">电话</text>
        <input class="form-input" type="number" placeholder="请输入联系电话" value="{{formData.phone}}" bindinput="onInputChange" data-field="phone" />
      </view>

      <!-- 联系人 -->
      <view class="form-group">
        <text class="form-label">联系人</text>
        <input class="form-input" placeholder="请输入联系人姓名" value="{{formData.contact}}" bindinput="onInputChange" data-field="contact" />
      </view>
    </scroll-view>

    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="closeForm">取消</button>
      <button class="btn btn-primary" bindtap="saveCustomer" loading="{{saving}}">{{saving ? '保存中...' : '保存'}}</button>
    </view>
  </view>
</view>
