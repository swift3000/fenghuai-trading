.container {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

/* 顶部操作栏 */
.action-bar {
  margin-bottom: 24rpx;
}

.btn-import {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #FFF7ED 0%, #FFF3E6 100%);
  color: #F5A623;
  border: 2rpx solid #F5A623;
  border-radius: 16rpx;
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 500;
  text-align: center;
  transition: all 0.3s;
}

.btn-import::after {
  border: none;
}

.btn-import:active {
  background: linear-gradient(135deg, #FFE8CC 0%, #FFE8CC 100%);
  transform: scale(0.98);
}

.search-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid rgba(6, 173, 86, 0.1);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-bar::before {
  content: '🔍';
  font-size: calc(32rpx * var(--font-scale));
  opacity: 0.6;
}

.search-bar input {
  flex: 1;
  font-size: calc(28rpx * var(--font-scale));
  outline: none;
}

.customer-item {
  padding: 24rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s;
  border: 1rpx solid rgba(6, 173, 86, 0.08);
}

.customer-item:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(6, 173, 86, 0.12);
}

.customer-name {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: bold;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-muted {
  font-size: calc(24rpx * var(--font-scale));
  color: #999;
  white-space: nowrap;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.customer-contact {
  font-size: calc(24rpx * var(--font-scale));
  color: #666;
  margin-top: 12rpx;
  display: block;
  opacity: 0.85;
}

.customer-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--theme-primary);
  font-weight: 500;
}

.customer-actions text:active {
  opacity: 0.6;
}

.text-danger {
  color: #FF3B30;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: calc(28rpx * var(--font-scale));
  background: #fafafa;
  border-radius: 16rpx;
  border: 1rpx dashed #e0e0e0;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #fff;
  font-size: calc(56rpx * var(--font-scale));
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(6, 173, 86, 0.35);
  transition: all 0.3s;
}

.fab-btn:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 16rpx rgba(6, 173, 86, 0.25);
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 998;
  backdrop-filter: blur(4rpx);
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 85%;
  background: #fff;
  border-radius: 20rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(6, 173, 86, 0.15);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(135deg, var(--theme-primary-bg) 0%, #fff 100%);
}

.modal-title {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.modal-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  border-radius: 3rpx;
}

.modal-close {
  font-size: calc(48rpx * var(--font-scale));
  color: #999;
  line-height: 1;
  transition: all 0.2s;
}

.modal-close:active {
  transform: scale(0.9);
  opacity: 0.7;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
  background: #fafafa;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
}

/* 表单样式 */
.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: calc(28rpx * var(--font-scale));
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #FF3B30;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--font-scale));
  box-sizing: border-box;
  border: 1rpx solid #e8e8e8;
  transition: all 0.3s;
}

.form-input:focus {
  border-color: var(--theme-primary);
  background: var(--theme-primary-bg);
  box-shadow: 0 0 0 3rpx rgba(6, 173, 86, 0.1);
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--font-scale));
  box-sizing: border-box;
  border: 1rpx solid #e8e8e8;
  transition: all 0.3s;
}

.form-textarea:focus {
  border-color: var(--theme-primary);
  background: var(--theme-primary-bg);
  box-shadow: 0 0 0 3rpx rgba(6, 173, 86, 0.1);
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--font-scale));
  border: 1rpx solid #e8e8e8;
  transition: all 0.3s;
}

.picker:active {
  background: var(--theme-primary-bg);
  border-color: var(--theme-primary);
}

/* 按钮样式 */
.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--font-scale));
  text-align: center;
  font-weight: 500;
  transition: all 0.3s;
}

.btn::after {
  border: none;
}

.btn-cancel {
  background: #f7f7f7;
  color: #666;
  border: 1rpx solid #e8e8e8;
}

.btn-cancel:active {
  background: #f0f0f0;
  transform: scale(0.98);
}

.btn-primary {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(6, 173, 86, 0.25);
  position: relative;
  overflow: hidden;
}

.btn-primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.1);
  opacity: 0;
  transition: opacity 0.3s;
}

.btn-primary:active::before {
  opacity: 1;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(6, 173, 86, 0.2);
}

/* 导入弹窗样式 */
.import-info {
  padding: 20rpx 0;
}

.info-text {
  display: block;
  font-size: calc(28rpx * var(--font-scale));
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
  font-weight: 500;
}

.import-options {
  background: var(--theme-primary-bg);
  border: 1rpx solid var(--theme-primary-bg);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.radio-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.radio-text {
  font-size: calc(28rpx * var(--font-scale));
  color: #333;
}

.warning-box {
  background: #FFFBEA;
  border: 1rpx solid #FFE58F;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.warning-text {
  display: block;
  font-size: calc(26rpx * var(--font-scale));
  color: #FA8C16;
  line-height: 1.6;
}
