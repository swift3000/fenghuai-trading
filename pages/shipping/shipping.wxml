<view class="container shipping-page" wx:if="{{order}}" style="{{uiStyle}}">
  <!-- 打印预览区域（对齐原型「销售单」） -->
  <view class="preview-area">
    <view class="shipping-header">
      <text class="title">{{companyName}}食品销售单</text>
    </view>

    <view class="info-section">
      <view class="info-row">
        <text class="label">单号:</text>
        <text class="value">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="label">销售日期:</text>
        <text class="value">{{orderDate}}</text>
      </view>
    </view>

    <view class="customer-section">
      <text class="customer-name">{{order.customerName}}{{order.customerPhone ? '（' + order.customerPhone + '）' : ''}}</text>
    </view>

    <view class="items-table">
      <view class="table-header">
        <view class="col col-idx">编号</view>
        <view class="col col-name">产品</view>
        <view class="col col-spec">规格型号</view>
        <view class="col col-unit">单位</view>
        <view class="col col-qty">总数量</view>
        <view class="col col-price">单价</view>
        <view class="col col-amount">金额</view>
        <view class="col col-remark">备注</view>
      </view>
      <view class="table-body">
        <view class="table-row" wx:for="{{items}}" wx:key="index">
          <view class="col col-idx">{{index + 1}}</view>
          <view class="col col-name">{{item.name}}</view>
          <view class="col col-spec">{{item.spec || ''}}</view>
          <view class="col col-unit">{{item.unit || '件'}}</view>
          <view class="col col-qty">{{item.qtyDesc}}</view>
          <view class="col col-price">{{item.priceText || item.price}}</view>
          <view class="col col-amount">{{item.amountText || item.amount}}</view>
          <view class="col col-remark">{{item.remark || ''}}</view>
        </view>
      </view>
      <view class="total-row in-table">
        <view class="col col-idx"></view>
        <view class="col total-label" style="flex:3">合计</view>
        <view class="col col-unit">{{totalQty}}</view>
        <view class="col col-price"></view>
        <view class="col col-amount">{{shipAmountText}}</view>
        <view class="col col-remark"></view>
      </view>
    </view>

    <view class="summary-line">
      <text>产品合计：{{shipAmountText}}　送货金额：{{shipAmountText}}</text>
      <text>合计金额：{{grandTotalCN}} {{shipAmountText}}</text>
    </view>
    <view class="debt-line">累计欠款：{{totalDebtText}}</view>

    <view class="footer-info">
      <view class="footer-left">
        <view>订货电话：{{order.customerPhone || ''}}</view>
        <view>订货地址：{{order.customerAddress || ''}}</view>
        <view>主营业务：速冻面点，火锅丸子，单位团餐，酒店食材</view>
      </view>
      <view class="footer-right">
        <view>制单人：{{userPhone}}</view>
        <view>收货人(签字)：______________</view>
      </view>
    </view>
    <view class="so-note">注：收到货后，请仔细查看储存说明，冷冻食品属特殊商品，如非产品本身质量问题、日期问题，一经售出，概不退换，谢谢合作！</view>
  </view>
  
  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="btn btn-primary" bindtap="handlePrint">🖨 打印送货单</button>
    <button class="btn btn-secondary" bindtap="handlePreview">👁 打印预览</button>
    <button class="btn btn-tertiary" bindtap="handleBack">← 返回列表</button>
  </view>
  
  <!-- 打印预览弹窗 -->
  <view class="modal-mask" wx:if="{{showPreviewModal}}" bindtap="closePreviewModal"></view>
  <view class="modal-content preview-modal" wx:if="{{showPreviewModal}}">
    <view class="modal-header">
      <text class="modal-title">打印预览</text>
      <text class="modal-close" bindtap="closePreviewModal">×</text>
    </view>
    <view class="modal-body">
      <view class="preview-content">
        <view class="preview-item">
          <text class="preview-label">纸张尺寸:</text>
          <text class="preview-value">{{paperSize}}</text>
        </view>
        <view class="preview-item">
          <text class="preview-label">打印份数:</text>
          <input class="preview-input" type="number" value="{{printCopies}}" bindinput="onPrintCopiesChange" />
        </view>
        <view class="preview-item">
          <text class="preview-label">打印机:</text>
          <picker mode="selector" range="{{printers}}" value="{{printerIndex}}" bindchange="onPrinterChange">
            <view class="preview-picker">{{printers[printerIndex]}}</view>
          </picker>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="closePreviewModal">取消</button>
      <button class="btn btn-primary" bindtap="confirmPrint" loading="{{printLoading}}">{{printLoading ? '打印中...' : '确认打印'}}</button>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-state" wx:else>
  <text class="loading-icon">⏳</text>
  <text class="loading-text">加载中...</text>
</view>
