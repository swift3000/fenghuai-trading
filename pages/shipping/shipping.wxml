<view class="container shipping-page" wx:if="{{order}}">
  <!-- 打印预览区域 -->
  <view class="preview-area">
    <view class="shipping-header">
      <text class="title">丰淮商贸销售单</text>
      <text class="subtitle">SALES INVOICE</text>
    </view>
    
    <view class="info-section">
      <view class="info-row">
        <text class="label">单号:</text>
        <text class="value">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="label">日期:</text>
        <text class="value">{{orderDate}}</text>
      </view>
    </view>
    
    <view class="customer-section">
      <view class="section-title">客户信息</view>
      <view class="info-grid">
        <view class="info-item">
          <text class="label">客户名称:</text>
          <text class="value">{{order.customerName}}</text>
        </view>
        <view class="info-item">
          <text class="label">区域:</text>
          <text class="value">{{order.customerRegion || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">联系人:</text>
          <text class="value">{{order.customerContact || '-'}}</text>
        </view>
        <view class="info-item">
          <text class="label">电话:</text>
          <text class="value">{{order.customerPhone || '-'}}</text>
        </view>
      </view>
    </view>
    
    <view class="items-table">
      <view class="table-header">
        <view class="col col-name">商品名称</view>
        <view class="col col-spec">规格</view>
        <view class="col col-qty">数量</view>
        <view class="col col-price">单价</view>
        <view class="col col-amount">金额</view>
      </view>
      <view class="table-body">
        <view class="table-row" wx:for="{{items}}" wx:key="_id">
          <view class="col col-name">{{item.name}}</view>
          <view class="col col-spec">{{item.spec || '-'}}</view>
          <view class="col col-qty">{{item.qty}}</view>
          <view class="col col-price">¥{{item.price}}</view>
          <view class="col col-amount">¥{{item.amount}}</view>
        </view>
      </view>
    </view>
    
    <view class="total-section">
      <view class="total-row">
        <text class="total-label">合计:</text>
        <text class="total-value">¥{{order.totalAmount}}</text>
      </view>
      <view class="total-row" wx:if="{{order.paidAmount > 0}}">
        <text class="total-label">已收款:</text>
        <text class="total-value text-success">¥{{order.paidAmount}}</text>
      </view>
      <view class="total-row" wx:if="{{order.unpaidAmount > 0}}">
        <text class="total-label">欠款:</text>
        <text class="total-value text-danger">¥{{order.unpaidAmount}}</text>
      </view>
    </view>
    
    <view class="footer">
      <text class="footer-text">备注：{{order.note || '无'}}</text>
      <view class="signature-section">
        <view class="signature-item">
          <text class="signature-label">制单人:</text>
          <text class="signature-value">{{order.createdBy || '系统'}}</text>
        </view>
        <view class="signature-item">
          <text class="signature-label">签收人:</text>
          <text class="signature-value">____________</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="btn btn-primary" bindtap="handlePrint">🖨 打印送货单</button>
    <button class="btn btn-secondary" bindtap="handlePreview">👁 打印预览</button>
    <button class="btn btn-tertiary" bindtap="handleBack">← 返回列表</button>
  </view>
  
  <!-- 打印预览弹窗 -->
  <view class="modal-mask" wx:if="{{showPreviewModal}}" bindtap="closePreviewModal"></view>
  <view class="modal-content preview-modal" wx:if="{{showPreviewModal}}">
    <view class="modal-header">
      <text class="modal-title">打印预览</text>
      <text class="modal-close" bindtap="closePreviewModal">×</text>
    </view>
    <view class="modal-body">
      <view class="preview-content">
        <view class="preview-item">
          <text class="preview-label">纸张尺寸:</text>
          <text class="preview-value">{{paperSize}}</text>
        </view>
        <view class="preview-item">
          <text class="preview-label">打印份数:</text>
          <input class="preview-input" type="number" value="{{printCopies}}" bindinput="onPrintCopiesChange" />
        </view>
        <view class="preview-item">
          <text class="preview-label">打印机:</text>
          <picker mode="selector" range="{{printers}}" value="{{printerIndex}}" bindchange="onPrinterChange">
            <view class="preview-picker">{{printers[printerIndex]}}</view>
          </picker>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="closePreviewModal">取消</button>
      <button class="btn btn-primary" bindtap="confirmPrint" loading="{{printLoading}}">{{printLoading ? '打印中...' : '确认打印'}}</button>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-state" wx:else>
  <text class="loading-icon">⏳</text>
  <text class="loading-text">加载中...</text>
</view>
