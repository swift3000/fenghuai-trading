/* 打印页面 */
.shipping-page {
  background: #fff;
  min-height: 100vh;
  padding: 40rpx;
}

/* 打印预览区域 */
.preview-area {
  background: #fff;
  border: 1rpx solid #e5e5e5;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 40rpx;
  margin-bottom: 40rpx;
}

/* 标题区域 */
.shipping-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #06AD56;
}

.shipping-header .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.shipping-header .subtitle {
  font-size: 24rpx;
  color: #666;
  letter-spacing: 4rpx;
}

/* 信息行 */
.info-section {
  margin-bottom: 30rpx;
}

.info-row {
  font-size: 28rpx;
  line-height: 2;
  display: flex;
}

.info-row .label {
  color: #666;
  min-width: 120rpx;
}

.info-row .value {
  color: #333;
  font-weight: 500;
}

/* 客户信息区域 */
.customer-section {
  margin-bottom: 30rpx;
  padding: 25rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15rpx;
}

.info-item {
  font-size: 26rpx;
  line-height: 2;
  display: flex;
  align-items: center;
}

.info-item .label {
  color: #666;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.info-item .value {
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 商品表格 */
.items-table {
  margin-bottom: 30rpx;
  border: 2rpx solid #333;
}

.table-header,
.table-row {
  display: flex;
  padding: 15rpx 12rpx;
  border-bottom: 1rpx solid #ddd;
  font-size: 26rpx;
  align-items: center;
}

.table-header {
  font-weight: bold;
  background: #f5f5f5;
  color: #333;
}

.table-row:nth-child(even) {
  background: #fafafa;
}

.table-row:last-child {
  border-bottom: none;
}

/* 列宽 */
.col-name { flex: 2; }
.col-spec { flex: 1.5; }
.col-qty { flex: 1; text-align: center; }
.col-price { flex: 1.2; text-align: right; }
.col-amount { flex: 1.3; text-align: right; }

/* 合计区域 */
.total-section {
  margin-top: 30rpx;
  padding: 25rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  font-size: 28rpx;
}

.total-row:last-child {
  margin-bottom: 0;
}

.total-label {
  color: #666;
  font-weight: 500;
}

.total-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.total-value.text-success {
  color: #06AD56;
}

.total-value.text-danger {
  color: #FF3B30;
}

/* 页脚 */
.footer {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #e5e5e5;
}

.footer-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 25rpx;
}

.signature-section {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}

.signature-item {
  font-size: 26rpx;
  line-height: 2;
  display: flex;
  align-items: center;
}

.signature-label {
  color: #666;
  margin-right: 10rpx;
}

.signature-value {
  color: #333;
  border-bottom: 1rpx solid #333;
  padding: 0 20rpx;
  min-width: 150rpx;
  display: inline-block;
}

/* 操作按钮 */
.action-buttons {
  margin-top: 50rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-buttons .btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-buttons .btn-primary {
  background: linear-gradient(135deg, #06AD56 0%, #059d4e 100%);
  color: #fff;
}

.action-buttons .btn-secondary {
  background: linear-gradient(135deg, #FF8A2B 0%, #f57a1a 100%);
  color: #fff;
}

.action-buttons .btn-tertiary {
  background: #f5f5f5;
  color: #666;
}

.action-buttons .btn:active {
  opacity: 0.8;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.modal-content {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 16rpx;
  width: 80%;
  max-width: 600rpx;
  z-index: 1000;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 35rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 50rpx;
  color: #999;
  line-height: 1;
  padding: 0 10rpx;
}

.modal-body {
  padding: 35rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 25rpx 35rpx;
  border-top: 1rpx solid #e5e5e5;
}

.modal-footer .btn {
  min-width: 180rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  border: none;
}

.modal-footer .btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-footer .btn-primary {
  background: linear-gradient(135deg, #06AD56 0%, #059d4e 100%);
  color: #fff;
}

/* 预览弹窗内容 */
.preview-content {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.preview-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.preview-item:last-child {
  border-bottom: none;
}

.preview-label {
  font-size: 28rpx;
  color: #666;
}

.preview-value,
.preview-picker {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.preview-input {
  width: 150rpx;
  height: 70rpx;
  line-height: 70rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
}

.preview-picker {
  background: #f5f5f5;
  padding: 15rpx 20rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
}

.preview-picker::after {
  content: '›';
  margin-left: 10rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  gap: 20rpx;
}

.loading-icon {
  font-size: 80rpx;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 响应式调整 */
@media screen and (max-width: 375px) {
  .shipping-page {
    padding: 30rpx;
  }
  
  .info-grid {
    grid-template-columns: 1fr;
  }
  
  .signature-section {
    flex-direction: column;
    gap: 20rpx;
  }
}
