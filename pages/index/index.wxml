<view class="container" style="{{uiStyle}}">
  <!-- 隐私政策横幅 -->
  <view class="privacy-banner">
    <text class="privacy-icon">🔒</text>
    <text class="privacy-text">本应用遵循《隐私政策》，仅收集必要信息用于业务处理</text>
    <text class="privacy-link">查看 ›</text>
    <text class="privacy-close">✕</text>
  </view>

  <!-- Hero 区域 -->
  <view class="home-hero">
    <image class="hero-illust" src="/assets/icons/hero-illust.png" mode="aspectFit"></image>
    <view class="hero-main">
    <view class="user-row">
      <view class="avatar">{{userInitial}}</view>
      <view class="user-info">
        <text class="greeting">你好，{{userName}} {{roleEmoji}}</text>
        <text class="date">{{currentDate}}</text>
      </view>
      <view class="role-badge">{{roleName}}</view>
    </view>
    <text class="hero-title">丰淮采购下单</text>
    <view class="hero-pill-row">
      <view class="hero-pill"><image class="hero-pill-bolt" src="/assets/icons/pill_bolt.png" mode="aspectFit"></image><text>24小时在线下单</text></view>
      <text class="hero-pill ghost">移动开单 · 实时对账</text>
    </view>
    </view>
  </view>

  <!-- 全局搜索条 -->
  <view class="home-search">
    <text class="hs-icon">🔍</text>
    <input class="hs-input" type="search" placeholder="搜索订单号或客户名称" placeholder-class="hs-ph" value="{{searchKeyword}}" bindinput="onGlobalSearchInput" confirm-type="search" bindconfirm="goGlobalSearch" />
    <view class="hs-btn" bindtap="goGlobalSearch">搜索</view>
  </view>

  <!-- 功能宫格（参考小程序入口风格） -->
  <view class="home-grid">
    <view wx:if="{{canCreateOrder}}" class="home-cell p-blue" bindtap="goToNewOrder">
      <view class="hc-icon"><image src="/assets/icons/grid_new-order.png" mode="aspectFit"></image></view>
      <text class="hc-title">新建订单</text>
      <text class="hc-sub">快速录入客户订单</text>
    </view>
    <view class="home-cell p-green" bindtap="goToOrders">
      <view class="hc-icon"><image src="/assets/icons/grid_orders.png" mode="aspectFit"></image></view>
      <text class="hc-title">订单查询</text>
      <text class="hc-sub">今日 · 本周 · 全部</text>
    </view>
    <view wx:if="{{canViewReceivable}}" class="home-cell p-violet" bindtap="goToReceivable">
      <view class="hc-icon"><image src="/assets/icons/grid_receivable.png" mode="aspectFit"></image></view>
      <text class="hc-title">赊销看板</text>
      <text class="hc-sub">欠款 · 收款确认</text>
    </view>
    <view wx:if="{{canViewReports}}" class="home-cell p-cyan" bindtap="goToReports">
      <view class="hc-icon"><image src="/assets/icons/grid_reports.png" mode="aspectFit"></image></view>
      <text class="hc-title">报表中心</text>
      <text class="hc-sub">日 · 月经营数据</text>
    </view>
    <view wx:if="{{canViewCustomers}}" class="home-cell p-yellow" bindtap="goToCustomers">
      <view class="hc-icon"><image src="/assets/icons/grid_customers.png" mode="aspectFit"></image></view>
      <text class="hc-title">客户管理</text>
      <text class="hc-sub">客户档案 · 区域</text>
    </view>
    <view wx:if="{{canViewProducts}}" class="home-cell p-orange" bindtap="goToProducts">
      <view class="hc-icon"><image src="/assets/icons/grid_products.png" mode="aspectFit"></image></view>
      <text class="hc-title">商品管理</text>
      <text class="hc-sub">料号 · 价格 · 规格</text>
    </view>
  </view>

  <!-- 公告栏 -->
  <view class="announce-bar">
    <view class="announce-icon"><image src="/assets/icons/announce_megaphone.png" mode="aspectFit"></image></view>
    <view class="announce-content">
      <text class="announce-text">{{announcement}}</text>
      <view class="announce-dots">
        <view class="announce-dot active"></view>
        <view class="announce-dot"></view>
        <view class="announce-dot"></view>
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="home-stats">
    <view class="stat">
      <text class="num">{{todayOrders}}</text>
      <text class="lbl">今日订单</text>
    </view>
    <view class="stat">
      <text class="num">¥{{todayAmount}}</text>
      <text class="lbl">今日金额</text>
    </view>
    <view class="stat pending" bindtap="goToWorkbench">
      <text class="num">{{pendingCount}}</text>
      <text class="lbl">{{pendingLabel}}</text>
    </view>
  </view>

  <!-- 今日订单列表 -->
  <view class="section-title">
    <text>今日订单</text>
    <text class="more" bindtap="goToOrders">查看全部 ›</text>
  </view>
  <view class="card order-list-container">
    <view class="order-list-item" wx:for="{{todayOrdersList}}" wx:key="_id" bindtap="goToOrderDetail" data-id="{{item._id}}">
      <view class="left">
        <text class="customer">{{item.customerName}}</text>
        <text class="sub">{{item.time}} · {{item.itemCount}} 件商品</text>
      </view>
      <view class="right">
        <text class="amount">¥{{item.totalAmount}}</text>
        <text class="status {{item.status}}">{{item.statusText}}</text>
      </view>
    </view>
    <view class="empty-hint" wx:if="{{todayOrdersList.length === 0}}">
      <text>暂无今日订单</text>
    </view>
  </view>
  <!-- 智能录入悬浮球（右下角，避开居中“+”） -->
  <view class="smart-fab" wx:if="{{canCreateOrder}}" bindtap="goToSmartInput" hover-class="smart-fab-hover">
    <view class="smart-fab-bubble">智能录入</view>
    <view class="smart-fab-ball"><text class="smart-fab-icon">🤖</text></view>
  </view>
</view>
