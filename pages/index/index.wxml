<view class="container" style="{{uiStyle}}">
  <!-- 隐私政策横幅 -->
  <view class="privacy-banner">
    <text class="privacy-icon">🔒</text>
    <text class="privacy-text">本应用遵循《隐私政策》，仅收集必要信息用于业务处理</text>
    <text class="privacy-link">查看 ›</text>
    <text class="privacy-close">✕</text>
  </view>

  <!-- Hero（老板版：仅问候行） -->
  <view class="home-hero">
    <view class="user-row">
      <view class="avatar">{{userInitial}}</view>
      <view class="user-info">
        <text class="greeting">你好，{{userName}} {{roleEmoji}}</text>
        <text class="date">{{currentDate}}</text>
      </view>
      <view class="role-badge">{{roleName}}</view>
    </view>
  </view>

  <!-- 全局搜索条 -->
  <view class="home-search">
    <text class="hs-icon">🔍</text>
    <input class="hs-input" type="search" placeholder="搜索订单号或客户名称" placeholder-class="hs-ph" value="{{searchKeyword}}" bindinput="onGlobalSearchInput" confirm-type="search" bindconfirm="goGlobalSearch" />
    <view class="hs-btn" bindtap="goGlobalSearch">搜索</view>
  </view>

  <!-- 公告栏 -->
  <view class="announce-bar">
    <view class="announce-icon"><image src="/assets/icons/announce_megaphone.png" mode="aspectFit"></image></view>
    <view class="announce-content">
      <text class="announce-text">{{announcement}}</text>
      <view class="announce-dots">
        <view class="announce-dot active"></view>
        <view class="announce-dot"></view>
        <view class="announce-dot"></view>
      </view>
    </view>
  </view>

  <!-- 统计卡片（老板版：2 卡） -->
  <view class="home-stats">
    <view class="stat">
      <text class="num">{{todayOrders}}</text>
      <text class="lbl">今日订单</text>
    </view>
    <view class="stat">
      <text class="num">¥{{todayAmount}}</text>
      <text class="lbl">今日金额</text>
    </view>
  </view>

  <!-- 功能入口（老板版：4 格一行） -->
  <view class="home-actions">
    <view wx:if="{{canCreateOrder}}" class="action" bindtap="goToNewOrder"><view class="icon c1">📝</view><view class="lbl">新建订单</view></view>
    <view wx:if="{{canViewProducts}}" class="action" bindtap="goToProducts"><view class="icon c2">📦</view><view class="lbl">商品管理</view></view>
    <view wx:if="{{canViewCustomers}}" class="action" bindtap="goToCustomers"><view class="icon c3">🏪</view><view class="lbl">客户管理</view></view>
    <view wx:if="{{canViewReports}}" class="action" bindtap="goToReports"><view class="icon c4">📊</view><view class="lbl">报表导出</view></view>
  </view>

  <!-- 智能录入悬浮球（右下角，避开居中"＋"） -->
  <view class="smart-fab" wx:if="{{canCreateOrder}}" bindtap="goToSmartInput" hover-class="smart-fab-hover">
    <view class="smart-fab-bubble">智能录入</view>
    <view class="smart-fab-ball"><text class="smart-fab-icon">🤖</text></view>
  </view>
</view>
