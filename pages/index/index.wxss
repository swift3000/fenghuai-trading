/* 容器 */
.container {
  min-height: 100vh;
  background: #F5F6F8;
  padding-bottom: 40rpx;
  padding-top: 12px;
}

/* 隐私政策横幅 */
.privacy-banner {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #FFF8E1;
  border-bottom: 1px solid #FFE082;
  padding: 8px 12px;
  font-size: 11px;
  color: #8D6E26;
}

.privacy-banner .privacy-icon {
  font-size: 13px;
}

.privacy-banner .privacy-text {
  flex: 1;
  line-height: 1.4;
}

.privacy-banner .privacy-link {
  color: var(--theme-primary);
  font-weight: 500;
  white-space: nowrap;
}

.privacy-banner .privacy-close {
  color: #8D6E26;
  padding: 2px 4px;
  font-size: 14px;
  line-height: 1;
}

/* Hero 服务卡（对齐老版原型：浅色渐变圆角卡）*/
.home-hero {
  position: relative;
  overflow: hidden;
  margin: 12px;
  border-radius: 20px;
  padding: 16px 16px 18px;
  background: linear-gradient(135deg, #CDEEDA 0%, #E2F6E9 46%, #F3FBF5 100%);
  box-shadow: 0 10px 26px rgba(36, 173, 82, 0.10);
  color: #1A3A27;
}

.home-hero::before {
  content: "";
  position: absolute;
  top: -84px;
  right: -56px;
  width: 230px;
  height: 230px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0) 70%);
}
.home-hero::after {
  content: "";
  position: absolute;
  bottom: -70px;
  left: -46px;
  width: 190px;
  height: 190px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(69, 208, 111, 0.22) 0%, rgba(69, 208, 111, 0) 70%);
}
.hero-illust {
  position: absolute;
  right: 2px;
  top: 50%;
  transform: translateY(-46%);
  width: 118px;
  height: 108px;
  pointer-events: none;
  z-index: 1;
}
.hero-main {
  position: relative;
  z-index: 2;
  padding-right: 78px;
}
.home-hero .user-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 12px;
}

.home-hero .avatar {
  width: 40px;
  height: 40px;
  border-radius: 13px;
  background: #fff;
  color: #24AD52;
  border: 1px solid rgba(36, 173, 82, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
  font-weight: 800;
  box-shadow: 0 4px 12px rgba(36, 173, 82, 0.16);
}

.home-hero .user-info {
  flex: 1;
}

.home-hero .greeting {
  font-size: 15px;
  font-weight: 700;
  color: #275239;
  line-height: 1.3;
  display: block;
  margin-bottom: 2px;
}

.home-hero .date {
  font-size: 11px;
  color: #7A948A;
  display: block;
}

.home-hero .role-badge {
  margin-left: auto;
  padding: 5px 11px;
  border: 1px solid rgba(36, 173, 82, 0.28);
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  background: #fff;
  color: #1E7A43;
  white-space: nowrap;
  box-shadow: 0 2px 8px rgba(36, 173, 82, 0.10);
}

/* 公告栏 */
.announce-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #E6F7EC;
  border: 1px solid rgba(36, 173, 82, 0.14);
  margin: 12px;
  position: relative;
  z-index: 2;
  border-radius: 13px;
  padding: 9px 12px;
}

.announce-bar .announce-icon {
  width: 27px;
  height: 27px;
  flex: none;
  border-radius: 9px;
  background: linear-gradient(135deg, #45D06F, #24AD52);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(36, 173, 82, 0.24);
}
.announce-bar .announce-icon image {
  width: 15px;
  height: 15px;
}

.announce-bar .announce-content {
  flex: 1;
  min-width: 0;
}

.announce-bar .announce-text {
  font-size: 12.5px;
  color: #2F5D43;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

.announce-bar .announce-dots {
  display: flex;
  gap: 4px;
  margin-top: 4px;
}

.announce-bar .announce-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #BFE3CB;
  transition: all 0.2s;
}

.announce-bar .announce-dot.active {
  background: #24AD52;
}

/* 统计卡片 */
.home-stats {
  display: flex;
  gap: 12px;
  margin: 0 12px 0;
  position: relative;
  z-index: 1;
}

.home-stats .stat {
  flex: 1;
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  text-align: center;
}

.home-stats .num {
  font-size: 24px;
  font-weight: 700;
  color: var(--theme-primary);
  display: block;
}

.home-stats .lbl {
  font-size: 12px;
  color: #666;
  margin-top: 4px;
  display: block;
}

/* 分区标题 */
.section-title {
  font-size: 15px;
  font-weight: 700;
  margin: 12px 14px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title .more {
  font-size: 12px;
  color: #24AD52;
  font-weight: 600;
}

/* 卡片容器 */
.card {
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 订单列表 */
.order-list-container {
  padding: 0;
}

.order-list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid #EFEFEF;
  cursor: pointer;
}

.order-list-item:last-child {
  border-bottom: none;
}

.order-list-item .left .customer {
  font-size: 15px;
  font-weight: 600;
  display: block;
}

.order-list-item .left .sub {
  font-size: 12px;
  color: #666;
  margin-top: 4px;
  display: block;
}

.order-list-item .right {
  text-align: right;
}

.order-list-item .right .amount {
  font-size: 16px;
  font-weight: 600;
  color: var(--theme-primary);
  display: block;
}

.order-list-item .right .status {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 10px;
  display: inline-block;
  margin-top: 4px;
}

.order-list-item .right .status.submitted {
  background: rgba(255, 107, 53, 0.1);
  color: #FF6B35;
}

.order-list-item .right .status.sorted {
  background: rgba(25, 137, 250, 0.1);
  color: #1989FA;
}

.order-list-item .right .status.shipped {
  background: rgba(7, 193, 96, 0.1);
  color: var(--theme-primary);
}

.order-list-item .right .status.paid {
  background: rgba(7, 193, 96, 0.1);
  color: var(--theme-primary);
}

/* 空状态 */
.empty-hint {
  text-align: center;
  padding: 60px 20px;
  color: #999;
  font-size: 14px;
}

/* 响应式适配 */
@media screen and (max-width: 375px) {
  .home-hero .greeting {
    font-size: 16px;
  }
  
  .home-hero .date {
    font-size: 11px;
  }
  
  .home-stats .num {
    font-size: 22px;
  }
  
}

/* ===== Hero 标题 + Pill ===== */
.home-hero .hero-title {
  font-size: 23px;
  font-weight: 800;
  color: #1A3A27;
  letter-spacing: 1px;
  margin-top: 12px;
  display: block;
}
.home-hero .hero-pill-row {
  margin-top: 10px;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.home-hero .hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  height: 26px;
  padding: 0 12px;
  border-radius: 999px;
  background: linear-gradient(135deg, #45D06F, #24AD52);
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  box-shadow: 0 6px 14px rgba(36, 173, 82, 0.30);
  line-height: 1;
}
.home-hero .hero-pill-bolt {
  width: 13px;
  height: 13px;
}
.home-hero .hero-pill.ghost {
  background: rgba(255, 255, 255, 0.72);
  color: #275239;
  border: 1px solid rgba(36, 173, 82, 0.22);
  box-shadow: none;
}

/* 全局搜索条 */
.home-search {
  margin: 10px 12px 0;
  background: #fff;
  border: 1px solid var(--theme-border, #EFEFEF);
  border-radius: 14px;
  display: flex;
  align-items: center;
  padding: 6px 6px 6px 14px;
  gap: 8px;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.home-search .hs-icon {
  font-size: 15px;
  color: #bbb;
  flex: none;
}
.home-search .hs-input {
  flex: 1;
  min-width: 0;
  height: 34px;
  font-size: 13px;
  color: #191919;
}
.home-search .hs-ph {
  color: #bbb;
}
.home-search .hs-btn {
  height: 34px;
  padding: 0 18px;
  border-radius: 10px;
  background: linear-gradient(135deg, #45D06F, #24AD52);
  color: #fff;
  font-weight: 700;
  font-size: 13px;
  display: flex;
  align-items: center;
  box-shadow: 0 4px 10px rgba(36, 173, 82, 0.28);
  flex: none;
}
.home-search .hs-btn:active {
  transform: scale(0.96);
}

/* 第三项统计：可点击 */
.home-stats .stat.pending {
  cursor: pointer;
}
.home-stats .stat.pending:active {
  transform: scale(0.98);
}

/* 功能入口（老板版：4 格一行） */
.home-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4px;
  background: #fff;
  margin: 12px;
  border-radius: 16px;
  padding: 14px 0;
  box-shadow: 0 4px 20px rgba(0,0,0,0.06);
}
.home-actions .action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 8px 4px;
  border-radius: 8px;
}
.home-actions .action:active { background: #F5F6F8; }
.home-actions .icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  color: #fff;
}
.home-actions .icon.c1 { background: linear-gradient(135deg, #45D06F, #24AD52); }
.home-actions .icon.c2 { background: linear-gradient(135deg, #FF9A57, #F2732B); }
.home-actions .icon.c3 { background: linear-gradient(135deg, #4C93FF, #2E7CF6); }
.home-actions .icon.c4 { background: linear-gradient(135deg, #7C3AED, #5B1FB0); }
.home-actions .lbl {
  font-size: 12px;
  color: #333;
  font-weight: 600;
}

/* ===== 浅色功能宫格（2 列 pastel 卡片）===== */
.home-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin: 12px;
}
.home-cell {
  position: relative;
  min-height: 108px;
  border-radius: 18px;
  padding: 14px;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.12s;
  box-shadow: 0 4px 14px rgba(23, 58, 40, 0.05);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.home-cell:active {
  transform: scale(0.965);
}
.home-cell .hc-icon {
  width: 40px;
  height: 40px;
  border-radius: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.home-cell .hc-icon image {
  width: 22px;
  height: 22px;
}
.home-cell .hc-title {
  font-size: 15.5px;
  font-weight: 800;
  color: #1F2D26;
  letter-spacing: 0.3px;
  margin-top: 10px;
}
.home-cell .hc-sub {
  font-size: 11px;
  color: #7C8AA5;
  margin-top: 4px;
  line-height: 1.45;
}
.home-cell.p-blue { background: linear-gradient(135deg, #D9EAFF 0%, #EBF4FF 100%); }
.home-cell.p-blue .hc-icon { background: linear-gradient(135deg, #4C93FF, #2E7CF6); box-shadow: 0 8px 16px rgba(46, 124, 246, 0.30); }
.home-cell.p-green { background: linear-gradient(135deg, #DCF3E4 0%, #EDFAF1 100%); }
.home-cell.p-green .hc-icon { background: linear-gradient(135deg, #3BB271, #16A34A); box-shadow: 0 8px 16px rgba(22, 163, 74, 0.26); }
.home-cell.p-yellow { background: linear-gradient(135deg, #FFF3D1 0%, #FFF9E8 100%); }
.home-cell.p-yellow .hc-icon { background: linear-gradient(135deg, #F7C14B, #EFA312); box-shadow: 0 8px 16px rgba(239, 163, 18, 0.26); }
.home-cell.p-orange { background: linear-gradient(135deg, #FFE4CD 0%, #FFF1E6 100%); }
.home-cell.p-orange .hc-icon { background: linear-gradient(135deg, #FF9A57, #F2732B); box-shadow: 0 8px 16px rgba(242, 115, 43, 0.26); }
.home-cell.p-violet { background: linear-gradient(135deg, #E9E1FD 0%, #F3EEFF 100%); }
.home-cell.p-violet .hc-icon { background: linear-gradient(135deg, #9B7CF8, #7C3AED); box-shadow: 0 8px 16px rgba(124, 58, 237, 0.26); }
.home-cell.p-cyan { background: linear-gradient(135deg, #D3F2F8 0%, #E6FAFC 100%); }
.home-cell.p-cyan .hc-icon { background: linear-gradient(135deg, #3CC0D9, #14A3BC); box-shadow: 0 8px 16px rgba(20, 163, 188, 0.26); }

/* 自定义底部 TabBar 占位，防止内容被遮挡 */
.container {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom)) !important;
}

/* ===== 智能录入悬浮球（右下角，避开居中“+”） ===== */
.smart-fab {
  position: fixed;
  right: 24rpx;
  bottom: calc(210rpx + env(safe-area-inset-bottom));
  z-index: 99;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.smart-fab-bubble {
  background: rgba(36, 173, 82, 0.92);
  color: #fff;
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(36, 173, 82, 0.32);
  white-space: nowrap;
}
.smart-fab-ball {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #45D06F 0%, #1E9E4B 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(36, 173, 82, 0.42);
  border: 4rpx solid rgba(255, 255, 255, 0.7);
}
.smart-fab-icon {
  font-size: calc(46rpx * var(--font-scale));
  line-height: 1;
}
.smart-fab-hover .smart-fab-ball {
  transform: scale(0.92);
  filter: brightness(0.95);
}
.smart-fab-hover .smart-fab-bubble {
  opacity: 0.85;
}
