.time-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(6, 173, 86, 0.08);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: calc(28rpx * var(--font-scale));
  color: #666666;
  border-radius: 12rpx;
  transition: all 0.3s;
  font-weight: 500;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(6, 173, 86, 0.25);
}

.tab-item:active {
  transform: scale(0.96);
}

.search-bar {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(6, 173, 86, 0.08);
}

.search-bar input {
  font-size: calc(28rpx * var(--font-scale));
}

.order-card {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(6, 173, 86, 0.08);
  transition: all 0.3s;
}

.order-card:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(6, 173, 86, 0.12);
}

.customer-name {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
  color: #333;
}

.order-amount {
  font-size: calc(32rpx * var(--font-scale));
  color: var(--theme-primary);
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(6, 173, 86, 0.1);
}

.order-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: #999999;
}

.status-tag {
  background: linear-gradient(135deg, var(--theme-primary-bg) 0%, var(--theme-primary-bg) 100%);
  color: var(--theme-primary);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 500;
  border: 1rpx solid rgba(6, 173, 86, 0.2);
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: calc(28rpx * var(--font-scale));
  background: #fafafa;
  border-radius: 16rpx;
  border: 1rpx dashed #e0e0e0;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #ffffff;
  font-size: calc(56rpx * var(--font-scale));
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(6, 173, 86, 0.35);
  transition: all 0.3s;
}

.fab-btn:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 16rpx rgba(6, 173, 86, 0.25);
}

/* 付款状态标签（对齐原型 payChip） */
.pay-chip {
  display: inline-block;
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: calc(22rpx * var(--font-scale));
  vertical-align: middle;
}
.pay-chip.uc { background:#FEF0F0; color:#F56C6C; border:1rpx solid #FBC4C4; }
.pay-chip.pg { background:#ECF5FF; color:#409EFF; border:1rpx solid #B3D8FF; }
.pay-chip.pd { background:#F0F9EB; color:#67C23A; border:1rpx solid #C2E7B0; }

/* 客户分组卡片 */
.group-card {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid rgba(6,173,86,0.08);
}
.group-head { cursor: pointer; }
.group-customer { display:flex; align-items:center; }
.group-sub {
  font-size: calc(24rpx * var(--font-scale));
  color: #999999;
  margin-top: 6rpx;
}
.group-order {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F2F2F2;
}
.order-time { font-size: calc(22rpx * var(--font-scale)); color:#BBB; }
