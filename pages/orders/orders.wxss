.time-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(6, 173, 86, 0.08);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666666;
  border-radius: 12rpx;
  transition: all 0.3s;
  font-weight: 500;
}

.tab-item.active {
  background: linear-gradient(135deg, #06AD56 0%, #06c167 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(6, 173, 86, 0.25);
}

.tab-item:active {
  transform: scale(0.96);
}

.search-bar {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(6, 173, 86, 0.08);
}

.search-bar input {
  font-size: 28rpx;
}

.order-card {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(6, 173, 86, 0.08);
  transition: all 0.3s;
}

.order-card:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(6, 173, 86, 0.12);
}

.customer-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.order-amount {
  font-size: 32rpx;
  color: #06AD56;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(6, 173, 86, 0.1);
}

.order-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.status-tag {
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  color: #06AD56;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(6, 173, 86, 0.2);
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 28rpx;
  background: #fafafa;
  border-radius: 16rpx;
  border: 1rpx dashed #e0e0e0;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #06AD56 0%, #06c167 100%);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(6, 173, 86, 0.35);
  transition: all 0.3s;
}

.fab-btn:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 16rpx rgba(6, 173, 86, 0.25);
}
