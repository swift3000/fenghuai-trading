.time-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666666;
  border-radius: 8rpx;
}

.tab-item.active {
  background: #1a73e8;
  color: #ffffff;
}

.search-bar {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-bar input {
  font-size: 26rpx;
}

.order-card {
  padding: 24rpx;
}

.customer-name {
  font-size: 30rpx;
  font-weight: bold;
}

.order-amount {
  font-size: 30rpx;
  color: #1a73e8;
  font-weight: bold;
}

.order-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.status-tag {
  background: #e8f0fe;
  color: #1a73e8;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: #1a73e8;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #ffffff;
  font-size: 48rpx;
  box-shadow: 0 4rpx 12rpx rgba(26, 115, 232, 0.4);
}
