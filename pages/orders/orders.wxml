<view class="container" style="{{uiStyle}}">
  <view class="time-tabs">
    <view
      class="tab-item {{timeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}" wx:key="key"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <view class="search-bar">
    <input placeholder="搜索订单号/客户名称" bindinput="onSearch" />
  </view>

  <view class="order-list" wx:if="{{orders.length > 0}}">
    <!-- 单个订单卡片展示（原型样式，包含商品列表） -->
    <view class="order-card card" wx:for="{{orders}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
      <!-- 订单头部：客户名 + 状态标签 -->
      <view class="order-header">
        <view class="order-left">
          <text class="customer-name">{{item.customerName}}</text>
          <text class="status-chip {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <view class="order-right">
          <text class="order-amount">¥{{item.totalAmount}}</text>
          <text class="pay-chip {{item.payClass}}" wx:if="{{item.payLabel}}">{{item.payLabel}}</text>
        </view>
      </view>
      
      <!-- 订单元信息：订单号 + 商品数量 + 时间 -->
      <view class="order-meta">
        <text class="order-no">{{item.orderNo}}</text>
        <text class="order-info">{{item.itemCount}}种商品 · {{item.region || ''}}</text>
        <text class="order-time">{{item.timeText}}</text>
      </view>
      
      <!-- 商品列表（原型核心！） -->
      <view class="order-items" wx:if="{{item.items && item.items.length > 0}}">
        <view class="item-row" wx:for="{{item.items}}" wx:key="material_code" wx:for-item="it">
          <view class="item-main">
            <text class="item-name">{{it.name}}</text>
            <text class="item-spec" wx:if="{{it.spec}}">{{it.spec}}</text>
          </view>
          <view class="item-qty">
            <text class="qty-text">×{{it.qtyText}}</text>
            <text class="item-remark" wx:if="{{it.remark}}">{{it.remark}}</text>
          </view>
          <text class="item-amount" wx:if="{{it.amountText}}">¥{{it.amountText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{!orders.length}}">
    <text>暂无订单</text>
  </view>

  <view class="fab-btn" wx:if="{{canCreateOrder}}" bindtap="goToNewOrder">
    <text>+</text>
  </view>
</view>
