.order-header {
  padding: 24rpx;
}

.order-no {
  font-size: 26rpx;
  color: #666666;
}

.status-tag {
  background: #e8f0fe;
  color: #1a73e8;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.total-amount {
  font-size: 40rpx;
  color: #1a73e8;
  font-weight: bold;
  margin-top: 12rpx;
  display: block;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.info-row {
  font-size: 26rpx;
  margin-bottom: 8rpx;
  color: #666666;
}

.item-row {
  padding: 12rpx 0;
}

.item-spec {
  font-size: 24rpx;
  color: #999999;
}

.total-row {
  padding-top: 16rpx;
}

.action-buttons {
  margin-top: 30rpx;
  padding-bottom: 40rpx;
}

.action-buttons button {
  margin-bottom: 16rpx;
}
