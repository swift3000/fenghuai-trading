.order-header {
  padding: 24rpx;
}

.order-no {
  font-size: calc(26rpx * var(--font-scale));
  color: #666666;
}

.status-tag {
  background: #e8f0fe;
  color: #1a73e8;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: calc(24rpx * var(--font-scale));
}

.total-amount {
  font-size: calc(40rpx * var(--font-scale));
  color: #1a73e8;
  font-weight: bold;
  margin-top: 12rpx;
  display: block;
}

.section-title {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.info-row {
  font-size: calc(26rpx * var(--font-scale));
  margin-bottom: 8rpx;
  color: #666666;
}

.item-row {
  padding: 12rpx 0;
}

.item-spec {
  font-size: calc(24rpx * var(--font-scale));
  color: #999999;
}

.total-row {
  padding-top: 16rpx;
}

.action-buttons {
  margin-top: 30rpx;
  padding-bottom: 40rpx;
}

.action-buttons button {
  margin-bottom: 16rpx;
}

.payment-status-text {
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 500;
}

.text-success {
  color: var(--theme-primary);
}

.text-warning {
  color: #FF8A2B;
}

.collect-btn {
  margin-top: 20rpx;
}

/* 收款弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

.modal-content {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 80%;
  background: #fff;
  border-radius: 16rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.collect-modal {
  max-height: 70vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: calc(48rpx * var(--font-scale));
  color: #999;
  line-height: 1;
  padding: 0 8rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #eee;
}

.modal-footer .btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 8rpx;
  font-size: calc(28rpx * var(--font-scale));
  text-align: center;
  border: none;
}

.modal-footer .btn-cancel {
  background: #f7f7f7;
  color: #666;
}

.modal-footer .btn-primary {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(6, 173, 86, 0.25);
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: calc(28rpx * var(--font-scale));
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.amount-input {
  display: flex;
  align-items: center;
  background: #f7f7f7;
  border-radius: 8rpx;
  padding: 0 20rpx;
  height: 88rpx;
}

.currency-symbol {
  font-size: calc(36rpx * var(--font-scale));
  color: #FF3B30;
  font-weight: bold;
  margin-right: 8rpx;
}

.form-input {
  flex: 1;
  font-size: calc(32rpx * var(--font-scale));
  color: #333;
  height: 88rpx;
  line-height: 88rpx;
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: calc(28rpx * var(--font-scale));
  color: #333;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.6;
}

/* 微信转发状态 */
.wechat-share-info {
  margin-top: 24rpx;
}

.share-success {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.share-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: #e6f7ff;
  color: #1890ff;
  border-radius: 4rpx;
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 500;
}

.share-time {
  color: #666;
  font-size: calc(24rpx * var(--font-scale));
}

.share-pending {
  color: #999;
  font-size: calc(24rpx * var(--font-scale));
}

/* 操作记录（对齐原型：订单修改历史） */
.logs-card {
  margin-top: 24rpx;
}

.logs-empty {
  font-size: calc(24rpx * var(--font-scale));
  color: #bbb;
  padding: 10rpx 0;
}

.log-list {
  margin-top: 6rpx;
}

.log-item {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #eee;
}

.log-item:last-child {
  border-bottom: none;
}

.log-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #C0C4CC;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.log-dot-create {
  background: var(--theme-primary);
}

.log-body {
  flex: 1;
  min-width: 0;
}

.log-desc {
  font-size: calc(26rpx * var(--font-scale));
  color: #333;
}

.log-meta {
  font-size: calc(22rpx * var(--font-scale));
  color: #999;
  margin-top: 4rpx;
}
