<view class="container" wx:if="{{order}}" style="{{uiStyle}}">
  <view class="card order-header">
    <view class="flex-between">
      <text class="order-no">{{order.orderNo}}</text>
      <text class="status-tag">{{orderStatusText}}</text>
    </view>
    <text class="total-amount">¥{{order.totalAmount}}</text>
  </view>

  <view class="card customer-info">
    <text class="section-title">客户信息</text>
    <view class="info-row"><text>客户：</text><text>{{customer.name}}</text></view>
    <view class="info-row"><text>区域：</text><text>{{customer.region}}</text></view>
    <view class="info-row"><text>联系人：</text><text>{{customer.contact}}</text></view>
    <view class="info-row"><text>电话：</text><text>{{customer.phone}}</text></view>
    <view class="info-row"><text>下单员：</text><text>{{order.createdByName || '未知'}}</text></view>
  </view>

  <view class="card items-info">
    <text class="section-title">商品明细</text>
    <view class="item-row" wx:for="{{items}}" wx:key="index">
      <view class="flex-between">
        <text>{{item.name}}</text>
        <text>¥{{item.amount}}</text>
      </view>
      <text class="item-spec">{{item.spec}} · 数量 {{item.qtyDesc}}</text>
    </view>
    <view class="divider"></view>
    <view class="flex-between total-row">
      <text class="text-bold">合计</text>
      <text class="total-amount">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <view class="card payment-info">
    <text class="section-title">收款状态</text>
    <view class="info-row flex-between">
      <text>状态：</text>
      <text class="payment-status-text {{paymentStatus === 'paid' ? 'text-success' : 'text-warning'}}">{{paymentStatusText}}</text>
    </view>
    <view class="info-row flex-between">
      <text>已收金额：</text>
      <text class="text-success">¥{{receivedAmount}}</text>
    </view>
    <view class="info-row flex-between">
      <text>折价/货损：</text>
      <text class="{{totalDiscount > 0 ? 'text-warning' : ''}}">¥{{totalDiscount}}</text>
    </view>
    <view class="info-row flex-between">
      <text>剩余欠款：</text>
      <text class="text-danger">¥{{remainingDebt}}</text>
    </view>
    <view wx:if="{{paymentStatus !== 'paid'}}" class="collect-btn">
      <button wx:if="{{canCollect}}" class="btn-primary" bindtap="handleCollect">登记收款</button>
    </view>

  <!-- 微信转发状态 -->
  <view class="card wechat-share-info">
    <text class="section-title">微信转发</text>
    <view wx:if="{{order.shared_to_wechat}}" class="share-success">
      <text class="share-badge">✓ 已转发</text>
      <text class="share-time">{{order.shared_at ? new Date(order.shared_at).toLocaleString('zh-CN') : ''}}</text>
    </view>
    <view wx:else class="share-pending">
      <text>未转发</text>
    </view>
  </view>
  
  <view wx:if="{{order.outStatus === 'done' && (order.ship_large || order.ship_medium || order.ship_small)}}" class="card shipping-info">
    <text class="section-title">物流包裹</text>
    <view class="shipping-tags">
      <view class="shipping-tag">大件：{{order.ship_large || 0}}</view>
      <view class="shipping-tag">中件：{{order.ship_medium || 0}}</view>
      <view class="shipping-tag">小件：{{order.ship_small || 0}}</view>
    </view>
  </view>

  <!-- 操作记录（订单修改历史，对齐原型） -->
  <view class="card logs-card">
    <text class="section-title">操作记录</text>
    <view wx:if="{{logs.length === 0}}" class="logs-empty">暂无操作记录</view>
    <view class="log-list">
      <view class="log-item" wx:for="{{logs}}" wx:key="index">
        <view class="log-dot {{item.action === 'create' ? 'log-dot-create' : ''}}"></view>
        <view class="log-body">
          <view class="log-desc">{{item.desc}}</view>
          <view class="log-meta">{{item.operatorName}}{{item.roleLabel ? '（' + item.roleLabel + '）' : ''}} · {{item.timeText}}</view>
        </view>
      </view>
    </view>
  </view>
  </view>

  <view class="action-buttons">
    <button wx:if="{{canPrint}}" class="btn-primary" bindtap="handlePrint">打印送货单</button>
    <button wx:if="{{canEdit && editEnabled}}" class="btn-secondary" bindtap="handleEdit">编辑订单</button>
    <button wx:if="{{canExport}}" class="btn-secondary" bindtap="handleExportExcel">导出Excel</button>
    <button class="btn-secondary" bindtap="handleCopyOrder">复制订单</button>
    <button wx:if="{{canPrint}}" class="btn-secondary" bindtap="onForwardTap">转发客户微信</button>
    <button wx:if="{{canDelete}}" class="btn-danger" bindtap="handleDelete">删除订单</button>
  </view>

  <!-- 转发销售单卡片画布（隐藏，用于生成转发封面图） -->
  <canvas canvas-id="salesCardCanvas" id="salesCardCanvas" style="position:fixed;left:-9999px;top:0;width:500px;height:2400px;" />

  <!-- 收款弹窗 -->
  <view class="modal-mask" wx:if="{{showCollectModal}}" bindtap="closeCollectModal"></view>
  <view class="modal-content collect-modal" wx:if="{{showCollectModal}}">
    <view class="modal-header">
      <text class="modal-title">登记收款</text>
      <text class="modal-close" bindtap="closeCollectModal">×</text>
    </view>
    <view class="modal-body">
      <view class="form-group">
        <text class="form-label">收款金额</text>
        <view class="amount-input">
          <text class="currency-symbol">¥</text>
          <input class="form-input" type="digit" placeholder="请输入收款金额" value="{{collectAmount}}" bindinput="onCollectAmountChange" />
        </view>
      </view>
      <view class="form-group" wx:if="{{canDiscount}}">
        <text class="form-label">折价/货损金额</text>
        <view class="amount-input">
          <text class="currency-symbol">¥</text>
          <input class="form-input" type="digit" placeholder="折价/货损（可选）" value="{{collectDiscount}}" bindinput="onCollectDiscountChange" />
        </view>
        <text class="form-hint">如货品损坏折扣，需折价/减免权限</text>
      </view>
      <view class="form-group">
        <text class="form-label">收款方式</text>
        <picker mode="selector" range="{{paymentMethods}}" value="{{paymentMethodIndex}}" bindchange="onPaymentMethodChange">
          <view class="picker">{{paymentMethods[paymentMethodIndex]}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">备注</text>
        <textarea class="form-textarea" placeholder="请输入备注（选填）" value="{{collectNote}}" bindinput="onCollectNoteChange"></textarea>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="closeCollectModal">取消</button>
      <button class="btn btn-primary" bindtap="confirmCollect" loading="{{collectLoading}}">{{collectLoading ? '提交中...' : '确认收款'}}</button>
    </view>
  </view>
</view>
