<view class="container" wx:if="{{order}}" style="{{uiStyle}}">
  <!-- 绿色 hero 头 -->
  <view class="detail-hero">
    <view class="hero-order-no">订单号：{{order.orderNo}}</view>
    <view class="hero-amount">¥{{order.totalAmount}}</view>
    <view class="hero-status">
      <view class="hero-status-dot"></view>
      <text>{{orderStatusText}}</text>
    </view>
  </view>

  <!-- 客户信息 -->
  <view class="detail-card">
    <view class="sec-title"><view class="sec-bar"></view><text>客户信息</text></view>
    <view class="detail-row"><text class="dr-lbl">客户名称</text><text class="dr-val">{{customer.name}}</text></view>
    <view class="detail-row"><text class="dr-lbl">所在区域</text><text class="dr-val">{{customer.region}}</text></view>
    <view class="detail-row"><text class="dr-lbl">联系人</text><text class="dr-val">{{customer.contact || '—'}}</text></view>
    <view class="detail-row"><text class="dr-lbl">联系电话</text><text class="dr-val">{{customer.phone || '—'}}</text></view>
    <view class="detail-row"><text class="dr-lbl">下单员</text><text class="dr-val">{{order.createdByName || '未知'}}</text></view>
  </view>

  <!-- 商品明细 -->
  <view class="detail-card">
    <view class="sec-title"><view class="sec-bar"></view><text>商品明细</text></view>
    <view class="di-item" wx:for="{{items}}" wx:key="_id">
      <view class="di-idx">{{index + 1}}</view>
      <view class="di-body">
        <view class="di-name">{{item.name}}<text wx:if="{{item.qtyDesc}}"> · {{item.qtyDesc}}</text></view>
        <view class="di-meta"><text>单价 {{item.priceText}}</text></view>
      </view>
      <view class="di-amount" wx:if="{{item.amountText}}">¥{{item.amountText}}</view>
    </view>
    <view class="di-total-row">
      <text class="di-total-lbl">合计</text>
      <text class="di-total-val">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <!-- 收款状态 -->
  <view class="detail-card">
    <view class="sec-title"><view class="sec-bar"></view><text>收款状态</text></view>
    <view class="detail-row flex-between">
      <text class="dr-lbl">付款状态</text>
      <text class="dr-val {{paymentStatus === 'paid' ? 'text-success' : 'text-warning'}}">{{paymentStatusText}}</text>
    </view>
    <view class="detail-row flex-between">
      <text class="dr-lbl">已收金额</text>
      <text class="dr-val text-success">¥{{receivedAmount}}</text>
    </view>
    <view class="detail-row flex-between">
      <text class="dr-lbl">折价/货损</text>
      <text class="dr-val {{totalDiscount > 0 ? 'text-warning' : ''}}">¥{{totalDiscount}}</text>
    </view>
    <view class="detail-row flex-between">
      <text class="dr-lbl">剩余欠款</text>
      <text class="dr-val text-danger">¥{{remainingDebt}}</text>
    </view>
    <view wx:if="{{paymentStatus !== 'paid'}}" class="collect-btn-wrap">
      <button wx:if="{{canCollect}}" class="btn-primary" bindtap="handleCollect">登记收款</button>
    </view>
  </view>

  <!-- 订单信息（对齐原型：下单时间+微信转发+物流件型） -->
  <view class="detail-card">
    <view class="sec-title"><view class="sec-bar"></view><text>订单信息</text></view>
    <view class="detail-row"><text class="dr-lbl">下单时间</text><text class="dr-val">{{orderTimeText}}</text></view>
    <view class="detail-row"><text class="dr-lbl">微信转发</text><text class="dr-val">{{order.shared_to_wechat ? '已转发' : '未转发'}}</text></view>
    <view class="detail-row"><text class="dr-lbl">物流件型</text><text class="dr-val">{{shipText}}</text></view>
  </view>

  <!-- 操作记录 -->
  <view class="detail-card">
    <view class="sec-title"><view class="sec-bar"></view><text>操作记录</text></view>
    <view wx:if="{{logs.length === 0}}" class="logs-empty">暂无操作记录</view>
    <view class="log-list">
      <view class="log-item" wx:for="{{logs}}" wx:key="index">
        <view class="log-dot {{item.action === 'create' ? 'log-dot-create' : ''}}"></view>
        <view class="log-body">
          <view class="log-desc">{{item.desc}}</view>
          <view class="log-meta">{{item.operatorName}}{{item.roleLabel ? '（' + item.roleLabel + '）' : ''}} · {{item.timeText}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="detail-actions">
    <button wx:if="{{canPrint}}" class="act-btn act-print" bindtap="handlePrint">🖨️ 打印送货单</button>
    <button wx:if="{{canEdit && editEnabled}}" class="act-btn act-edit" bindtap="handleEdit">✏️ 编辑订单</button>
    <button wx:if="{{canExport}}" class="act-btn act-export" bindtap="handleExportExcel">📥 导出Excel</button>
    <button class="act-btn act-copy" bindtap="handleCopyOrder">📋 复制订单</button>
    <button wx:if="{{canPrint}}" class="act-btn act-forward" bindtap="onForwardTap">📤 转发客户微信</button>
    <button wx:if="{{canDelete}}" class="act-btn act-delete" bindtap="handleDelete">🗑️ 删除订单</button>
  </view>

  <view style="height:20px"></view>

  <!-- 转发销售单卡片画布 -->
  <canvas canvas-id="salesCardCanvas" id="salesCardCanvas" style="position:fixed;left:-9999px;top:0;width:500px;height:2400px;" />

  <!-- 收款弹窗 -->
  <view class="modal-mask" wx:if="{{showCollectModal}}" bindtap="closeCollectModal"></view>
  <view class="modal-content collect-modal" wx:if="{{showCollectModal}}">
    <view class="modal-header">
      <text class="modal-title">登记收款</text>
      <text class="modal-close" bindtap="closeCollectModal">×</text>
    </view>
    <view class="modal-body">
      <view class="form-group">
        <text class="form-label">收款金额</text>
        <view class="amount-input">
          <text class="currency-symbol">¥</text>
          <input class="form-input" type="digit" placeholder="请输入收款金额" value="{{collectAmount}}" bindinput="onCollectAmountChange" />
        </view>
      </view>
      <view class="form-group" wx:if="{{canDiscount}}">
        <text class="form-label">折价/货损金额</text>
        <view class="amount-input">
          <text class="currency-symbol">¥</text>
          <input class="form-input" type="digit" placeholder="折价/货损（可选）" value="{{collectDiscount}}" bindinput="onCollectDiscountChange" />
        </view>
        <text class="form-hint">如货品损坏折扣，需折价/减免权限</text>
      </view>
      <view class="form-group">
        <text class="form-label">收款方式</text>
        <picker mode="selector" range="{{paymentMethods}}" value="{{paymentMethodIndex}}" bindchange="onPaymentMethodChange">
          <view class="picker">{{paymentMethods[paymentMethodIndex]}}</view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">备注</text>
        <textarea class="form-textarea" placeholder="请输入备注（选填）" value="{{collectNote}}" bindinput="onCollectNoteChange"></textarea>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="closeCollectModal">取消</button>
      <button class="btn btn-primary" bindtap="confirmCollect" loading="{{collectLoading}}">{{collectLoading ? '提交中...' : '确认收款'}}</button>
    </view>
  </view>
</view>
<view class="empty-state" wx:if="{{noOrder}}">
  <text class="empty-icon">📋</text>
  <text class="empty-text">订单不存在或未选择</text>
  <text class="empty-tip">请从订单列表进入</text>
</view>