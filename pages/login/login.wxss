/* 登录页面容器 - 渐变背景 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff 0%, var(--theme-primary-bg) 100%);
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-content {
  width: 100%;
  max-width: 750rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 品牌区域 */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: calc(44rpx * var(--font-scale));
  font-weight: 700;
  margin-bottom: 16rpx;
  box-shadow: 0 24rpx 64rpx rgba(7, 193, 96, 0.3);
}

.brand-name {
  font-size: calc(56rpx * var(--font-scale));
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.slogan {
  font-size: calc(28rpx * var(--font-scale));
  color: #888;
}

/* 首次管理员提示横幅 */
.first-admin-banner {
  width: 100%;
  max-width: 600rpx;
  margin: 0 0 32rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #FFF7E6, #FFF1D6);
  border: 2rpx solid #F5D99B;
  border-radius: 24rpx;
  font-size: calc(25rpx * var(--font-scale));
  color: #8B6914;
  line-height: 1.6;
  text-align: left;
}

.first-admin-banner b {
  color: #B8860B;
  font-weight: 700;
}

/* 邀请码输入 */
.invite-code-row {
  width: 100%;
  max-width: 600rpx;
  margin: 0 0 28rpx;
}
.invite-code-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 32rpx;
  border: 2rpx solid #DDE7E0;
  border-radius: 20rpx;
  background: #fff;
  font-size: calc(26rpx * var(--font-scale));
  color: #333;
  text-align: center;
}
.invite-placeholder {
  color: #B0B8B2;
}

/* 微信登录按钮 */
.wechat-login-btn {
  width: 100%;
  max-width: 600rpx;
  height: 96rpx;
  background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary));
  border: none;
  border-radius: 48rpx;
  color: #fff;
  font-size: calc(32rpx * var(--font-scale));
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.3);
}

.wechat-login-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 底部提示文字 */
.footer-text {
  margin-top: 32rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: #999;
  text-align: center;
  line-height: 1.6;
}

/* 响应式适配 */
@media screen and (max-width: 750rpx) {
  .login-container {
    padding: 32rpx 24rpx;
  }
  
  .logo {
    width: 150rpx;
    height: 150rpx;
    border-radius: 40rpx;
    font-size: calc(38rpx * var(--font-scale));
  }
  
  .brand-name {
    font-size: calc(48rpx * var(--font-scale));
  }
  
  .slogan {
    font-size: calc(24rpx * var(--font-scale));
  }
  
}

/* 小屏幕适配 */
@media screen and (max-width: 375px) {
  .login-container {
    padding: 24rpx 20rpx;
  }
  
  .logo {
    width: 130rpx;
    height: 130rpx;
    border-radius: 36rpx;
    font-size: calc(34rpx * var(--font-scale));
  }
  
  .brand-name {
    font-size: calc(42rpx * var(--font-scale));
  }
  
  .slogan {
    font-size: calc(22rpx * var(--font-scale));
  }
  
  .first-admin-banner {
    padding: 20rpx 24rpx;
    font-size: calc(23rpx * var(--font-scale));
  }
  
  .wechat-login-btn {
    height: 88rpx;
    font-size: calc(28rpx * var(--font-scale));
  }
  
  .footer-text {
    font-size: calc(22rpx * var(--font-scale));
  }
}
