/* 容器 */
.container {
  padding: 20rpx;
  background: #F5F6F8;
  min-height: 100vh;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 统计概览 */
.overview {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
}

.stat-label {
  font-size: calc(24rpx * var(--font-scale));
  color: #999999;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: bold;
  color: #333333;
}

/* 报表标签 */
.report-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: #ffffff;
  border-radius: 12rpx;
  font-size: calc(26rpx * var(--font-scale));
  color: #666666;
  transition: all 0.3s;
}

.tab.active {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #ffffff;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(6, 173, 86, 0.25);
}

/* 时间标签 */
.time-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.time-tab {
  flex: 1;
  padding: 14rpx 0;
  background: #ffffff;
  border-radius: 8rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: #666666;
  text-align: center;
  transition: all 0.3s;
}

.time-tab.active {
  background: var(--theme-primary);
  color: #ffffff;
}

/* 数据列表 */
.report-data {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.data-row {
  padding: 24rpx;
  transition: all 0.3s;
}

.data-row:active {
  transform: scale(0.98);
}

.data-main {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.data-name {
  font-size: calc(30rpx * var(--font-scale));
  font-weight: bold;
  color: #333333;
  margin-bottom: 4rpx;
}

.data-spec,
.data-region {
  font-size: calc(24rpx * var(--font-scale));
  color: #999999;
}

.data-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.data-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.data-stat .stat-label {
  font-size: calc(22rpx * var(--font-scale));
  color: #999999;
  margin-bottom: 4rpx;
}

.data-stat .stat-value {
  font-size: calc(26rpx * var(--font-scale));
  font-weight: bold;
  color: #333333;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: calc(120rpx * var(--font-scale));
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: calc(32rpx * var(--font-scale));
  color: #999999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: calc(24rpx * var(--font-scale));
  color: #cccccc;
}

/* 导出按钮 */
.export-btn {
  margin-top: 32rpx;
  padding: 24rpx 0;
  font-size: calc(28rpx * var(--font-scale));
  background: linear-gradient(135deg, #FF8A2B 0%, #ffa057 100%);
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 43, 0.25);
  transition: all 0.3s;
}

.export-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 颜色 */
.text-primary {
  color: var(--theme-primary);
}

.text-danger {
  color: #FF3B30;
}

.text-success {
  color: var(--theme-primary);
}

/* 响应式适配 */
@media screen and (max-width: 375px) {
  .overview {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .data-stats {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .stat-value {
    font-size: calc(24rpx * var(--font-scale));
  }
}

/* 区域筛选（对齐原型 rptRegion） */
.region-picker {
  margin: 0 24rpx 16rpx;
  padding: 18rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  font-size: calc(28rpx * var(--font-scale));
  color: #333;
}

/* 三个导出按钮 */
.export-buttons {
  padding: 0 24rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 自定义时间区间（与赊销页一致） */
.custom-date-range {
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.date-inputs { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.date-item { flex: 1; }
.date-label { display: block; font-size: calc(24rpx * var(--font-scale)); color: #666666; margin-bottom: 10rpx; }
.picker-date { padding: 16rpx; background: #F5F6F8; border-radius: 8rpx; font-size: calc(28rpx * var(--font-scale)); color: var(--theme-text); }
.date-actions { display: flex; justify-content: center; }
.btn-confirm { background: #1890FF; color: #FFFFFF; padding: 16rpx 48rpx; border-radius: 16rpx; font-size: calc(28rpx * var(--font-scale)); border: none; }
.btn-confirm[disabled] { background: #D9D9D9; color: #999999; }

/* ===== 汇总卡（对齐原型 .report-summary / .sum-card） ===== */
.report-summary {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}
.sum-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.sum-num {
  font-size: calc(40rpx * var(--font-scale));
  font-weight: 700;
}
.sum-num.green { color: var(--theme-primary, #07C160); }
.sum-num.orange { color: #FF8A2B; }
.sum-lbl {
  margin-top: 8rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--text-2, #999);
}
/* 导出按钮配色（对齐原型：主色 / 橙 / 紫） */
.export-buttons .export-btn,
.export-buttons .btn-primary {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 0;
  margin: 0;
  justify-content: center;
  border-radius: 48rpx;
  box-shadow: none;
}
.export-buttons .btn-primary {
  background: var(--theme-primary, #07C160);
}
.export-buttons .export-btn-orange { background: #FF7A1A; }
.export-buttons .export-btn-ledger { background: #534AB7; }
