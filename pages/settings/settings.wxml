<!-- 设置页面 -->
<view class="settings-wrap" style="{{uiStyle}}">

  <!-- 主题设置（所有角色可见） -->
  <view class="sec-card">
    <view class="sec-head">🎨 主题设置</view>
    <view class="sec-body">
      <view class="ag-step">点击主题卡片即可切换，支持基础色、卡通 IP、视觉风格、节日季节四大类。</view>
      
      <!-- 基础色主题 -->
      <view class="theme-category">
        <view class="category-title">🟢 基础色</view>
        <view class="theme-grid">
          <view class="theme-item {{currentTheme === 'green' ? 'active' : ''}}" bindtap="switchTheme" data-theme="green">
            <view class="theme-icon">{{themeIcons.green}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #06AD56 0%, #06c167 100%);"></view>
            <view class="theme-name">清新绿</view>
            <view class="theme-check {{currentTheme === 'green' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'blue' ? 'active' : ''}}" bindtap="switchTheme" data-theme="blue">
            <view class="theme-icon">{{themeIcons.blue}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);"></view>
            <view class="theme-name">商务蓝</view>
            <view class="theme-check {{currentTheme === 'blue' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'orange' ? 'active' : ''}}" bindtap="switchTheme" data-theme="orange">
            <view class="theme-icon">{{themeIcons.orange}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #FA8C16 0%, #FFC53D 100%);"></view>
            <view class="theme-name">活力橙</view>
            <view class="theme-check {{currentTheme === 'orange' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'purple' ? 'active' : ''}}" bindtap="switchTheme" data-theme="purple">
            <view class="theme-icon">{{themeIcons.purple}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #722ED1 0%, #9254DE 100%);"></view>
            <view class="theme-name">优雅紫</view>
            <view class="theme-check {{currentTheme === 'purple' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'dark' ? 'active' : ''}}" bindtap="switchTheme" data-theme="dark">
            <view class="theme-icon">{{themeIcons.dark}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #141414 0%, #1F1F1F 100%); border: 1px solid #333;"></view>
            <view class="theme-name">暗夜黑</view>
            <view class="theme-check {{currentTheme === 'dark' ? 'show' : ''}}">✓</view>
          </view>
        </view>
      </view>

      <!-- 卡通 IP 主题 -->
      <view class="theme-category">
        <view class="category-title">🐼 卡通 IP</view>
        <view class="theme-grid">
          <view class="theme-item {{currentTheme === 'panda' ? 'active' : ''}}" bindtap="switchTheme" data-theme="panda">
            <view class="theme-icon">{{themeIcons.panda}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #5C5C5C 0%, #808080 100%);"></view>
            <view class="theme-name">萌趣熊猫</view>
            <view class="theme-check {{currentTheme === 'panda' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'cat' ? 'active' : ''}}" bindtap="switchTheme" data-theme="cat">
            <view class="theme-icon">{{themeIcons.cat}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #FF9A9E 0%, #FFB4B8 100%);"></view>
            <view class="theme-name">暖心猫咪</view>
            <view class="theme-check {{currentTheme === 'cat' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'dog' ? 'active' : ''}}" bindtap="switchTheme" data-theme="dog">
            <view class="theme-icon">{{themeIcons.dog}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #F6D365 0%, #F8DA7E 100%);"></view>
            <view class="theme-name">活泼小狗</view>
            <view class="theme-check {{currentTheme === 'dog' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'fox' ? 'active' : ''}}" bindtap="switchTheme" data-theme="fox">
            <view class="theme-icon">{{themeIcons.fox}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #FF6B6B 0%, #FF8585 100%);"></view>
            <view class="theme-name">灵动小狐</view>
            <view class="theme-check {{currentTheme === 'fox' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'bear' ? 'active' : ''}}" bindtap="switchTheme" data-theme="bear">
            <view class="theme-icon">{{themeIcons.bear}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #A07855 0%, #B89270 100%);"></view>
            <view class="theme-name">憨厚小熊</view>
            <view class="theme-check {{currentTheme === 'bear' ? 'show' : ''}}">✓</view>
          </view>
        </view>
      </view>

      <!-- 视觉风格主题 -->
      <view class="theme-category">
        <view class="category-title">✨ 视觉风格</view>
        <view class="theme-grid">
          <view class="theme-item {{currentTheme === 'glass' ? 'active' : ''}}" bindtap="switchTheme" data-theme="glass">
            <view class="theme-icon">{{themeIcons.glass}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></view>
            <view class="theme-name">毛玻璃</view>
            <view class="theme-check {{currentTheme === 'glass' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'rounded' ? 'active' : ''}}" bindtap="switchTheme" data-theme="rounded">
            <view class="theme-icon">{{themeIcons.rounded}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);"></view>
            <view class="theme-name">圆角卡片</view>
            <view class="theme-check {{currentTheme === 'rounded' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'gradient' ? 'active' : ''}}" bindtap="switchTheme" data-theme="gradient">
            <view class="theme-icon">{{themeIcons.gradient}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);"></view>
            <view class="theme-name">渐变流光</view>
            <view class="theme-check {{currentTheme === 'gradient' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'minimal' ? 'active' : ''}}" bindtap="switchTheme" data-theme="minimal">
            <view class="theme-icon">{{themeIcons.minimal}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #000000 0%, #333333 100%);"></view>
            <view class="theme-name">极简黑白</view>
            <view class="theme-check {{currentTheme === 'minimal' ? 'show' : ''}}">✓</view>
          </view>
        </view>
      </view>

      <!-- 节日季节主题 -->
      <view class="theme-category">
        <view class="category-title">🎄 节日季节</view>
        <view class="theme-grid">
          <view class="theme-item {{currentTheme === 'christmas' ? 'active' : ''}}" bindtap="switchTheme" data-theme="christmas">
            <view class="theme-icon">{{themeIcons.christmas}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #C41E3A 0%, #228B22 100%);"></view>
            <view class="theme-name">圣诞欢乐</view>
            <view class="theme-check {{currentTheme === 'christmas' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'newyear' ? 'active' : ''}}" bindtap="switchTheme" data-theme="newyear">
            <view class="theme-icon">{{themeIcons.newyear}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #D90429 0%, #FFD700 100%);"></view>
            <view class="theme-name">新春喜庆</view>
            <view class="theme-check {{currentTheme === 'newyear' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'spring' ? 'active' : ''}}" bindtap="switchTheme" data-theme="spring">
            <view class="theme-icon">{{themeIcons.spring}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #FF69B4 0%, #90EE90 100%);"></view>
            <view class="theme-name">春日清新</view>
            <view class="theme-check {{currentTheme === 'spring' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'summer' ? 'active' : ''}}" bindtap="switchTheme" data-theme="summer">
            <view class="theme-icon">{{themeIcons.summer}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #00B4D8 0%, #FFD166 100%);"></view>
            <view class="theme-name">夏日清凉</view>
            <view class="theme-check {{currentTheme === 'summer' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'autumn' ? 'active' : ''}}" bindtap="switchTheme" data-theme="autumn">
            <view class="theme-icon">{{themeIcons.autumn}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #D2691E 0%, #DAA520 100%);"></view>
            <view class="theme-name">秋日温暖</view>
            <view class="theme-check {{currentTheme === 'autumn' ? 'show' : ''}}">✓</view>
          </view>
          <view class="theme-item {{currentTheme === 'winter' ? 'active' : ''}}" bindtap="switchTheme" data-theme="winter">
            <view class="theme-icon">{{themeIcons.winter}}</view>
            <view class="theme-preview" style="background: linear-gradient(135deg, #4A90A4 0%, #B8D4E3 100%);"></view>
            <view class="theme-name">冬日纯净</view>
            <view class="theme-check {{currentTheme === 'winter' ? 'show' : ''}}">✓</view>
          </view>
        </view>
      </view>

    </view>
  </view>

  <!-- 管理员专属配置 -->
  <view class="sec-card" wx:if="{{userRole === 'admin'}}">
    <view class="sec-head">🎙️ 阿里语音（ASR）配置</view>
    <view class="sec-body">
      <view class="ag-step">智能录入的「语音转文字」依赖阿里云智能语音交互（ISI）。未配置或未启用时，语音录入不可用，但文字录入仍正常。密钥仅保存在云端，不会泄露到前端。</view>
      <view class="mf-row">
        <text class="mf-label">启用语音识别</text>
        <picker mode="selector" range="{{['停用','启用']}}" value="{{aliyunEnabled}}" bindchange="onAliyunEnabled">
          <view class="picker-val">{{aliyunEnabled === '1' ? '启用' : '停用'}}</view>
        </picker>
      </view>
      <view class="mf-row">
        <text class="mf-label">AccessKeyId</text>
        <input value="{{aliyunAk}}" bindinput="onAliyunAk" placeholder="阿里云 AccessKeyId" />
      </view>
      <view class="mf-row">
        <text class="mf-label">AccessKeySecret</text>
        <input password value="{{aliyunSk}}" bindinput="onAliyunSk" placeholder="阿里云 AccessKeySecret" />
      </view>
      <view class="mf-row">
        <text class="mf-label">AppKey</text>
        <input value="{{aliyunAppKey}}" bindinput="onAliyunAppKey" placeholder="智能语音交互项目 AppKey" />
      </view>
      <view class="mf-row">
        <text class="mf-label">服务地域</text>
        <picker mode="selector" range="{{['cn-shanghai','cn-beijing','cn-hangzhou']}}" value="{{aliyunRegionIndex}}" bindchange="onAliyunRegion">
          <view class="picker-val">{{aliyunRegion}}</view>
        </picker>
      </view>
      <view class="mf-row">
        <text class="mf-label">识别模型</text>
        <picker mode="selector" range="{{['通用（16K，麦克风录音）','电话（8K）']}}" value="{{aliyunModelIndex}}" bindchange="onAliyunModel">
          <view class="picker-val">{{aliyunModel === 'telephone' ? '电话（8K）' : '通用（16K，麦克风录音）'}}</view>
        </picker>
      </view>
      <button class="btn-primary" bindtap="saveAliyun">💾 保存阿里语音配置</button>
    </view>
  </view>

  <view class="sec-card" wx:if="{{userRole === 'admin'}}">
    <view class="sec-head">🧠 通义千问（NLP）配置</view>
    <view class="sec-body">
      <view class="ag-step">智能录入的「复杂语义理解」可接入通义千问（DashScope），用于规则引擎未命中的口语化/复杂表达。未配置或未启用时，自动降级为纯规则引擎（文字匹配仍可用）。</view>
      <view class="mf-row">
        <text class="mf-label">启用千问 NLP</text>
        <picker mode="selector" range="{{['停用','启用']}}" value="{{qwenEnabled}}" bindchange="onQwenEnabled">
          <view class="picker-val">{{qwenEnabled === '1' ? '启用' : '停用'}}</view>
        </picker>
      </view>
      <view class="mf-row">
        <text class="mf-label">API Key</text>
        <input password value="{{qwenKey}}" bindinput="onQwenKey" placeholder="DashScope API Key（sk-开头）" />
      </view>
      <view class="mf-row">
        <text class="mf-label">模型</text>
        <picker mode="selector" range="{{['qwen-turbo','qwen-plus','qwen-max']}}" value="{{qwenModelIndex}}" bindchange="onQwenModel">
          <view class="picker-val">{{qwenModel}}</view>
        </picker>
      </view>
      <button class="btn-primary" bindtap="saveQwen">💾 保存千问配置</button>
    </view>
  </view>

  <view class="sec-card" wx:if="{{userRole === 'admin'}}">
    <view class="sec-head">🖨️ 打印机配置</view>
    <view class="sec-body">
      <view class="mf-row">
        <text class="mf-label">打印机品牌</text>
        <picker mode="selector" range="{{['芯烨（Xprinter）','佳博（Gprinter）','汉印（HPRT）']}}" value="{{printerBrandIndex}}" bindchange="onPrinterBrand">
          <view class="picker-val">{{printerBrandText}}</view>
        </picker>
      </view>
      <view class="mf-row">
        <text class="mf-label">打印纸宽</text>
        <picker mode="selector" range="{{['58mm（便携）','80mm']}}" value="{{printerWidthIndex}}" bindchange="onPrinterWidth">
          <view class="picker-val">{{printerWidth === '80' ? '80mm' : '58mm（便携）'}}</view>
        </picker>
      </view>
      <button class="btn-primary" bindtap="savePrinter">💾 保存打印机配置</button>
    </view>
  </view>

  <view class="sec-card">
    <view class="sec-head">💾 数据备份</view>
    <view class="sec-body">
      <view class="ag-step">云开发平台每日自动备份数据库，无需手动操作。如需手动导出，请前往「微信开发者工具 → 云开发控制台 → 数据库」操作。</view>
    </view>
  </view>

</view>
