<!-- 设置页面 -->
<view class="settings-wrap" style="{{uiStyle}}">

  <!-- 管理员专属配置 -->
  <view class="sec-card" wx:if="{{userRole === 'admin'}}">
    <view class="sec-head">🎙️ 腾讯云语音（ASR）配置 <text class="hint-txt">语音转文字</text></view>
    <view class="sec-body">
      <view class="ag-step">智能录入的「语音转文字」依赖腾讯云语音识别（录音文件识别，需先在腾讯云控制台开通）。未配置或未启用时，语音录入不可用，但文字录入仍正常。密钥仅保存在云端，不会泄露到前端。</view>
      <view class="mf-row">
        <text class="mf-label">启用语音识别</text>
        <picker mode="selector" range="{{['停用','启用']}}" value="{{tencentEnabled}}" bindchange="onTencentEnabled">
          <view class="picker-val">{{tencentEnabled === '1' ? '启用' : '停用'}}</view>
        </picker>
      </view>
      <view class="mf-row">
        <text class="mf-label">SecretId</text>
        <input value="{{tencentSid}}" bindinput="onTencentSid" placeholder="腾讯云 SecretId（主账号或已授权 ASR 的子账号）" />
      </view>
      <view class="mf-row">
        <text class="mf-label">SecretKey</text>
        <input password value="{{tencentSkey}}" bindinput="onTencentSkey" placeholder="腾讯云 SecretKey" />
      </view>
      <view class="mf-row">
        <text class="mf-label">识别引擎</text>
        <picker mode="selector" range="{{['通用 16K（麦克风录音）','电话 8K']}}" value="{{tencentEngineIndex}}" bindchange="onTencentEngine">
          <view class="picker-val">{{tencentEngine === '8k_zh' ? '电话 8K' : '通用 16K（麦克风录音）'}}</view>
        </picker>
      </view>
      <button class="btn-primary" bindtap="saveTencent">💾 保存腾讯云配置（语音）</button>
    </view>
  </view>

  <view class="sec-card" wx:if="{{userRole === 'admin'}}">
    <view class="sec-head">🧠 TokenHub 大模型（NLP）配置 <text class="hint-txt">复杂语义理解</text></view>
    <view class="sec-body">
      <view class="ag-step">智能录入的「复杂语义理解」接入腾讯云 TokenHub 大模型（OpenAI 兼容接口，与语音识别密钥独立），用于规则引擎未命中的口语化/复杂表达。23 个免费额度模型可切换，默认 hy3（100万 tokens/年）。未启用或未配置时，自动降级为规则引擎（文字匹配仍可用）。密钥仅保存在云端，不会泄露到前端。</view>
      <view class="mf-row">
        <text class="mf-label">启用 TokenHub NLP</text>
        <picker mode="selector" range="{{['停用','启用']}}" value="{{nlpEnabled}}" bindchange="onNlpEnabled">
          <view class="picker-val">{{nlpEnabled === '1' ? '启用' : '停用'}}</view>
        </picker>
      </view>
      <view class="mf-row">
        <text class="mf-label">模型</text>
        <picker mode="selector" range="{{nlpModels}}" value="{{nlpModelIndex}}" bindchange="onNlpModel">
          <view class="picker-val">{{nlpModel}}</view>
        </picker>
      </view>
      <view class="mf-row">
        <text class="mf-label">API Key</text>
        <input password value="{{tokenhubKey}}" bindinput="onTokenhubKey" placeholder="TokenHub API Key（sk-开头，23 个模型通用）" />
      </view>
      <button class="btn-primary" bindtap="saveTokenhub">💾 保存 TokenHub 配置</button>
    </view>
  </view>

  <view class="sec-card" wx:if="{{userRole === 'admin'}}">
    <view class="sec-head">🔌 中转站 AI（OpenAI 兼容）配置 <text class="hint-txt">语义理解</text></view>
    <view class="sec-body">
      <view class="ag-step">智能录入的「复杂语义理解」也可接入 OpenAI 兼容中转站接口（如 qiyuanapi），与 TokenHub 并存互为降级。未配置或未启用时自动使用本地规则引擎。</view>
      <view class="mf-row">
        <text class="mf-label">启用中转站 AI</text>
        <picker mode="selector" range="{{['停用','启用']}}" value="{{relayEnabled}}" bindchange="onRelayEnabled">
          <view class="picker-val">{{relayEnabled === '1' ? '启用' : '停用'}}</view>
        </picker>
      </view>
      <view class="mf-row">
        <text class="mf-label">接口地址</text>
        <input value="{{relayBaseUrl}}" bindinput="onRelayBaseUrl" placeholder="https://api.example.com/v1" />
      </view>
      <view class="mf-row">
        <text class="mf-label">API Key</text>
        <input password value="{{relayKey}}" bindinput="onRelayKey" placeholder="中转站 API Key" />
      </view>
      <view class="mf-row">
        <text class="mf-label">模型名</text>
        <input value="{{relayModel}}" bindinput="onRelayModel" placeholder="如 qwen-0810 / gpt-4o" />
      </view>
      <button class="btn-primary" bindtap="saveRelay">💾 保存中转站 AI 配置</button>
    </view>
  </view>

  <view class="sec-card">
    <view class="sec-head">🖨️ 打印机配置 <text class="hint-txt">蓝牙打印</text></view>
    <view class="sec-body">
      <view class="mf-row">
        <text class="mf-label">打印机品牌</text>
        <picker mode="selector" range="{{['芯烨（Xprinter）','佳博（Gprinter）','汉印（HPRT）']}}" value="{{printerBrandIndex}}" bindchange="onPrinterBrand">
          <view class="picker-val">{{['芯烨（Xprinter）','佳博（Gprinter）','汉印（HPRT）'][printerBrandIndex]}}</view>
        </picker>
      </view>
      <view class="mf-row">
        <text class="mf-label">打印纸宽</text>
        <picker mode="selector" range="{{['58mm（便携）','80mm']}}" value="{{printerWidthIndex}}" bindchange="onPrinterWidth">
          <view class="picker-val">{{['58mm（便携）','80mm'][printerWidthIndex]}}</view>
        </picker>
      </view>
      <button class="btn-primary" bindtap="savePrinter">💾 保存打印机配置</button>
    </view>
  </view>
  <view class="sec-card">
    <view class="sec-head">💾 数据备份 <text class="hint-txt">云开发自动备份</text></view>
    <view class="sec-body">
      <view class="ag-step">云开发平台每日自动备份数据库，无需手动操作。如需手动导出，请前往「微信开发者工具 → 云开发控制台 → 数据库」操作。</view>
    </view>
  </view>

  <view class="sec-card" id="sec-timer" wx:if="{{userRole === 'admin'}}">
    <view class="sec-head">⏰ 定时自动确认（分拣 / 出库）</view>
    <view class="sec-body">
      <view class="ag-step">开启后，每天到点自动把「未人工确认」的分拣、出库订单批量确认，避免隔夜订单堆积。关闭 = 不限时，纯人工确认。超时未确认的订单会在分拣员 / 库管工作台标红提醒。</view>
      <view class="mf-row">
        <text class="mf-label">定时确认开关</text>
        <picker mode="selector" range="{{['不限时（关闭）','开启']}}" value="{{acEnabled}}" bindchange="onAcEnabled">
          <view class="picker-val">{{acEnabled === '1' ? '开启' : '不限时（关闭）'}}</view>
        </picker>
      </view>
      <view class="mf-row" wx:if="{{acEnabled === '1'}}">
        <text class="mf-label">每日到点时间</text>
        <picker mode="time" value="{{acTime}}" bindchange="onAcTime">
          <view class="picker-val">{{acTime}}</view>
        </picker>
      </view>
      <button class="btn-primary" bindtap="saveAutoConfirm">💾 保存定时确认配置</button>
    </view>
  </view>

</view>
