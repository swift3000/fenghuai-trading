/* 系统设置页样式 */
.settings-wrap {
  padding: 12px;
  background: #f5f6f8;
  min-height: 100vh;
}

.sec-card {
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  margin-bottom: 14px;
  overflow: hidden;
}

.sec-head {
  padding: 14px 16px;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #f0f0f0;
}

.sec-body {
  padding: 12px 16px;
}

.ag-step {
  font-size: 12px;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12px;
  background: #f8f9fa;
  padding: 10px 12px;
  border-radius: 8px;
}

.mf-row {
  margin-bottom: 14px;
}

.mf-label {
  display: block;
  font-size: 13px;
  color: #666;
  margin-bottom: 6px;
}

.mf-row input {
  width: 100%;
  box-sizing: border-box;
  padding: 10px 12px;
  border: 1px solid #e5e5e5;
  border-radius: 9px;
  font-size: 14px;
  background: #fff;
}

.picker-val {
  width: 100%;
  box-sizing: border-box;
  padding: 10px 12px;
  border: 1px solid #e5e5e5;
  border-radius: 9px;
  font-size: 14px;
  background: #fff;
  color: #333;
}

.btn-primary {
  width: 100%;
  height: 42px;
  border: none;
  border-radius: 10px;
  background: #06ad56;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  margin-top: 4px;
}

.btn-primary::after {
  border: none;
}
