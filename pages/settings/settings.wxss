/* 设置页面基础样式 */
.settings-wrap {
  padding: 20rpx;
  background-color: var(--theme-bg);
  min-height: 100vh;
}

.sec-card {
  background: var(--theme-card);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.sec-head {
  padding: 24rpx 28rpx;
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 600;
  color: var(--theme-text);
  border-bottom: 1rpx solid var(--theme-border);
  background: linear-gradient(135deg, var(--theme-card) 0%, var(--theme-bg) 100%);
}
.sec-head .hint-txt {
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 400;
  color: var(--theme-subtext, #999);
  margin-left: 8rpx;
}

.sec-body {
  padding: 24rpx;
}

.ag-step {
  font-size: calc(26rpx * var(--font-scale));
  color: var(--theme-text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: var(--theme-bg);
  border-radius: 8rpx;
}

/* 表单行 */
.mf-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--theme-border);
}

.mf-row:last-child {
  border-bottom: none;
}

.mf-label {
  font-size: calc(28rpx * var(--font-scale));
  color: var(--theme-text);
}

.picker-val {
  font-size: calc(28rpx * var(--font-scale));
  color: var(--theme-primary);
  font-weight: 500;
}

input {
  font-size: calc(28rpx * var(--font-scale));
  color: var(--theme-text);
  padding: 12rpx;
  background: var(--theme-bg);
  border-radius: 8rpx;
  border: 1rpx solid var(--theme-border);
  width: 200rpx;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: calc(30rpx * var(--font-scale));
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  border: none;
  margin-top: 20rpx;
}

.btn-danger {
  background: #ff4d4f;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: calc(30rpx * var(--font-scale));
  border: none;
}

/* 非管理员提示 */
.admin-only-tip {
  padding: 40rpx;
  text-align: center;
  background: var(--theme-card);
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.tip-text {
  color: var(--theme-text-secondary);
  font-size: calc(26rpx * var(--font-scale));
}
