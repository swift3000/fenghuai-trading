.customer-bar {
  padding: 24rpx;
  font-size: 30rpx;
}

.smart-input-btn {
  background: #e8f0fe;
  color: #1a73e8;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  text-align: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
}

.add-btn {
  color: #1a73e8;
  font-size: 28rpx;
}

.item-row {
  padding: 20rpx 24rpx;
}

.item-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.total-bar {
  padding: 24rpx;
  margin-top: 20rpx;
}

.total-label {
  font-size: 30rpx;
  font-weight: bold;
}

.total-amount {
  font-size: 36rpx;
  color: #1a73e8;
  font-weight: bold;
}

.save-btn {
  margin-top: 30rpx;
  margin-bottom: 40rpx;
}
