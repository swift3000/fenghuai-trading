.customer-bar {
  padding: 24rpx;
  font-size: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(6, 173, 86, 0.08);
}

.smart-input-btn {
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  color: #06AD56;
  padding: 18rpx 28rpx;
  border-radius: 12rpx;
  text-align: center;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 1rpx solid rgba(6, 173, 86, 0.2);
  transition: all 0.3s;
}

.smart-input-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.section-header {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  background: linear-gradient(180deg, #06AD56 0%, #06c167 100%);
  border-radius: 3rpx;
}

.add-btn {
  color: #06AD56;
  font-size: 28rpx;
  font-weight: 500;
  padding: 8rpx 16rpx;
  border: 1rpx solid #06AD56;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.add-btn:active {
  background: #f9fdfa;
  opacity: 0.7;
}

.item-row {
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(6, 173, 86, 0.08);
  transition: all 0.3s;
}

.item-row:active {
  transform: scale(0.99);
  box-shadow: 0 4rpx 16rpx rgba(6, 173, 86, 0.1);
}

.item-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 28rpx;
  background: #fafafa;
  border-radius: 16rpx;
  border: 1rpx dashed #e0e0e0;
}

.total-bar {
  padding: 28rpx;
  margin-top: 24rpx;
  background: linear-gradient(135deg, #06AD56 0%, #06c167 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(6, 173, 86, 0.2);
  margin-bottom: 24rpx;
}

.total-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.total-amount {
  font-size: 44rpx;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.save-btn {
  margin-top: 30rpx;
  margin-bottom: 40rpx;
  background: linear-gradient(135deg, #06AD56 0%, #06c167 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(6, 173, 86, 0.3);
  transition: all 0.3s;
}

.save-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(6, 173, 86, 0.2);
}

/* 数量输入框 */
.qty-input {
  width: 100rpx;
  height: 50rpx;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
  text-align: center;
  font-size: 24rpx;
  margin: 0 10rpx;
}

/* 弹窗通用样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

.modal-content {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 80%;
  background: #fff;
  border-radius: 16rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.customer-modal {
  max-height: 70vh;
}

.product-modal {
  max-height: 70vh;
}

.smart-input-modal {
  max-height: 80vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  padding: 0 8rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #eee;
}

.modal-footer .btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
}

.modal-footer .btn-cancel {
  background: #f7f7f7;
  color: #666;
}

.modal-footer .btn-primary {
  background: linear-gradient(135deg, #06AD56 0%, #06c167 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(6, 173, 86, 0.25);
}

/* 客户列表 */
.search-bar {
  padding: 16rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.search-bar input {
  height: 60rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.customer-list {
  height: 400rpx;
}

.customer-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.2s;
}

.customer-item:active {
  background: #f9fdfa;
}

.customer-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.customer-contact {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.selected-tag {
  color: #06AD56;
  font-size: 32rpx;
  font-weight: bold;
}

/* 商品列表 */
.product-list {
  height: 400rpx;
}

.product-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.2s;
}

.product-item:active {
  background: #f9fdfa;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 智能录入 textarea */
.smart-textarea {
  width: 100%;
  height: 400rpx;
  padding: 20rpx 24rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.6;
}


/* ===== 商品行卡片（件/包双轨 + 改价） ===== */
.prow-card { padding: 24rpx; }
.prow-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx; }
.pname-box { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.pname { font-size: 30rpx; font-weight: bold; color: #333; }
.pspec { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.pmode-tag { font-size: 20rpx; color: #06AD56; background: #e8f5e9; border-radius: 6rpx; padding: 2rpx 10rpx; }
.badge-adjust { font-size: 20rpx; color: #E67E22; background: #fef3e7; border-radius: 6rpx; padding: 2rpx 10rpx; }
.badge-prefill { font-size: 20rpx; color: #888; background: #f0f0f0; border-radius: 6rpx; padding: 2rpx 10rpx; }
.del-btn { color: #ccc; font-size: 30rpx; padding: 8rpx; }

/* 数量双轨 */
.qty-group { display: flex; gap: 20rpx; margin: 12rpx 0 4rpx; }
.qty-box { flex: 1; }
.qty-label { font-size: 22rpx; color: #888; margin-bottom: 8rpx; }
.qty-stepper { display: flex; align-items: center; gap: 8rpx; }
.step-btn { width: 64rpx; height: 64rpx; border-radius: 10rpx; background: #f5f5f5; color: #333; font-size: 36rpx; line-height: 64rpx; text-align: center; flex-shrink: 0; }
.qty-input { flex: 1; height: 64rpx; border: 2rpx solid #e0e0e0; border-radius: 10rpx; text-align: center; font-size: 34rpx; font-weight: 600; color: #333; }

/* 价格（下单内改价） */
.price-group { display: flex; gap: 20rpx; margin: 10rpx 0; }
.price-box { flex: 1; }
.price-label { font-size: 22rpx; color: #888; margin-bottom: 8rpx; }
.price-input { height: 64rpx; border: 2rpx solid #e0e0e0; border-radius: 10rpx; padding: 0 12rpx; text-align: center; font-size: 30rpx; font-weight: 600; color: #06AD56; width: 100%; box-sizing: border-box; }

/* 备注 */
.remark-row { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.remark-label { font-size: 24rpx; color: #666; white-space: nowrap; }
.remark-input { flex: 1; height: 56rpx; border: 2rpx solid #e0e0e0; border-radius: 10rpx; padding: 0 16rpx; font-size: 26rpx; }

/* 小计 */
.prow-total { display: flex; justify-content: space-between; align-items: center; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx dashed #eee; }
.row-subtotal-label { font-size: 24rpx; color: #666; }
.row-subtotal { font-size: 34rpx; font-weight: bold; color: #FF3B30; }
