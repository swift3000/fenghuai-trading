.customer-bar {
  padding: 24rpx;
  font-size: calc(30rpx * var(--font-scale));
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(6, 173, 86, 0.08);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.customer-bar-info {
  flex: 1;
  min-width: 0;
}

.customer-bar-name {
  display: block;
  font-size: calc(32rpx * var(--font-scale));
  font-weight: 700;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-bar-region {
  display: block;
  margin-top: 6rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: #8a94a6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-bar-arrow {
  flex-shrink: 0;
  font-size: calc(36rpx * var(--font-scale));
  color: #c3cad6;
}

.customer-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.customer-bar-info {
  flex: 1;
  min-width: 0;
}

.customer-bar-name {
  display: block;
  font-size: calc(32rpx * var(--font-scale));
  font-weight: 700;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-bar-region {
  display: block;
  margin-top: 6rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: #8a94a6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-bar-arrow {
  flex-shrink: 0;
  font-size: calc(36rpx * var(--font-scale));
  color: #c3cad6;
}

.smart-input-btn {
  background: linear-gradient(135deg, var(--theme-primary-bg) 0%, var(--theme-primary-bg) 100%);
  color: var(--theme-primary);
  padding: 18rpx 28rpx;
  border-radius: 12rpx;
  text-align: center;
  margin-bottom: 24rpx;
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 500;
  border: 1rpx solid rgba(6, 173, 86, 0.2);
  transition: all 0.3s;
}

.smart-input-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.section-header {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: calc(30rpx * var(--font-scale));
  font-weight: bold;
  color: #333;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  background: linear-gradient(180deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  border-radius: 3rpx;
}

.add-btn {
  color: var(--theme-primary);
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 500;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--theme-primary);
  border-radius: 8rpx;
  transition: all 0.3s;
}

.add-btn:active {
  background: var(--theme-primary-bg);
  opacity: 0.7;
}

.item-row {
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(6, 173, 86, 0.08);
  transition: all 0.3s;
}

.item-row:active {
  transform: scale(0.99);
  box-shadow: 0 4rpx 16rpx rgba(6, 173, 86, 0.1);
}

.item-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: #999999;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: calc(28rpx * var(--font-scale));
  background: #fafafa;
  border-radius: 16rpx;
  border: 1rpx dashed #e0e0e0;
}

.total-bar {
  padding: 28rpx;
  margin-top: 24rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(6, 173, 86, 0.2);
  margin-bottom: 24rpx;
}

.total-label {
  font-size: calc(30rpx * var(--font-scale));
  font-weight: bold;
  color: #fff;
}

.total-amount {
  font-size: calc(44rpx * var(--font-scale));
  color: #fff;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.save-btn {
  margin-top: 30rpx;
  margin-bottom: 40rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  height: 96rpx;
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(6, 173, 86, 0.3);
  transition: all 0.3s;
}

.save-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(6, 173, 86, 0.2);
}

/* 数量输入框 */
.qty-input {
  width: 100rpx;
  height: 50rpx;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
  text-align: center;
  font-size: calc(24rpx * var(--font-scale));
  margin: 0 10rpx;
}

/* 弹窗通用样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

.modal-content {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 80%;
  background: #fff;
  border-radius: 16rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.customer-modal {
  max-height: 70vh;
}

.product-modal {
  max-height: 70vh;
}

.smart-input-modal {
  max-height: 80vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: calc(48rpx * var(--font-scale));
  color: #999;
  line-height: 1;
  padding: 0 8rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #eee;
}

.modal-footer .btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 8rpx;
  font-size: calc(28rpx * var(--font-scale));
  text-align: center;
  border: none;
}

.modal-footer .btn-cancel {
  background: #f7f7f7;
  color: #666;
}

.modal-footer .btn-primary {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(6, 173, 86, 0.25);
}

/* 客户列表 */
.search-bar {
  padding: 16rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.search-bar input {
  height: 60rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: calc(26rpx * var(--font-scale));
}

.customer-list {
  height: 400rpx;
}

.customer-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.2s;
}

.customer-item:active {
  background: var(--theme-primary-bg);
}

.customer-name {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 500;
  color: #333;
}

.customer-contact {
  font-size: calc(24rpx * var(--font-scale));
  color: #999;
  margin-top: 8rpx;
}

.selected-tag {
  color: var(--theme-primary);
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
}

/* 商品列表 */
.product-list {
  height: 400rpx;
}

.product-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.2s;
}

.product-item:active {
  background: var(--theme-primary-bg);
}

.product-name {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 500;
  color: #333;
}

.product-spec {
  font-size: calc(24rpx * var(--font-scale));
  color: #999;
  margin-top: 8rpx;
}

/* 智能录入 textarea */
.smart-textarea {
  width: 100%;
  height: 400rpx;
  padding: 20rpx 24rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  font-size: calc(28rpx * var(--font-scale));
  box-sizing: border-box;
  line-height: 1.6;
}


/* ===== 商品行卡片（件/包双轨 + 改价） ===== */
.prow-card { padding: 24rpx; }
.prow-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx; }
.pname-box { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.pname { font-size: calc(30rpx * var(--font-scale)); font-weight: bold; color: #333; }
.pspec { font-size: calc(22rpx * var(--font-scale)); color: #999; margin-top: 6rpx; }
.pmode-tag { font-size: calc(20rpx * var(--font-scale)); color: var(--theme-primary); background: var(--theme-primary-bg); border-radius: 6rpx; padding: 2rpx 10rpx; }
.badge-adjust { font-size: calc(20rpx * var(--font-scale)); color: #E67E22; background: #fef3e7; border-radius: 6rpx; padding: 2rpx 10rpx; }
.badge-prefill { font-size: calc(20rpx * var(--font-scale)); color: #888; background: #f0f0f0; border-radius: 6rpx; padding: 2rpx 10rpx; }
.del-btn { color: #ccc; font-size: calc(30rpx * var(--font-scale)); padding: 8rpx; }

/* 数量双轨 */
.qty-group { display: flex; gap: 20rpx; margin: 12rpx 0 4rpx; }
.qty-box { flex: 1; }
.qty-label { font-size: calc(22rpx * var(--font-scale)); color: #888; margin-bottom: 8rpx; }
.qty-stepper { display: flex; align-items: center; gap: 8rpx; }
.step-btn { width: 64rpx; height: 64rpx; border-radius: 10rpx; background: #f5f5f5; color: #333; font-size: calc(36rpx * var(--font-scale)); line-height: 64rpx; text-align: center; flex-shrink: 0; }
.qty-input { flex: 1; height: 64rpx; border: 2rpx solid #e0e0e0; border-radius: 10rpx; text-align: center; font-size: calc(34rpx * var(--font-scale)); font-weight: 600; color: #333; }

/* 价格（下单内改价） */
.price-group { display: flex; gap: 20rpx; margin: 10rpx 0; }
.price-box { flex: 1; }
.price-label { font-size: calc(22rpx * var(--font-scale)); color: #888; margin-bottom: 8rpx; }
.price-input { height: 64rpx; border: 2rpx solid #e0e0e0; border-radius: 10rpx; padding: 0 12rpx; text-align: center; font-size: calc(30rpx * var(--font-scale)); font-weight: 600; color: var(--theme-primary); width: 100%; box-sizing: border-box; }

/* 备注 */
.remark-row { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.remark-label { font-size: calc(24rpx * var(--font-scale)); color: #666; white-space: nowrap; }
.remark-input { flex: 1; height: 56rpx; border: 2rpx solid #e0e0e0; border-radius: 10rpx; padding: 0 16rpx; font-size: calc(26rpx * var(--font-scale)); }

/* 小计 */
.prow-total { display: flex; justify-content: space-between; align-items: center; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx dashed #eee; }
.row-subtotal-label { font-size: calc(24rpx * var(--font-scale)); color: #666; }
.row-subtotal { font-size: calc(34rpx * var(--font-scale)); font-weight: bold; color: #FF3B30; }

/* 语音录入提示样式 */
.smart-voice-notice {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  border: 2rpx dashed #3b82f6;
}

.smart-voice-notice .notice-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.smart-voice-notice .notice-text {
  font-size: 28rpx;
  color: #2563eb;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.smart-voice-notice .notice-sub {
  font-size: 24rpx;
  color: #6b7280;
}

.smart-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
  color: #9ca3af;
  font-size: 24rpx;
}

.smart-divider::before,
.smart-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #e5e7eb;
  margin: 0 20rpx;
}
