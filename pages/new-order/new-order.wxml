<view class="container">
  <view class="customer-bar card" bindtap="selectCustomer">
    <text wx:if="{{customer}}">{{customer.name}}</text>
    <text wx:else class="text-muted">点击选择客户</text>
  </view>

  <view class="smart-input-btn" bindtap="openSmartInput">
    <text>🗣 智能录入</text>
  </view>

  <view class="items-section">
    <view class="section-header flex-between">
      <text class="section-title">商品明细</text>
      <text class="add-btn" bindtap="addProduct">+ 添加商品</text>
    </view>

    <view class="item-row card" wx:for="{{items}}" wx:key="index">
      <view class="flex-between">
        <text>{{item.name}}</text>
        <text class="text-danger" data-index="{{index}}" bindtap="removeItem">删除</text>
      </view>
      <view class="item-meta">
        <text>{{item.spec}}</text>
        <text>数量：{{item.qty}}</text>
        <text>单价：¥{{item.price}}</text>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{!items.length}}">
      <text>点击"添加商品"或"智能录入"开始</text>
    </view>
  </view>

  <view class="total-bar card">
    <view class="flex-between">
      <text class="total-label">合计</text>
      <text class="total-amount">¥{{totalAmount}}</text>
    </view>
  </view>

  <button class="btn-primary save-btn" bindtap="saveOrder">保存订单</button>

  <!-- 客户选择弹窗 -->
  <view class="modal-mask" wx:if="{{showCustomerModal}}" bindtap="closeCustomerModal"></view>
  <view class="modal-content customer-modal" wx:if="{{showCustomerModal}}">
    <view class="modal-header">
      <text class="modal-title">选择客户</text>
      <text class="modal-close" bindtap="closeCustomerModal">×</text>
    </view>
    <view class="modal-body">
      <view class="search-bar">
        <input placeholder="搜索客户名称/联系人" value="{{customerSearchKeyword}}" bindinput="onCustomerSearch" />
      </view>
      <scroll-view scroll-y class="customer-list">
        <view class="customer-item" wx:for="{{customers}}" wx:key="_id" bindtap="selectCustomerItem" data-item="{{item}}">
          <view class="flex-between">
            <text class="customer-name">{{item.name}}</text>
            <text wx:if="{{customer && customer._id === item._id}}" class="selected-tag">✓</text>
          </view>
          <text class="customer-contact">{{item.contact}} | {{item.phone}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 商品选择弹窗 -->
  <view class="modal-mask" wx:if="{{showProductModal}}" bindtap="closeProductModal"></view>
  <view class="modal-content product-modal" wx:if="{{showProductModal}}">
    <view class="modal-header">
      <text class="modal-title">选择商品</text>
      <text class="modal-close" bindtap="closeProductModal">×</text>
    </view>
    <view class="modal-body">
      <view class="search-bar">
        <input placeholder="搜索商品名称/SKU" value="{{productSearchKeyword}}" bindinput="onProductSearch" />
      </view>
      <scroll-view scroll-y class="product-list">
        <view class="product-item" wx:for="{{filteredProducts}}" wx:key="_id" bindtap="selectProductItem" data-item="{{item}}">
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <text class="product-sku">{{item.material_code}}</text>
          </view>
          <text class="product-price">¥{{item.price_piece}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 智能录入弹窗 -->
  <view class="modal-mask" wx:if="{{showSmartModal}}" bindtap="closeSmartModal"></view>
  <view class="modal-content smart-modal" wx:if="{{showSmartModal}}">
    <view class="modal-header">
      <text class="modal-title">智能录入</text>
      <text class="modal-close" bindtap="closeSmartModal">×</text>
    </view>
    <view class="modal-body">
      <view class="smart-hint">
        <text>📝 输入商品清单，系统自动识别</text>
        <text class="hint-example">示例：茅台 53 度 500ml 2 件 飞天 3 箱</text>
      </view>
      <textarea class="smart-textarea" placeholder="请输入商品清单，每行一个" value="{{smartInputText}}" bindinput="onSmartInputChange" />
      <view class="smart-preview" wx:if="{{smartPreviewItems.length > 0}}">
        <text class="preview-title">识别结果：</text>
        <view class="preview-list">
          <view class="preview-item" wx:for="{{smartPreviewItems}}" wx:key="name">
            <text>{{item.name}} x {{item.qty}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="closeSmartModal">取消</button>
      <button class="btn btn-primary" bindtap="processSmartInput" loading="{{smartInputLoading}}">{{smartInputLoading ? '识别中...' : '确认添加'}}</button>
    </view>
  </view>
</view>
