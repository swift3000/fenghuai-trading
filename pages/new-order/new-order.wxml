<view class="container" style="{{uiStyle}}">
  <view class="customer-bar card" bindtap="selectCustomer">
    <view class="customer-bar-info">
      <text class="customer-bar-name">{{customer ? customer.name : '请选择客户'}}</text>
      <text class="customer-bar-region">{{customer ? (customer.region || '选择客户') : '点击选择客户'}}</text>
    </view>
    <text class="customer-bar-arrow">›</text>
  </view>

  <view class="smart-input-btn" bindtap="openSmartInput">
    <text>🤖 智能录入（文字/语音）</text>
  </view>

  <view class="items-section">
    <view class="section-header flex-between">
      <text class="section-title">商品明细</text>
      <text class="add-btn" bindtap="addProduct">+ 添加商品</text>
    </view>

    <view class="prow-card card" wx:for="{{items}}" wx:key="_id">
      <view class="prow-head">
        <view>
          <view class="pname-box">
            <text class="pname">{{item.name}}</text>
            <text wx:if="{{item.pricing_mode === 'piece'}}" class="pmode-tag">件</text>
            <text wx:elif="{{item.pricing_mode === 'unit'}}" class="pmode-tag">单件</text>
            <text wx:if="{{item.is_adjustable}}" class="badge-adjust">可调价</text>
            <text wx:if="{{item.prefilled}}" class="badge-prefill">预填</text>
          </view>
          <view class="pspec">料号 {{item.material_code || '-'}} · {{item.spec}}</view>
        </view>
        <text class="del-btn" data-index="{{index}}" bindtap="removeItem">🗑️</text>
      </view>

      <!-- 数量双轨：case=件数+包数；piece=件数；unit=数量 -->
      <view wx:if="{{item.pricing_mode !== 'piece' && item.pricing_mode !== 'unit'}}" class="qty-group">
        <view class="qty-box">
          <view class="qty-label">件数</view>
          <view class="qty-stepper">
            <view class="step-btn" data-index="{{index}}" data-field="piece_qty" data-delta="-1" bindtap="adjustQty">−</view>
            <input class="qty-input" type="number" value="{{item.piece_qty}}" data-index="{{index}}" data-field="piece_qty" bindinput="onQtyInput" />
            <view class="step-btn" data-index="{{index}}" data-field="piece_qty" data-delta="1" bindtap="adjustQty">+</view>
          </view>
        </view>
        <view class="qty-box">
          <view class="qty-label">包数({{item.unit}})</view>
          <view class="qty-stepper">
            <view class="step-btn" data-index="{{index}}" data-field="package_qty" data-delta="-1" bindtap="adjustQty">−</view>
            <input class="qty-input" type="number" value="{{item.package_qty}}" data-index="{{index}}" data-field="package_qty" bindinput="onQtyInput" />
            <view class="step-btn" data-index="{{index}}" data-field="package_qty" data-delta="1" bindtap="adjustQty">+</view>
          </view>
        </view>
      </view>

      <view wx:elif="{{item.pricing_mode === 'piece'}}" class="qty-group">
        <view class="qty-box">
          <view class="qty-label">件数</view>
          <view class="qty-stepper">
            <view class="step-btn" data-index="{{index}}" data-field="piece_qty" data-delta="-1" bindtap="adjustQty">−</view>
            <input class="qty-input" type="number" value="{{item.piece_qty}}" data-index="{{index}}" data-field="piece_qty" bindinput="onQtyInput" />
            <view class="step-btn" data-index="{{index}}" data-field="piece_qty" data-delta="1" bindtap="adjustQty">+</view>
          </view>
        </view>
      </view>

      <view wx:else class="qty-group">
        <view class="qty-box">
          <view class="qty-label">数量({{item.unit}})</view>
          <view class="qty-stepper">
            <view class="step-btn" data-index="{{index}}" data-field="package_qty" data-delta="-1" bindtap="adjustQty">−</view>
            <input class="qty-input" type="number" value="{{item.package_qty}}" data-index="{{index}}" data-field="package_qty" bindinput="onQtyInput" />
            <view class="step-btn" data-index="{{index}}" data-field="package_qty" data-delta="1" bindtap="adjustQty">+</view>
          </view>
        </view>
      </view>

      <!-- 下单内改价（仅当前订单） -->
      <view wx:if="{{item.pricing_mode === 'case'}}" class="price-group">
        <view class="price-box">
          <view class="price-label">件价(¥/件)</view>
          <input class="price-input" type="digit" value="{{item.price_piece}}" data-index="{{index}}" data-field="price_piece" bindinput="onPriceInput" />
        </view>
        <view class="price-box">
          <view class="price-label">包价(¥/{{item.unit}})</view>
          <input class="price-input" type="digit" value="{{item.price_unit}}" data-index="{{index}}" data-field="price_unit" bindinput="onPriceInput" />
        </view>
      </view>
      <view wx:elif="{{item.pricing_mode === 'piece'}}" class="price-group">
        <view class="price-box">
          <view class="price-label">件价(¥/件)</view>
          <input class="price-input" type="digit" value="{{item.price_piece}}" data-index="{{index}}" data-field="price_piece" bindinput="onPriceInput" />
        </view>
      </view>
      <view wx:else class="price-group">
        <view class="price-box">
          <view class="price-label">单价(¥/{{item.unit}})</view>
          <input class="price-input" type="digit" value="{{item.price_unit}}" data-index="{{index}}" data-field="price_unit" bindinput="onPriceInput" />
        </view>
      </view>

      <!-- 备注 -->
      <view class="remark-row">
        <text class="remark-label">备注:</text>
        <input class="remark-input" placeholder="下单员备注..." value="{{item.remark}}" data-index="{{index}}" bindinput="onRemarkInput" />
      </view>

      <!-- 小计 -->
      <view class="prow-total">
        <text class="row-subtotal-label">小计</text>
        <text class="row-subtotal">¥{{item.subtotal}}</text>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{!items.length}}">
      <text>点击"添加商品"或"智能录入"开始</text>
    </view>
  </view>

  <view class="total-bar card">
    <view class="flex-between">
      <text class="total-label">合计</text>
      <text class="total-amount">¥{{totalAmount}}</text>
    </view>
  </view>

  <button class="btn-primary save-btn" bindtap="saveOrder">{{editMode ? '保存修改' : '保存订单'}}</button>

  <!-- 客户选择弹窗 -->
  <view class="modal-mask" wx:if="{{showCustomerModal}}" bindtap="closeCustomerModal"></view>
  <view class="modal-content customer-modal" wx:if="{{showCustomerModal}}">
    <view class="modal-header">
      <text class="modal-title">选择客户</text>
      <text class="modal-close" bindtap="closeCustomerModal">×</text>
    </view>
    <view class="modal-body">
      <view class="search-bar">
        <input placeholder="搜索客户名称/联系人" value="{{customerSearchKeyword}}" bindinput="onCustomerSearch" />
      </view>
      <scroll-view scroll-y class="customer-list">
        <view class="customer-item" wx:for="{{displayCustomers}}" wx:key="_id" bindtap="selectCustomerItem" data-item="{{item}}">
          <view class="flex-between">
            <text class="customer-name">{{item.name}}</text>
            <text wx:if="{{customer && customer._id === item._id}}" class="selected-tag">✓</text>
          </view>
          <text class="customer-contact">{{item.contact}} | {{item.phone}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 商品选择弹窗 -->
  <view class="modal-mask" wx:if="{{showProductModal}}" bindtap="closeProductModal"></view>
  <view class="modal-content product-modal" wx:if="{{showProductModal}}">
    <view class="modal-header">
      <text class="modal-title">选择商品</text>
      <text class="modal-close" bindtap="closeProductModal">×</text>
    </view>
    <view class="modal-body">
      <view class="search-bar">
        <input placeholder="搜索商品名称/料号/拼音" value="{{productSearchKeyword}}" bindinput="onProductSearch" />
      </view>
      <scroll-view scroll-y class="product-list">
        <view class="product-item" wx:for="{{displayProducts}}" wx:key="_id" bindtap="selectProductItem" data-item="{{item}}">
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <text class="product-sku">{{item.material_code}} · {{item.spec}}</text>
          </view>
          <text class="product-price">{{item.priceText}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 智能录入弹窗 -->
  <view class="modal-mask" wx:if="{{showSmartModal}}" bindtap="closeSmartModal"></view>
  <view class="modal-content smart-modal" wx:if="{{showSmartModal}}">
    <view class="modal-header">
      <text class="modal-title">智能录入</text>
      <text class="modal-close" bindtap="closeSmartModal">×</text>
    </view>
    <view class="modal-body">
      <!-- 语音录入（腾讯云 ASR） -->
      <view class="smart-voice-notice" wx:if="{{voiceState === 'idle'}}">
        <text class="notice-icon">🎙️</text>
        <text class="notice-text">点击按住说话，说商品清单即可自动识别</text>
        <text class="notice-sub">示例：""手抓饼两件，老酸奶十包""</text>
        <view class="voice-btn" bindtap="startVoiceInput"><text class="voice-btn-icon">🎤</text></view>
      </view>
      <view class="smart-voice-notice voice-recording" wx:if="{{voiceState === 'recording'}}">
        <text class="notice-icon">🔴</text>
        <text class="notice-text">正在录音… 请说话（最长 60 秒）</text>
        <text class="notice-sub">点击下面按钮停止并识别</text>
        <view class="voice-btn" bindtap="stopVoiceInput"><text class="voice-btn-icon">⏹</text></view>
      </view>
      <view class="smart-voice-notice" wx:if="{{voiceState === 'transcribing'}}">
        <text class="notice-icon">⏳</text>
        <text class="notice-text">语音识别中，请稍候…</text>
        <text class="notice-sub">腾讯云 ASR 转文字</text>
      </view>
      <view class="smart-divider">或</view>
      
      <view class="smart-hint">
        <text>📝 输入商品清单，系统自动识别</text>
        <text class="hint-example">示例：手抓饼 2 件，老酸奶 10 包</text>
      </view>
      <textarea class="smart-textarea" placeholder="请输入商品清单，每行一个" value="{{smartInputText}}" bindinput="onSmartInputChange" />
      <view class="smart-preview" wx:if="{{smartPreviewItems.length > 0}}">
        <text class="preview-title">识别结果：</text>
        <view class="preview-list">
          <view class="preview-item" wx:for="{{smartPreviewItems}}" wx:key="name">
            <text>{{item.name}} x {{item.qty}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="closeSmartModal">取消</button>
      <button class="btn btn-primary" bindtap="processSmartInput" loading="{{smartInputLoading}}">{{smartInputLoading ? '识别中...' : '确认添加'}}</button>
    </view>
  </view>
</view>
