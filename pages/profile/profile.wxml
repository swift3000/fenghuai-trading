<view class="container" style="{{uiStyle}}">
  <view class="user-card card">
    <text class="user-name">{{userInfo.name || '用户'}}</text>
    <text class="role-badge">{{roleText}}</text>
  </view>
  <view class="menu-list">
    <view class="menu-item" wx:if="{{canViewProducts}}" bindtap="goToProducts"><text>商品管理</text><text>›</text></view>
    <view class="menu-item" wx:if="{{canViewCustomers}}" bindtap="goToCustomers"><text>客户管理</text><text>›</text></view>
    <view class="menu-item" wx:if="{{canViewReports}}" bindtap="goToReports"><text>报表统计</text><text>›</text></view>
    <view class="menu-item"><text>字体大小</text><slider min="0.7" max="1.3" step="0.1" value="{{fontSizeScale}}" bindchange="changeFontSize" /></view>
    <view class="menu-item" wx:if="{{canManageMembers}}" bindtap="goToMembers"><text>成员管理</text><text>›</text></view>
    <view class="menu-item" wx:if="{{userRole==='admin'}}" bindtap="goToSettings"><text>系统设置</text><text>›</text></view>
  </view>
  <button class="btn-danger logout-btn" bindtap="handleLogout">退出登录</button>
</view>
