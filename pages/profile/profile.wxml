<view class="container" style="{{uiStyle}}">
  <!-- 头部：绿色渐变 + 头像 + 角色副标题（对齐原型 .profile-header） -->
  <view class="profile-header">
    <view class="pf-avatar">{{userInitial}}</view>
    <view class="pf-name">{{userInfo.name || '用户'}}</view>
    <view class="pf-role">丰淮商贸 · {{roleText}}</view>
  </view>

  <!-- 功能菜单 -->
  <view class="profile-menu">
    <view class="menu-item" wx:if="{{canViewProducts}}" bindtap="goToProducts">
      <view class="mi-left"><view class="mi-icon m1">📦</view><text class="mi-lbl">商品管理</text></view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{canViewCustomers}}" bindtap="goToCustomers">
      <view class="mi-left"><view class="mi-icon m2">🏪</view><text class="mi-lbl">客户管理</text></view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{canViewReports}}" bindtap="goToReports">
      <view class="mi-left"><view class="mi-icon m3">📊</view><text class="mi-lbl">报表统计</text></view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="openFontPanel">
      <view class="mi-left"><view class="mi-icon m4">🔤</view><text class="mi-lbl">字体大小</text></view>
      <text class="mi-fontval">{{fontScalePct}}%</text>
    </view>
    <view class="menu-item" bindtap="goToAutoConfirm">
      <view class="mi-left"><view class="mi-icon m5">⏰</view><text class="mi-lbl">定时自动确认<text wx:if="{{autoConfirmEnabled}}" class="mi-tag">已开启 {{autoConfirmTime}}</text></text></view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{canManageMembers}}" bindtap="goToMembers">
      <view class="mi-left"><view class="mi-icon m6">👥</view><text class="mi-lbl">成员管理</text></view>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{userRole==='admin'}}" bindtap="goToSettings">
      <view class="mi-left"><view class="mi-icon m7">⚙️</view><text class="mi-lbl">系统设置</text></view>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="profile-menu">
    <view class="menu-item" bindtap="handleLogout">
      <view class="mi-left"><view class="mi-icon mred">↩</view><text class="mi-lbl mi-logout">退出登录</text></view>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <view class="pf-version">丰淮商贸 v0.1.0</view>
</view>
