/* 我的页（对齐原型 .profile-header / .profile-menu） */
.container {
  min-height: 100vh;
  background: #F5F6F8;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom)) !important;
}

.profile-header {
  background: linear-gradient(135deg, var(--theme-primary, #22B14C) 0%, #06AD56 100%);
  padding: 56rpx 32rpx 48rpx;
  color: #fff;
  text-align: center;
}
.pf-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(48rpx * var(--font-scale));
  font-weight: 600;
  margin: 0 auto 24rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
}
.pf-name {
  font-size: calc(40rpx * var(--font-scale));
  font-weight: 600;
}
.pf-role {
  font-size: calc(24rpx * var(--font-scale));
  opacity: 0.9;
  margin-top: 8rpx;
}

.profile-menu {
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #FAFAFA; }
.mi-left { display: flex; align-items: center; gap: 24rpx; flex: 1; }
.mi-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(30rpx * var(--font-scale));
  color: #fff;
  flex-shrink: 0;
}
.mi-icon.m1 { background: var(--theme-primary, #22B14C); }
.mi-icon.m2 { background: #F97316; }
.mi-icon.m3 { background: #1989FA; }
.mi-icon.m4 { background: #7C3AED; }
.mi-icon.m5 { background: #D97706; }
.mi-icon.m6 { background: #8B5CF6; }
.mi-icon.m7 { background: #64748B; }
.mi-icon.mred { background: #DC2626; }
.mi-lbl { font-size: calc(28rpx * var(--font-scale)); color: #333; }
.mi-logout { color: #DC2626; }
.mi-tag {
  margin-left: 12rpx;
  font-size: calc(20rpx * var(--font-scale));
  color: #D97706;
  background: #FEF3C7;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.mi-arrow { color: #CCC; font-size: calc(36rpx * var(--font-scale)); margin-left: 12rpx; }
.mi-fontval { font-size: calc(24rpx * var(--font-scale)); color: #999; margin-right: 8rpx; }
.pf-version {
  text-align: center;
  padding: 32rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: #CCC;
}
