<view class="container" style="{{uiStyle}}">
  <!-- 邀请新成员 -->
  <view class="invite-section card">
    <text class="section-title">📨 邀请新成员</text>
    <text class="invite-sub">先选「邀请角色」，再生成专属邀请二维码 / 链接。员工微信扫码即用其 openid 注册，并<text class="invite-sub-b">自动绑定为该角色</text>，无需管理员再手动分配。</text>
    <picker bindchange="changeInviteRole" value="{{inviteRole}}" range="{{roleOptions}}" range-key="label">
      <view class="role-picker">
        <text class="label">邀请角色</text>
        <text class="value">{{inviteRoleLabel}}</text>
      </view>
    </picker>
    <!-- 对齐原型 qr-row：左 QR + 右侧竖排双按钮 -->
    <view class="qr-row">
      <view class="qr-box">
        <image wx:if="{{inviteQr}}" class="qr-img" src="{{inviteQr}}" mode="aspectFit" />
        <text wx:else class="qr-placeholder">🔗</text>
      </view>
      <view class="ic-actions">
        <button class="btn-invite primary" bindtap="handleInvite">🔗 生成邀请</button>
        <button class="btn-invite" wx:if="{{lastInvite}}" open-type="share">📤 转发给微信好友</button>
        <button class="btn-invite" bindtap="handleInvite">🔄 刷新</button>
      </view>
    </view>

    <!-- 生成的邀请卡片 -->
    <view class="invite-result" wx:if="{{inviteQr || lastInvite}}">
      <view class="invite-result-info" wx:if="{{lastInvite}}">
        <text class="invite-result-role">角色：{{lastInvite.roleLabel}}</text>
        <view class="invite-result-code-row">
          <text class="invite-result-label">邀请码：{{lastInvite.code}}</text>
          <text class="invite-copy" data-code="{{lastInvite.code}}" bindtap="copyInvite">复制</text>
        </view>
        <text class="invite-result-expire">{{lastInvite.expireText}} · 员工扫码或点转发卡片登录，自动绑定该角色</text>
      </view>
      <text class="invite-close" bindtap="closeInvite">× 关闭</text>
    </view>
  </view>

  <!-- 成员列表（对齐原型：按角色分组，组头=角色标签+N人+添加成员） -->
  <view class="members-section card">
    <view class="sec-head-line">
      <text class="section-title">团队成员</text>
      <text class="sec-hint">微信 openid 即身份</text>
    </view>

    <view class="empty-tip" wx:if="{{members.length === 0}}">
      <text>暂无成员，请邀请新成员加入</text>
    </view>

    <view class="role-group" wx:for="{{roleGroups}}" wx:key="role" wx:for-item="grp">
      <view class="role-group-head">
        <text class="member-role" style="background:{{grp.color}}">{{grp.label}}</text>
        <text class="member-count">{{grp.count}} 人</text>
        <button class="add-member-btn" data-role="{{grp.role}}" bindtap="openMemberForm">＋ 添加成员</button>
      </view>
      <view class="role-empty" wx:if="{{grp.count === 0}}">该角色暂无成员，点击右上角添加</view>
      <view class="member-item" wx:for="{{grp.items}}" wx:key="_id" wx:for-item="m">
        <view class="member-avatar" style="background:{{grp.color}}">{{m.initial}}</view>
        <view class="member-info">
          <view class="mn-line">
            <text class="mn">{{m.name || '待加入成员'}}</text>
            <text class="member-pending" wx:if="{{m.pending}}">待确认</text>
          </view>
          <text class="ms">{{m.subText}}</text>
        </view>
        <view class="member-del" data-id="{{m._id}}" bindtap="handleRemove">✕</view>
      </view>
    </view>
  </view>

  <!-- 添加成员弹窗（对齐原型二级 memberFormModal） -->
  <view class="modal-mask" wx:if="{{showMemberForm}}" bindtap="closeMemberForm">
    <view class="modal" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">添加成员</text>
        <text class="modal-close" bindtap="closeMemberForm">✕</text>
      </view>
      <view class="modal-body">
        <view class="mf-row">
          <text class="mf-label">姓名 / 昵称</text>
          <input class="mf-input" value="{{addMemberName}}" bindinput="onAddMemberField" data-field="addMemberName" placeholder="如：赵报价" maxlength="20" />
        </view>
        <view class="mf-row">
          <text class="mf-label">角色</text>
          <picker class="mf-picker" bindchange="changeAddMemberRole" value="{{addMemberRole}}" range="{{roleOptions}}" range-key="label">
            <view class="mf-picker-value">{{addMemberRoleLabel}}<text class="mf-arrow">▾</text></view>
          </picker>
        </view>
        <view class="mf-row">
          <text class="mf-label">微信 openid / 微信号（选填）</text>
          <input class="mf-input" value="{{addMemberOpenid}}" bindinput="onAddMemberField" data-field="addMemberOpenid" placeholder="填写则直接激活，留空为待确认（邀请扫码绑定）" />
        </view>
        <view class="mf-row">
          <text class="mf-label">手机号（选填）</text>
          <input class="mf-input" type="number" value="{{addMemberPhone}}" bindinput="onAddMemberField" data-field="addMemberPhone" placeholder="如：13800000000" maxlength="11" />
        </view>
        <button class="btn-primary mf-submit" bindtap="submitMemberForm">确认添加</button>
      </view>
    </view>
  </view>

  <!-- 角色权限配置（权限矩阵）：仅管理员 -->
  <view class="perm-section card" wx:if="{{permGroups.length > 0}}">
    <view class="perm-sec-head" bindtap="togglePermSection">
      <text class="perm-title">角色权限配置</text>
      <text class="perm-hint">点击展开/收起 · 仅管理员可调整</text>
      <text class="sec-arrow {{permCollapsed ? 'collapsed' : ''}}">▾</text>
    </view>
    <block wx:if="{{!permCollapsed}}">
    <view class="perm-header">
      <text class="perm-sub">管理员可逐项调整每个角色的<text class="perm-note-strong">功能权限</text>。默认全员开放，仅「登记收款 / 确认收款」分工、<text class="perm-note-strong">成员管理固定管理员独占</text>（不可改，防锁死）。</text>
      <button class="perm-reset" bindtap="resetPerms" size="mini">↺ 恢复默认（全员开放）</button>
    </view>

    <!-- 管理员设置指南 -->
    <view class="admin-guide">
      <view class="ag-title">🔐 管理员设置指南</view>
      <view class="ag-step"><text class="ag-b">第 1 步：微信身份自动分配</text><view class="ag-line">每位员工用微信登录后，系统自动获得唯一的 openid 身份标识（管理员可在「团队成员」中查看），无需任何手动配置。</view></view>
      <view class="ag-step"><text class="ag-b">第 2 步：成为首位管理员（零配置）</text><view class="ag-line">系统首次启动时没有管理员，<text class="ag-b">第一位登录的人自动成为管理员</text>，无需配置任何环境变量。你登录后会看到完整管理功能。</view></view>
      <view class="ag-step"><text class="ag-b">第 3 步：添加更多管理员</text><view class="ag-line">在下方「团队成员」中点管理员角色的「＋ 添加成员」，填写对方信息即可。管理员数量不限。</view></view>
      <view class="ag-step"><text class="ag-b">邀请成员</text><view class="ag-line">用上方「邀请新成员」生成带角色的专属链接，员工扫码即自动绑定角色，无需手动分配。</view></view>
    </view>

    <view class="perm-note">
      说明：「成员管理」固定为管理员独占（防止权限锁死），其余权限管理员可随时按需开关，改动即时保存生效。
    </view>

    <view class="perm-group" wx:for="{{permGroups}}" wx:key="name" wx:for-item="group" wx:for-index="gi">
      <view class="perm-group-head">
        <text class="perm-group-name">{{group.name}}</text>
        <text class="perm-group-tag">{{group.count}} 项</text>
      </view>
      <view class="perm-table">
        <view class="perm-row perm-head">
          <view class="perm-cell perm-name">权限</view>
          <view class="perm-cell perm-col" wx:for="{{roleCols}}" wx:key="role" wx:for-item="col">{{col.label}}</view>
        </view>
        <view class="perm-row" wx:for="{{group.rows}}" wx:key="key" wx:for-item="r" wx:for-index="ri">
          <view class="perm-cell perm-name">
            <text>{{r.label}}</text>
            <text class="perm-locked-tip" wx:if="{{r.locked}}">仅管理员</text>
          </view>
          <view class="perm-cell perm-col" wx:for="{{r.cells}}" wx:key="index" wx:for-item="c" wx:for-index="ci">
            <view class="perm-switch {{c.on ? 'on' : ''}} {{c.disabled ? 'locked' : ''}}"
                  data-group="{{gi}}" data-row="{{ri}}" data-role="{{ci}}"
                  bindtap="togglePerm">
              <view class="perm-knob"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
    </block>
  </view>
</view>
