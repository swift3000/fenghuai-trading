<view class="container" style="{{uiStyle}}">
  <!-- 邀请新成员 -->
  <view class="invite-section card">
    <text class="section-title">邀请新成员</text>
    <picker bindchange="changeInviteRole" value="{{inviteRole}}" range="{{roleOptions}}" range-key="label">
      <view class="role-picker">
        <text class="label">选择角色：</text>
        <text class="value">{{inviteRoleLabel}}</text>
      </view>
    </picker>
    <button class="btn-primary" bindtap="handleInvite">生成邀请二维码</button>

    <!-- 生成的邀请卡片 -->
    <view class="invite-result" wx:if="{{inviteQr || lastInvite}}">
      <image class="invite-qr" wx:if="{{inviteQr}}" src="{{inviteQr}}" mode="aspectFit" />
      <view class="invite-result-info" wx:if="{{lastInvite}}">
        <text class="invite-result-role">角色：{{lastInvite.roleLabel}}</text>
        <view class="invite-result-code-row">
          <text class="invite-result-label">邀请码：{{lastInvite.code}}</text>
          <text class="invite-copy" data-code="{{lastInvite.code}}" bindtap="copyInvite">复制</text>
        </view>
        <text class="invite-result-expire">{{lastInvite.expireText}} · 员工扫码即自动绑定该角色</text>
      </view>
      <text class="invite-close" bindtap="closeInvite">× 关闭</text>
    </view>
  </view>

  <!-- 成员列表 -->
  <view class="members-section">
    <text class="section-title">团队成员 ({{members.length}})</text>
    
    <view class="empty-tip" wx:if="{{members.length === 0}}">
      <text>暂无成员，请邀请新成员加入</text>
    </view>

    <view class="member-list">
      <view class="member-item card" wx:for="{{members}}" wx:key="_id">
        <view class="member-header">
          <view class="member-info">
            <text class="member-name">{{item.name || '待加入成员'}}</text>
            <text class="member-phone" wx:if="{{item.phone}}">{{item.phone}}</text>
            <text class="member-region" wx:if="{{item.region}}">{{item.region}}</text>
          </view>
          <view class="role-actions">
            <text class="role-tag role-{{item.role}}">{{roleMap[item.role]}}</text>
            <picker bindchange="changeRole" data-id="{{item._id}}" value="{{roleIndex}}" range="{{roleOptions}}" range-key="label" wx:if="{{item.role !== 'admin'}}">
              <text class="change-role">切换</text>
            </picker>
            <text class="text-danger" data-id="{{item._id}}" bindtap="handleRemove" wx:if="{{item.role !== 'admin'}}">移除</text>
          </view>
        </view>
        <view class="member-status">
          <text class="status-{{item.status}}">{{statusMap[item.status]}}</text>
          <text class="member-date">加入：{{item.dateText}}</text>
        </view>
        <view class="member-invite" wx:if="{{item.status === 'pending' && item.inviteCode}}">
          <text class="invite-code-text">邀请码：{{item.inviteCode}}</text>
          <text class="invite-copy" data-code="{{item.inviteCode}}" bindtap="copyInvite">复制</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 角色权限配置（权限矩阵）：仅管理员 -->
  <view class="perm-section card" wx:if="{{permGroups.length > 0}}">
    <view class="perm-header">
      <text class="perm-title">角色权限配置</text>
      <text class="perm-sub">管理员可逐项调整每个角色的<text class="perm-note-strong">功能权限</text>。默认全员开放，仅「登记收款 / 确认收款」分工、<text class="perm-note-strong">成员管理固定管理员独占</text>（不可改，防锁死）。</text>
      <button class="perm-reset" bindtap="resetPerms" size="mini">↺ 恢复默认（全员开放）</button>
    </view>

    <!-- 管理员设置指南 -->
    <view class="admin-guide">
      <view class="ag-title">🔐 管理员设置指南</view>
      <view class="ag-step"><text class="ag-b">第 1 步：微信身份自动分配</text><view class="ag-line">每位员工用微信登录后，系统自动获得唯一的 openid 身份标识（管理员可在「团队成员」中查看），无需任何手动配置。</view></view>
      <view class="ag-step"><text class="ag-b">第 2 步：成为首位管理员（零配置）</text><view class="ag-line">系统首次启动时没有管理员，<text class="ag-b">第一位登录的人自动成为管理员</text>，无需配置任何环境变量。你登录后会看到完整管理功能。</view></view>
      <view class="ag-step"><text class="ag-b">第 3 步：添加更多管理员</text><view class="ag-line">在下方「团队成员」中点管理员角色的「＋ 添加成员」，填写对方信息即可。管理员数量不限。</view></view>
      <view class="ag-step"><text class="ag-b">邀请成员</text><view class="ag-line">用上方「邀请新成员」生成带角色的专属链接，员工扫码即自动绑定角色，无需手动分配。</view></view>
    </view>

    <view class="perm-note">
      说明：「成员管理」固定为管理员独占（防止权限锁死），其余权限管理员可随时按需开关，改动即时保存生效。
    </view>

    <view class="perm-group" wx:for="{{permGroups}}" wx:key="name" wx:for-item="group" wx:for-index="gi">
      <view class="perm-group-head">
        <text class="perm-group-name">{{group.name}}</text>
        <text class="perm-group-tag">{{group.count}} 项</text>
      </view>
      <view class="perm-table">
        <view class="perm-row perm-head">
          <view class="perm-cell perm-name">权限</view>
          <view class="perm-cell perm-col" wx:for="{{roleCols}}" wx:key="role" wx:for-item="col">{{col.label}}</view>
        </view>
        <view class="perm-row" wx:for="{{group.rows}}" wx:key="key" wx:for-item="r" wx:for-index="ri">
          <view class="perm-cell perm-name">
            <text>{{r.label}}</text>
            <text class="perm-locked-tip" wx:if="{{r.locked}}">仅管理员</text>
          </view>
          <view class="perm-cell perm-col" wx:for="{{r.cells}}" wx:key="index" wx:for-item="c" wx:for-index="ci">
            <view class="perm-switch {{c.on ? 'on' : ''}} {{c.disabled ? 'locked' : ''}}"
                  data-group="{{gi}}" data-row="{{ri}}" data-role="{{ci}}"
                  bindtap="togglePerm">
              <view class="perm-knob"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
