.container {
  padding: 24rpx;
  background: #F5F6F8;
  min-height: 100vh;
}

.invite-section {
  padding: 28rpx;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(6, 173, 86, 0.2);
}
.invite-result {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.invite-qr {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 20rpx;
}

.invite-result-info {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.invite-result-role {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.invite-result-code-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.invite-result-label {
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 700;
  color: var(--theme-primary);
  letter-spacing: 2rpx;
}

.invite-result-expire {
  font-size: calc(24rpx * var(--font-scale));
  color: #999;
  text-align: center;
}

.invite-close {
  margin-top: 16rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: #999;
}


.section-title {
  font-size: calc(30rpx * var(--font-scale));
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  display: block;
}

/* 邀请区副标题（对齐原型 ic-sub） */
.invite-sub {
  display: block;
  font-size: calc(24rpx * var(--font-scale));
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.invite-sub-b {
  font-weight: bold;
  color: #fff;
}

/* 邀请操作按钮行（对齐原型 qr-row 双按钮） */
.invite-actions {
  display: flex;
  gap: 16rpx;
}

.invite-btn {
  flex: 1;
  margin: 0;
  font-size: calc(28rpx * var(--font-scale));
  border-radius: 12rpx;
}

.invite-btn.refresh {
  background: rgba(255, 255, 255, 0.95);
  color: var(--theme-primary);
  font-weight: 500;
}

.role-picker {
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  font-size: calc(28rpx * var(--font-scale));
  display: flex;
  align-items: center;
  backdrop-filter: blur(10rpx);
}

.role-picker .label {
  color: #333;
  font-weight: 500;
}

.role-picker .value {
  color: var(--theme-primary);
  font-weight: bold;
  margin-left: 12rpx;
  font-size: calc(30rpx * var(--font-scale));
}

.btn-primary {
  background: #fff;
  color: var(--theme-primary);
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: calc(30rpx * var(--font-scale));
  margin-top: 24rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: calc(28rpx * var(--font-scale));
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx dashed #e0e0e0;
}

.member-list {
  margin-top: 24rpx;
}
.members-section .section-title {
  color: #333;
  margin-bottom: 12rpx;
}

.member-item {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(6, 173, 86, 0.08);
  transition: all 0.3s;
}

.member-item:active {
  transform: scale(0.99);
  box-shadow: 0 8rpx 20rpx rgba(6, 173, 86, 0.1);
}

.member-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.member-phone {
  font-size: calc(26rpx * var(--font-scale));
  color: #666;
  display: block;
  margin-bottom: 4rpx;
}

.member-region {
  font-size: calc(24rpx * var(--font-scale));
  color: #999;
  display: block;
}

.role-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.role-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 500;
}

.role-admin {
  background: linear-gradient(135deg, #FF9500 0%, #ffb333 100%);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(255, 149, 0, 0.3);
}

.role-orderer {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(6, 173, 86, 0.3);
}

.role-sorter {
  background: linear-gradient(135deg, #34C759 0%, #4dd46a 100%);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(52, 199, 89, 0.3);
}

.role-warehouse {
  background: linear-gradient(135deg, #5856D6 0%, #716ee0 100%);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(88, 86, 214, 0.3);
}



.text-danger {
  color: #FF3B30;
  font-size: calc(24rpx * var(--font-scale));
  padding: 8rpx 16rpx;
  border: 1rpx solid #FF3B30;
  border-radius: 6rpx;
  font-weight: 500;
}

.text-danger:active {
  background: #fff5f5;
  opacity: 0.7;
}

.member-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.status-active {
  color: #34C759;
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 500;
}

.status-pending {
  color: #F5A623;
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 500;
}

.status-inactive {
  color: #999;
  font-size: calc(24rpx * var(--font-scale));
}

.member-date {
  font-size: calc(24rpx * var(--font-scale));
  color: #999;
}

.member-invite {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #FFF9EC;
  border-radius: 12rpx;
  font-size: calc(24rpx * var(--font-scale));
}

.invite-code-text {
  color: #B8860B;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.invite-copy {
  color: var(--theme-primary);
  font-weight: 500;
  padding: 6rpx 16rpx;
  border: 1rpx solid var(--theme-primary);
  border-radius: 8rpx;
}

.invite-copy:active {
  background: var(--theme-primary-bg);
  opacity: 0.7;
}

/* ===== 角色权限配置（权限矩阵） ===== */
.perm-section {
  margin-top: 30rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.perm-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}
.perm-title {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: bold;
  color: #333;
}
.perm-sub {
  font-size: calc(24rpx * var(--font-scale));
  color: #999;
  margin-top: 6rpx;
}
.perm-reset {
  margin-top: 16rpx;
  align-self: flex-start;
  background: #fff;
  color: var(--theme-primary);
  border: 1rpx solid var(--theme-primary);
  border-radius: 8rpx;
  font-size: calc(24rpx * var(--font-scale));
  padding: 0 20rpx;
  line-height: 2;
}
.perm-note {
  font-size: calc(24rpx * var(--font-scale));
  color: #666;
  background: #F7Faf6;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  line-height: 1.6;
}
.admin-guide {
  margin: 16rpx 0 8rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid var(--theme-border, #e5e7eb);
  border-radius: 12rpx;
}
.ag-title {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
  color: var(--theme-text, #111);
  margin-bottom: 12rpx;
}
.ag-step {
  margin-bottom: 12rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--theme-text, #333);
}
.ag-step:last-child { margin-bottom: 0; }
.ag-b { font-weight: 600; }
.ag-line {
  color: var(--theme-subtext, #666);
  margin-top: 4rpx;
}
.perm-note-strong {
  color: var(--theme-primary);
  font-weight: 600;
}
.perm-group {
  margin-bottom: 28rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  overflow: hidden;
}
.perm-group:last-child {
  margin-bottom: 0;
}
.perm-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #f9fafb;
  border-bottom: 1rpx solid #eee;
}
.perm-group-name {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
  color: #333;
}
.perm-group-tag {
  font-size: calc(22rpx * var(--font-scale));
  color: #999;
  background: #fff;
  border: 1rpx solid #e5e5e5;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}
.perm-table {
  padding: 0 12rpx;
}
.perm-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
  min-height: 84rpx;
}
.perm-row:last-child {
  border-bottom: none;
}
.perm-head {
  background: #fafbfc;
}
.perm-cell {
  padding: 12rpx 8rpx;
}
.perm-name {
  flex: 1;
  font-size: calc(26rpx * var(--font-scale));
  color: #333;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}
.perm-col {
  width: 110rpx;
  text-align: center;
  font-size: calc(24rpx * var(--font-scale));
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
}
.perm-locked-tip {
  font-size: calc(20rpx * var(--font-scale));
  color: #FF9500;
  background: #FFF7E8;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}
.perm-switch {
  width: 76rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #e0e0e0;
  position: relative;
  transition: background 0.2s;
  box-sizing: border-box;
}
.perm-switch .perm-knob {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.2s;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}
.perm-switch.on {
  background: var(--theme-primary);
}
.perm-switch.on .perm-knob {
  left: 36rpx;
}
.perm-switch.locked {
  opacity: 0.55;
}

/* ===== T19: 对齐原型 成员列表分组 + 添加成员弹窗 + 权限折叠 ===== */
.members-section.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 16rpx 8rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.sec-head-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 4rpx 8rpx 0;
}
.sec-hint {
  font-size: calc(22rpx * var(--font-scale));
  color: #999;
}
.role-group {
  margin-top: 8rpx;
}
.role-group-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx 12rpx;
}
.member-role {
  font-size: calc(22rpx * var(--font-scale));
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  color: #fff;
}
.member-count {
  font-size: calc(22rpx * var(--font-scale));
  color: #666;
}
.add-member-btn {
  margin-left: auto;
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 500;
  color: var(--theme-primary, #67C23A);
  background: rgba(103, 194, 58, 0.1);
  border: none;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  line-height: 1.4;
}
.add-member-btn::after { border: none; }
.add-member-btn:active {
  background: rgba(103, 194, 58, 0.22);
}
.role-empty {
  padding: 4rpx 16rpx 20rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: #bbb;
}
.member-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 8rpx;
  border-top: 1rpx solid #f0f0f0;
  background: transparent;
  box-shadow: none;
  margin: 0;
}
.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 600;
  font-size: calc(30rpx * var(--font-scale));
  flex-shrink: 0;
}
.member-info {
  flex: 1;
  min-width: 0;
}
.mn-line {
  display: flex;
  align-items: baseline;
}
.mn {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 500;
  color: #333;
}
.ms {
  font-size: calc(22rpx * var(--font-scale));
  color: #999;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member-pending {
  font-size: calc(21rpx * var(--font-scale));
  color: #B8860B;
  margin-left: 12rpx;
}
.member-del {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  color: #FF3B30;
  font-size: calc(28rpx * var(--font-scale));
  flex-shrink: 0;
}
.member-del:active {
  background: #FDE2E2;
}

/* 添加成员弹窗 */
.modal-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 84%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 8rpx;
}
.modal-title {
  font-size: calc(32rpx * var(--font-scale));
  font-weight: 600;
  color: #333;
}
.modal-close {
  font-size: calc(30rpx * var(--font-scale));
  color: #999;
  padding: 8rpx;
}
.modal-body {
  padding: 16rpx 32rpx 32rpx;
}
.mf-row {
  margin-bottom: 24rpx;
}
.mf-label {
  display: block;
  font-size: calc(26rpx * var(--font-scale));
  color: #666;
  margin-bottom: 10rpx;
}
.mf-input {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: calc(28rpx * var(--font-scale));
  background: #fafafa;
}
.mf-picker {
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  background: #fafafa;
}
.mf-picker-value {
  font-size: calc(28rpx * var(--font-scale));
  color: #333;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mf-arrow {
  color: #999;
  font-size: calc(24rpx * var(--font-scale));
}
.mf-submit {
  width: 100%;
  margin-top: 12rpx;
}

/* 权限配置折叠头 */
.perm-sec-head {
  display: flex;
  align-items: center;
  padding: 4rpx 0 16rpx;
}
.perm-sec-head .perm-title {
  margin-right: 12rpx;
}
.perm-hint {
  font-size: calc(22rpx * var(--font-scale));
  color: #999;
  flex: 1;
}
.sec-arrow {
  font-size: calc(26rpx * var(--font-scale));
  color: #999;
  transition: transform 0.25s ease;
}
.sec-arrow.collapsed {
  transform: rotate(-90deg);
}
