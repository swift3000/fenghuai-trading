/* ==================== 全局基础样式 ==================== */
page {
  /* 颜色系统 - 与原型一致 */
  --theme-primary: #07C160;
  /* T66b 设计token收口：主色=现网微信绿 #07C160（2026-09-02 老板授权拍板）；
     页面禁止散落硬编码，一律 var() 引用；JS 动态色必须与 --theme-success 同值 */
  --theme-primary-bright: #45D06F;
  --theme-primary-light: #06AD56;
  --theme-success: #16A34A;
  --theme-primary-bg: linear-gradient(135deg, #E8F5E9 0%, #fff 100%);
  --theme-secondary: #FF6B35;
  --theme-secondary-light: #FF8A65;
  --theme-bg: #F5F6F8;
  --theme-card: #FFFFFF;
  --theme-text: #191919;
  --theme-text-1: #333333;
  --theme-text-2: #666666;
  --theme-text-3: #999999;
  --theme-border: #E0E0E0;
  --theme-orange: #FF6B35;
  --theme-green: #06AD56;
  --theme-red: #F56C6C;
  --theme-blue: #409EFF;
  --theme-text-secondary: #888888;
  --theme-tab-bar: #FFFFFF;
  
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  font-size: calc(28rpx * var(--font-scale, 1));
  line-height: 1.5;
  color: var(--theme-text);
  background-color: var(--theme-bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 通用容器 */
.container {
  padding: 20rpx;
  padding-bottom: 140rpx; /* 为 TabBar 留空间 */
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--theme-card);
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}

.card:active {
  transform: scale(0.99);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.06);
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: calc(30rpx * var(--font-scale, 1));
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(6, 173, 86, 0.3);
  transition: all 0.2s ease;
  border: none;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(6, 173, 86, 0.2);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #fff;
  color: var(--theme-text);
  border: 1rpx solid var(--theme-border);
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: calc(30rpx * var(--font-scale, 1));
  transition: all 0.2s ease;
}

.btn-secondary:active {
  background: #f5f5f5;
}

.btn-secondary::after {
  border: none;
}

.btn-danger {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff4d4f 100%);
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: calc(30rpx * var(--font-scale, 1));
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(245, 108, 108, 0.3);
  transition: all 0.2s ease;
  border: none;
}

.btn-danger:active {
  transform: scale(0.98);
}

.btn-danger::after {
  border: none;
}

/* 通用文本样式 */
.text-primary { color: var(--theme-primary); }
.text-secondary { color: var(--theme-text-2); }
.text-muted { color: var(--theme-text-3); }
.text-danger { color: var(--theme-red); }
.text-success { color: var(--theme-green); }
.text-orange { color: var(--theme-orange); }

/* 背景样式 */
.bg-primary { background-color: var(--theme-primary); }
.bg-card { background-color: var(--theme-card); }
.bg-light { background-color: #f5f6f8; }

/* 边框 */
.border { border: 1rpx solid var(--theme-border); }
.border-top { border-top: 1rpx solid var(--theme-border); }
.border-bottom { border-bottom: 1rpx solid var(--theme-border); }

/* ==================== 布局工具类 ==================== */
.flex { display: flex; }
.flex-column { flex-direction: column; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-start { display: flex; align-items: center; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }

/* ==================== 搜索框样式 ==================== */
.search-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid rgba(6, 173, 86, 0.1);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-bar::before {
  content: '🔍';
  font-size: calc(28rpx * var(--font-scale, 1));
  opacity: 0.6;
}

.search-bar input {
  flex: 1;
  font-size: calc(28rpx * var(--font-scale, 1));
  outline: none;
  border: none;
  background: transparent;
}

/* ==================== 标签样式 ==================== */
.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: calc(22rpx * var(--font-scale, 1));
  font-weight: 500;
  background: var(--theme-primary);
  color: #ffffff;
}

.badge-secondary {
  background: var(--theme-secondary);
  color: #ffffff;
}

.badge-orange {
  background: var(--theme-orange);
  color: #ffffff;
}

.badge-green {
  background: var(--theme-green);
  color: #ffffff;
}

.badge-red {
  background: var(--theme-red);
  color: #ffffff;
}

.badge-blue {
  background: var(--theme-blue);
  color: #ffffff;
}

/* ==================== 导航栏 ==================== */
.nav-bar {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #ffffff;
  padding: 44rpx 20rpx 20rpx;
  font-size: calc(34rpx * var(--font-scale, 1));
  font-weight: 600;
  text-align: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

/* ==================== TabBar ==================== */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--theme-tab-bar);
  color: var(--theme-text-2);
  display: flex;
  justify-content: space-around;
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: calc(20rpx * var(--font-scale, 1));
  transition: all 0.2s ease;
}

.tab-bar-item.active {
  color: var(--theme-primary);
}

.tab-bar-icon {
  font-size: calc(44rpx * var(--font-scale, 1));
}

/* ==================== 弹窗样式 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
  backdrop-filter: blur(4rpx);
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.2);
  animation: modalUp 0.3s ease;
}

@keyframes modalUp {
  from {
    transform: translate(-50%, -40%);
    opacity: 0;
  }
  to {
    transform: translate(-50%, -50%);
    opacity: 1;
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: var(--theme-primary-bg);
}

.modal-title {
  font-size: calc(32rpx * var(--font-scale, 1));
  font-weight: 600;
  color: var(--theme-text);
}

.modal-close {
  font-size: calc(40rpx * var(--font-scale, 1));
  color: var(--theme-text-2);
  padding: 4rpx 8rpx;
  line-height: 1;
}

.modal-close:active {
  opacity: 0.6;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 28rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-footer .btn {
  flex: 1;
}

/* ==================== 表单样式 ==================== */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: calc(28rpx * var(--font-scale, 1));
  color: var(--theme-text);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-label-inline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: calc(28rpx * var(--font-scale, 1));
  color: var(--theme-text);
}

.form-label-caption {
  font-size: calc(26rpx * var(--font-scale, 1));
  color: var(--theme-text-2);
}

.required {
  color: var(--theme-red);
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  border: 1rpx solid var(--theme-border);
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: calc(28rpx * var(--font-scale, 1));
  color: var(--theme-text);
  background: #fafafa;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.form-input:focus {
  border-color: var(--theme-primary);
  background: #fff;
}

/* ==================== 空状态 ==================== */
.empty-tip {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--theme-text-3);
  font-size: calc(28rpx * var(--font-scale, 1));
  background: #fafafa;
  border-radius: 16rpx;
  border: 1rpx dashed var(--theme-border);
}

/* ==================== 加载状态 ==================== */
.loading-tip {
  text-align: center;
  padding: 20rpx;
  color: var(--theme-text-2);
  font-size: calc(26rpx * var(--font-scale, 1));
}

/* ==================== 滚动视图 ==================== */
scroll-view {
  -webkit-overflow-scrolling: touch;
}

/* ==================== 字体大小 ==================== */
.font-xs { font-size: calc(24rpx * var(--font-scale, 1)); }
.font-sm { font-size: calc(26rpx * var(--font-scale, 1)); }
.font-md { font-size: calc(28rpx * var(--font-scale, 1)); }
.font-lg { font-size: calc(32rpx * var(--font-scale, 1)); }
.font-xl { font-size: calc(36rpx * var(--font-scale, 1)); }
.font-bold { font-weight: 600; }

/* ==================== 间距 ==================== */
.mt-0 { margin-top: 0; }
.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mb-0 { margin-bottom: 0; }
.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mx-auto { margin-left: auto; margin-right: auto; }

/* ==================== 动画 ==================== */
.fade-in {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.slide-up {
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(20rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* ==================== 安全区域 ==================== */
.safe-area-bottom {
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}
