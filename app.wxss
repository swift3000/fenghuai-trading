page {
  /* CSS 变量主题系统 */
  --theme-primary: #06AD56;
  --theme-primary-light: #06c167;
  --theme-secondary: #FF6B35;
  --theme-bg: #F5F6F8;
  --theme-card: #FFFFFF;
  --theme-text: #191919;
  --theme-text-secondary: #888888;
  --theme-border: #EFEFEF;
  --theme-tab-bar: #FFFFFF;
  --theme-tab-bar-active: #06AD56;
  
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--theme-text);
  background-color: var(--theme-bg);
}

.container {
  padding: 20rpx;
}

.card {
  background: var(--theme-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.btn-primary {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.btn-secondary {
  background: var(--theme-border);
  color: var(--theme-text);
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
}

.btn-danger {
  background: #ff4d4f;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 30rpx;
}

.text-primary {
  color: var(--theme-primary);
}

.text-secondary {
  color: var(--theme-secondary);
}

.text-muted {
  color: var(--theme-text-secondary);
}

.bg-primary {
  background-color: var(--theme-primary);
}

.bg-card {
  background-color: var(--theme-card);
}

.border {
  border-color: var(--theme-border);
}

/* 导航栏样式 */
.nav-bar {
  background-color: var(--theme-primary);
  color: #ffffff;
}

/* TabBar 样式 */
.tab-bar {
  background-color: var(--theme-tab-bar);
  color: var(--theme-text-secondary);
}

.tab-bar .active {
  color: var(--theme-tab-bar-active);
}

/* 输入框样式 */
.input, .textarea {
  background-color: var(--theme-card);
  color: var(--theme-text);
  border-color: var(--theme-border);
}

.input:focus {
  border-color: var(--theme-primary);
}

/* 标签样式 */
.badge {
  background-color: var(--theme-primary);
  color: #ffffff;
}

.badge-secondary {
  background-color: var(--theme-secondary);
  color: #ffffff;
}

/* 分割线 */
.divider {
  background-color: var(--theme-border);
}

/* 阴影卡片 */
.shadow-card {
  background-color: var(--theme-card);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
